	"quest.13ADBDE19DEA68F4.quest_desc": ["Upgrade your Backpack to a Copper Backpack with 8 copper ingots.", "", "&7&oRing the old bag with copper and everything inside stays put."]
	"quest.13ADBDE19DEA68F4.title": "Copper Backpack"
	"quest.13C4BA57CA00E653.quest_desc": ["Visit a soul sand valley and the basalt deltas.", "", "&7&oSkeletons in the valley, magma cubes in the deltas."]
	"quest.13C4BA57CA00E653.title": "Souls and Basalt"
	"quest.13DD851FA239CD23.quest_desc": ["Find a ruined Starlight portal and gather 5 Blue Starlight Crystal Shards.", "", "&7&oBroken stone that still remembers the way."]
	"quest.13DD851FA239CD23.title": "Portal Ruins"
	"quest.13F1140BDC4034A3.quest_desc": ["Craft a Space Helmet, Space Suit, Space Pants and Space Boots.", "", "&7&oOxygen gear and gas tanks keep you alive where there is no air."]
	"quest.13F1140BDC4034A3.title": "Breathe Easy"
	"quest.14033CDD1D1DC2BB.quest_desc": ["Find an End village and the Shrubland.", "", "&7&oSomeone built a home out here."]
	"quest.14033CDD1D1DC2BB.title": "Life in the Void"
	"quest.1406C0A6A76FE47F.quest_desc": ["Craft an Electric Motor.", "", "&7&oFeed it energy and it turns a shaft at a speed you choose."]
	"quest.1406C0A6A76FE47F.title": "Power to Rotation"
	"quest.1409982EE6803F41.quest_desc": ["Find a Thicket in a jungle and defeat it.", "", "&7&oLeaves and vines, wherever the jungle is thickest."]
	"quest.1409982EE6803F41.title": "Overgrown"
	"quest.141B45AA152EB420.quest_desc": ["Reach Mars, find a Mars Temple and smelt 8 Ostrum Ingots.", "", "&7&oTemples stand in the red dust, and ostrum lies in the rock beneath."]
	"quest.141B45AA152EB420.title": "The Red Planet"
	"quest.1421A687BEA2D188.quest_desc": ["Finish every other quest in this chapter.", "", "&7&oWhole buildings in a few clicks."]
	"quest.1421A687BEA2D188.quest_subtitle": "Chapter reward: Golden Bloom Die"
	"quest.1421A687BEA2D188.title": "Effortless Building Mastered"
	"quest.1438ACF08E58C0DE.quest_desc": ["Spells, rituals and flowers that work for you."]
	"quest.1438ACF08E58C0DE.title": "Magic"
	"quest.14417E00036FFB90.quest_desc": ["Hold a scepter, a bronze dungeon key, ice crystal, zanite, a blaze rod and a tomato.", "", "&7&oFrontier bosses, three other worlds and a summer harvest."]
	"quest.14417E00036FFB90.quest_subtitle": "Hard: Moonpetal Die. Never takes items"
	"quest.14417E00036FFB90.title": "Ready to Conquer"
	"quest.146F377A994A092A.quest_desc": ["Craft a Crafting Terminal.", "", "&7&oIt crafts from network stock, so no more digging through chests."]
	"quest.146F377A994A092A.title": "Craft at the Terminal"
	"quest.14757151614F6AB9.quest_desc": ["Find the Obsidilith arena in the End, slay it and take its Obsidian Heart.", "", "&7&oA living altar of obsidian. Expect spikes, pillars and a very long fight."]
	"quest.14757151614F6AB9.quest_subtitle": "Hard quest: Elderheart Die"
	"quest.14757151614F6AB9.title": "Obsidilith"
	"quest.14827A724DD55999.quest_desc": ["Find the secret bell.", "", "&7&oSomewhere in a dungeon, something rings."]
	"quest.14827A724DD55999.title": "The Secret Bell"
	"quest.148CA0FF1A53AB62.quest_desc": ["Finish every other quest in this chapter.", "", "&7&oFrom reef to trench, the whole sea charted."]
	"quest.148CA0FF1A53AB62.quest_subtitle": "Chapter reward: Golden Bloom Die"
	"quest.148CA0FF1A53AB62.title": "Hybrid Aquatic Mastered"
	"quest.14A14A6ADE238963.quest_desc": ["Finish every other quest in this chapter.", "", "&7&oEvery odd fish accounted for, and a few eaten."]
	"quest.14A14A6ADE238963.quest_subtitle": "Chapter reward: Golden Bloom Die"
	"quest.14A14A6ADE238963.title": "Unusual Fish Mastered"
	"quest.14A2D212D3DC6C46.quest_desc": ["Craft a Robit, 2 Logistical Sorters and a Digital Miner.", "", "&7&oSet a radius and filters; it mines a whole area while you sleep."]
	"quest.14A2D212D3DC6C46.quest_subtitle": "Hard quest: Starbloom Die"
	"quest.14A2D212D3DC6C46.title": "Digital Miner"
	"quest.14AE0E63702D6EF4.quest_desc": ["Find a shipwreck and catch a Wrecker.", "", "&7&oWreckers lurk in the ruins of lost ships."]
	"quest.14AE0E63702D6EF4.title": "Among the Timbers"
	"quest.14B1FABBB5848714.quest_desc": ["Craft 8 Framed Cubes.", "", "&7&oRight-click a frame with any full block to wear its texture."]
	"quest.14B1FABBB5848714.title": "Any Shape, Any Texture"
	"quest.14C329983C184780.quest_desc": ["Craft a Vat, then ferment Vinegar and 4 Pickles.", "", "&7&oThe vat ages liquids and ferments cheese, pickles and spirits."]
	"quest.14C329983C184780.title": "The Vat"
	"quest.14D1A3BC46845CF6.quest_desc": ["Craft a Platinum Sheet.", "", "&7&oFour chunks pressed flat make a sheet for platinum gear."]
	"quest.14D1A3BC46845CF6.title": "Platinum Sheet"
	"quest.14FADC9EBC87AC3E.quest_desc": ["Find a tea blossom and lavender, and pick 2 Hibiscus.", "", "&7&oWild flowers go into the kettle as well as the leaves."]
	"quest.14FADC9EBC87AC3E.title": "Into the Tea Fields"
	"quest.14FB93290199E9D5.quest_desc": ["Craft Hamster Food Mix: sunflower seeds, pumpkin seeds, wheat seeds and a carrot.", "", "&7&oA proper meal keeps a hamster happy."]
	"quest.14FB93290199E9D5.title": "Proper Meals"
	"quest.151115FEAC5ECCC6.quest_desc": ["Find a Monastery and slay Tongbi, the Sculptor.", "", "&7&oA master geomancer who shapes the earth to fight you."]
	"quest.151115FEAC5ECCC6.title": "The Sculptor"
	"quest.15202522A4B3FFAC.quest_desc": ["Collect 4 Resonarium.", "", "&7&oNo pickaxe finds it. It comes from the things that live down here."]
	"quest.15202522A4B3FFAC.title": "Resonarium"
	"quest.1528B69FF16A6B1A.quest_desc": ["Finish every other quest in this chapter.", "", "&7&oFields tended, hens fed and a table that is always full."]
	"quest.1528B69FF16A6B1A.quest_subtitle": "Chapter reward: Golden Bloom Die"
	"quest.1528B69FF16A6B1A.title": "Farm \\& Charm Mastered"
	"quest.1540079F01CCB93B.quest_desc": ["Craft a Backpack from a chest, leather and string.", "", "&7&oIt goes on your back, and keeps its items when placed down."]
	"quest.1540079F01CCB93B.title": "Pack Your Bag"
	"quest.156A5C43BDD1867D.quest_desc": ["Craft a Camera and a roll of film.", "", "&7&oBlack and white film is cheap; colour film needs gold and lapis."]
	"quest.156A5C43BDD1867D.title": "A Camera"
	"quest.15B83BA7004B54EB.quest_desc": ["Climb the dark tower and kill the Ur-Ghast.", "", "&7&oDeep in the dark forest, a tower weeps fire."]
	"quest.15B83BA7004B54EB.quest_subtitle": "Late game: well past Settle gear"
	"quest.15B83BA7004B54EB.title": "The Dark Tower"
	"quest.15C5E5E87AC86068.quest_desc": ["Craft an Accumulator.", "", "&7&oIt soaks up surplus power and gives it back when demand spikes."]
	"quest.15C5E5E87AC86068.title": "Store the Charge"
	"quest.1644D79BF17EA8F8.quest_desc": ["Visit an Indigo Mushroom Bog and a Blood Mushroom Bog.", "", "&7&oGiant fungi, and plenty of spores."]
	"quest.1644D79BF17EA8F8.title": "Mushroom Bogs"
	"quest.167CA55A896863DD.quest_desc": ["Craft a Fermentation Barrel and 4 Wine Bottles.", "", "&7&oGrapes stomped in the Grapevine Pot give juice. The barrel turns it into wine."]
	"quest.167CA55A896863DD.title": "The Fermentation Barrel"
	"quest.167DB44622EE8C48.quest_desc": ["Craft Engineer's Goggles.", "", "&7&oWear them and look at a machine to read its speed and stress."]
	"quest.167DB44622EE8C48.title": "See the Stress"
	"quest.168263905F143C7B.quest_desc": ["Finish every other quest in this chapter.", "", "&7&oYou know every stone within two kilometres of camp."]
	"quest.168263905F143C7B.quest_subtitle": "Chapter reward: Bloom Die"
	"quest.168263905F143C7B.title": "Home Ring Mastered"
	"quest.16908B40F3AFDACC.quest_desc": ["Craft a Blindfold, find a Gorgon Temple and slay its Gorgon.", "", "&7&oOne look turns you to stone. Wear the blindfold and fight by ear."]
	"quest.16908B40F3AFDACC.title": "Eyes Averted"
	"quest.16B075D94CA20EFA.quest_desc": ["Fill 4 Bottles o' Enchanting with a Spout.", "", "&7&oTen millibuckets of liquid experience to a bottle."]
	"quest.16B075D94CA20EFA.title": "Bottled Levels"
	"quest.16B4B5512A0985B9.quest_desc": ["Finish every other quest in this chapter.", "", "&7&oA full net and a wall of trophies."]
	"quest.16B4B5512A0985B9.quest_subtitle": "Chapter reward: Bloom Die"
	"quest.16B4B5512A0985B9.title": "Fish of Thieves Mastered"
	"quest.16B6E7C34DD35DB6.quest_desc": ["Find a Frozen Key in the Ice Maze.", "", "&7&oThe maze keeps its prizes behind ice and a lock."]
	"quest.16B6E7C34DD35DB6.title": "Frozen Key"
	"quest.16BF72C06DFF2AB6.quest_desc": ["Reach the Crystal Canyon and gather 8 Honey Crystal Shards.", "", "&7&oHoney that has set into glittering stone."]
	"quest.16BF72C06DFF2AB6.title": "Crystal Canyon"
	"quest.1704F8A155BD758D.quest_desc": ["Craft a Bellows and an Hourglass.", "", "&7&oBellows stoke a furnace; the hourglass keeps the time."]
	"quest.1704F8A155BD758D.title": "Puff and Pass"
	"quest.1708C827A3E2566D.quest_desc": ["Craft 3 Small Connectors and 2 Large Connectors.", "", "&7&oConnectors tie generators, batteries and motors into one grid."]
	"quest.1708C827A3E2566D.title": "Wire It Up"
	"quest.17146E93100B37E3.quest_desc": ["Craft an Electric Pump.", "", "&7&oA pump that needs a cable, not a shaft."]
	"quest.17146E93100B37E3.title": "Pumping Power"
	"quest.172AA8566EFB7D5E.quest_desc": ["Craft a Dragonsteel Sword and Pickaxe.", "", "&7&oBoth need a Witherbone, so a Nether trip comes first."]
	"quest.172AA8566EFB7D5E.title": "Dragonsteel Arms"
	"quest.17674BDDA0AA6222.quest_desc": ["Pick a mystical flower and gather 8 petals of any colour.", "", "&7&oPetals are the thread that every Botania recipe is woven from."]
	"quest.17674BDDA0AA6222.title": "Mystical Petals"
	"quest.177B32968C8C8083.quest_desc": ["Finish every other quest in this chapter.", "", "&7&oThree dungeons cleared, and the sky belongs to you."]
	"quest.177B32968C8C8083.quest_subtitle": "Chapter reward: Golden Bloom Die"
	"quest.177B32968C8C8083.title": "The Aether Mastered"
	"quest.17C49A7414E5CF63.quest_desc": ["Cook 2 Unusual Fillets from your catch.", "", "&7&oAny unusual fish cooks down to the same fillet."]
	"quest.17C49A7414E5CF63.title": "Catch of the Day"
	"quest.17C507DE615D4619.quest_desc": ["Visit a forest, a plains and a river.", "", "&7&oLearn the country around camp before you trust it."]
	"quest.17C507DE615D4619.title": "Lay of the Land"
	"quest.17D0AB556B86BC4C.quest_desc": ["Craft 4 Sconces and 2 Candle Holders.", "", "&7&oSmall flames for walls and tables."]
	"quest.17D0AB556B86BC4C.title": "Warm Light"
	"quest.17F5A41D8A4C21E5.quest_desc": ["Craft 2 Organic Compost from dirt, straw, bone meal and bark or rotten flesh.", "", "&7&oHeaps of compost mature slowly into rich soil."]
	"quest.17F5A41D8A4C21E5.title": "Organic Compost"
	"quest.17F8EF564B2B7F1C.quest_desc": ["Finish every other quest in this chapter.", "", "&7&oRoof, window, door and lamp; the house is finished."]
	"quest.17F8EF564B2B7F1C.quest_subtitle": "Chapter reward: Bloom Die"
	"quest.17F8EF564B2B7F1C.title": "Macaw's Mastered"
	"quest.182013A65E21D353.quest_desc": ["Craft a Flimsy Journal and an Ironbound Tome.", "", "&7&oBetter covers hold more spell slots. Start with what you can afford."]
	"quest.182013A65E21D353.title": "Books to Carry"
	"quest.1844D0C68C974CAA.quest_desc": ["Slay 2 Mutant Skeletons, then craft Mutant Skeleton Boots and Leggings.", "", "&7&oIt falls apart when it dies: limbs, ribs, pelvis and skull."]
	"quest.1844D0C68C974CAA.title": "No Bones About It"
	"quest.18B8873A15B33F11.quest_desc": ["Gather 4 Ant Pupae and craft an Ant Farm.", "", "&7&oGlass walls let you watch the colony at work."]
	"quest.18B8873A15B33F11.title": "Ant Farm"
	"quest.19044B0246B9A15A.quest_desc": ["Craft an Earthdive Spear.", "", "&7&oA spear tipped with an obsidian heart and a thorn from the void."]
	"quest.19044B0246B9A15A.title": "Earthdive Spear"
	"quest.1920B111D5DA8232.quest_desc": ["Collect every dungeon trophy.", "", "&7&oEvery dungeon type, cleared and bagged."]
	"quest.1920B111D5DA8232.quest_subtitle": "Hard quest: Elderheart Die"
	"quest.1920B111D5DA8232.title": "Trophy Hunter"
	"quest.192838F9F41162D0.quest_desc": ["Craft a Table of Elevation.", "", "&7&oAnima, gold and a burning eye: the first thing built from a boss."]
	"quest.192838F9F41162D0.title": "Table of Elevation"
	"quest.197E4F25DA6DF015.quest_desc": ["Craft an Engineer's Workbench and an Engineer's Blueprint.", "", "&7&oBlueprints unlock electronic components and press moulds."]
	"quest.197E4F25DA6DF015.title": "Engineer's Workbench"
	"quest.19CED813E25B6581.quest_desc": ["Finish every other quest in this chapter.", "", "&7&oA kitchen that never goes cold, even in hell."]
	"quest.19CED813E25B6581.quest_subtitle": "Chapter reward: Golden Bloom Die"
	"quest.19CED813E25B6581.title": "My Nether's Delight Mastered"
	"quest.19F8D1048ED3C496.quest_desc": ["Bake a Lasagne from bolognese, pasta and mozzarella.", "", "&7&oBolognese first, then layers. Mozzarella comes from the crafting bowl."]
	"quest.19F8D1048ED3C496.title": "Lasagne Night"
	"quest.1A061CBF2D9A9303.quest_desc": ["Craft a Cannon and a Slingshot.", "", "&7&oOne needs a dispenser and iron, the other a rabbit hide and slime."]
	"quest.1A061CBF2D9A9303.title": "Fire in the Hole"
	"quest.1A1807E2FA3F2B25.quest_desc": ["Craft a Tea Kettle and a Stove.", "", "&7&oFill the kettle with water and put it on the stove."]
	"quest.1A1807E2FA3F2B25.title": "Tea Time"
	"quest.1A1B97622A67B0D5.quest_desc": ["Visit a Scarlet Forest and a Torreya Forest.", "", "&7&oTwo forests, two very different glows."]
	"quest.1A1B97622A67B0D5.title": "Scarlet and Torreya"
	"quest.1A1CDC423DE01973.quest_desc": ["Finish every other quest in this chapter.", "", "&7&oDragons answer to those who earned their scales."]
	"quest.1A1CDC423DE01973.quest_subtitle": "Chapter reward: Moonpetal Die"
	"quest.1A1CDC423DE01973.title": "Ice and Fire Mastered"
	"quest.1A28905893CE6DCD.quest_desc": ["Visit the End Wilds and the Amethyst Forest.", "", "&7&oStellarity fills the outer End with new biomes."]
	"quest.1A28905893CE6DCD.title": "Strange New Shores"
	"quest.1A4C3E8B9505A886.quest_desc": ["Forge 4 Dragonsteel Ingots in your Dragonforge.", "", "&7&oIron and dragon blood, fired by a living dragon's breath."]
	"quest.1A4C3E8B9505A886.title": "Dragonsteel"
	"quest.1A5BC3943ED0B4A6.quest_desc": ["Craft 3 Return Scrolls.", "", "&7&oOne read and you are home."]
	"quest.1A5BC3943ED0B4A6.title": "Return Scroll"
	"quest.1A72FAB5D6C37F0E.quest_desc": ["Craft a Water Wheel.", "", "&7&oSet it in flowing water and it turns for as long as the river runs."]
	"quest.1A72FAB5D6C37F0E.title": "Let the River Work"
	"quest.1A818357A9D41163.quest_desc": ["Craft a Desh Engine and a Tier 2 Rocket.", "", "&7&oDesh plates and an engine of their own lift a bigger rocket."]
	"quest.1A818357A9D41163.title": "Desh Engines"
	"quest.1A8C3994D47F5CC7.quest_desc": ["Farms, kitchens and the meals that keep you going."]
	"quest.1A8C3994D47F5CC7.title": "Cook"
	"quest.1A8CC90491F050C1.quest_desc": ["Craft a Chisel.", "", "&7&oPlain blocks hide hundreds of patterns behind one tool."]
	"quest.1A8CC90491F050C1.title": "The Chisel"
	"quest.1ABD35B692DD3556.quest_desc": ["Gather 4 Acorns, cut them on a stonecutter and craft acorn armour for your hamster.", "", "&7&oA tame hamster rummaging about turns up acorns now and then; oak leaves rarely do."]
	"quest.1ABD35B692DD3556.title": "Nuts About Acorns"
	"quest.1ADF29146CC20794.quest_desc": ["Find a Firecaller Hut and slay the Firecaller.", "", "&7&oFire charges and flying magma. Bring water and fire resistance."]
	"quest.1ADF29146CC20794.title": "The Firecaller"
	"quest.1AE1EBA4E1654764.quest_desc": ["Craft a Fuel Refinery and an Oxygen Loader.", "", "&7&oRockets burn refined fuel; the loader fills tanks with oxygen."]
	"quest.1AE1EBA4E1654764.title": "Fuel and Oxygen"
	"quest.1AF297CD446A867A.quest_desc": ["Craft a Mechanical Saw and a Mechanical Drill.", "", "&7&oMount them on a bearing and the trees cut themselves."]
	"quest.1AF297CD446A867A.title": "Timber!"
	"quest.1AF332F3C47FF518.quest_desc": ["Cook 2 Tomato Soup from tomatoes and a splash of red wine in the cooking pot.", "", "&7&oVinery red wine is best, though a plain potion will do."]
	"quest.1AF332F3C47FF518.title": "Starter"
	"quest.1B447F62E71EA2AA.quest_desc": ["Visit a firefly forest and an enchanted forest.", "", "&7&oThe trees glow here, and some of them are not trees."]
	"quest.1B447F62E71EA2AA.title": "Woods and Fireflies"
	"quest.1B521008F5101CB5.quest_desc": ["Slay a Mutant Zombie.", "", "&7&oIt hits like a hammer and does not flinch. Keep moving."]
	"quest.1B521008F5101CB5.title": "Something Bigger"
	"quest.1B571E2946B36A91.quest_desc": ["Craft 4 Sacrificial Bowls.", "", "&7&oRituals take their offerings from bowls set in a ring around the circle."]
	"quest.1B571E2946B36A91.title": "Sacrificial Bowls"
	"quest.1B5F30D01E7140BA.quest_desc": ["Make 4 Atomic Alloys, 4 Refined Obsidian Ingots and 2 Ultimate Control Circuits.", "", "&7&oRefined obsidian infused into reinforced alloy: the top of the alloy ladder."]
	"quest.1B5F30D01E7140BA.title": "Atomic Alloy"
	"quest.1B761E70124343AB.quest_desc": ["Craft an Enchanting Apparatus and 4 Arcane Pedestals.", "", "&7&oReagent in the middle, pedestals around it, and the magic begins."]
	"quest.1B761E70124343AB.title": "Enchanting Apparatus"
	"quest.1B816E600A2815CD.quest_desc": ["Craft a Wand of the Forest.", "", "&7&oThe botanist's tool: it binds spreaders and shows where the mana flows."]
	"quest.1B816E600A2815CD.title": "Wand of the Forest"
	"quest.1B8F187AA6DFE21C.quest_desc": ["Craft a Wooden Brewing Station and 2 Beer Mugs.", "", "&7&oBeer brews in wood. Whiskey needs copper."]
	"quest.1B8F187AA6DFE21C.title": "Brewing"
	"quest.1BA1BC1CB119A4E3.quest_desc": ["Kill 3 hoglins and take 3 Hoglin Loins.", "", "&7&oHoglins drop loin in place of pork. Bastion stables keep a few in store."]
	"quest.1BA1BC1CB119A4E3.title": "Hoglin Hunt"
	"quest.1BAAFE32D443E5CB.quest_desc": ["Make 8 Fluix Crystals from charged quartz, redstone and nether quartz.", "", "&7&oThrow all three into water and they transform."]
	"quest.1BAAFE32D443E5CB.title": "Fluix"
	"quest.1BB1C6AD3DB0E45F.quest_desc": ["Slay 5 Umvuthana and collect any mask.", "", "&7&oFury, rage, fear, faith, bliss and misery: each mask has a mood."]
	"quest.1BB1C6AD3DB0E45F.title": "Masks of the Tribe"
	"quest.1BCDD9CE97C5C9FF.quest_desc": ["Cook 2 Mousse au Chocolat from cocoa, milk and butter, and place one.", "", "&7&oFour portions a batch, and nobody leaves before the last spoon."]
	"quest.1BCDD9CE97C5C9FF.title": "Dessert"
	"quest.1BD41EA651169EF4.quest_desc": ["Craft a Skillet and a Stove.", "", "&7&oA stove keeps pots and skillets hot without an open fire."]
	"quest.1BD41EA651169EF4.title": "Sizzle"
	"quest.1BE66220630AC694.quest_desc": ["Craft an Occultist Table: calcite, amethyst block and smooth basalt.", "", "&7&oA job site for the stranger sort of villager."]
	"quest.1BE66220630AC694.title": "Strange Company"
	"quest.1C1A0DB0B07789D5.quest_desc": ["Craft a Chicken Coop and 3 Chicken Feed.", "", "&7&oA coop and a sack of feed keep the egg basket full."]
	"quest.1C1A0DB0B07789D5.title": "Chicken Coop"
	"quest.1C3AFFA608A9626D.quest_desc": ["Explore the Echoing Forest and gather 16 Echo Logs.", "", "&7&oPale wood that rings when you strike it."]
	"quest.1C3AFFA608A9626D.title": "Echoes in the Trees"
	"quest.1C3C4D24B04BA98A.quest_desc": ["Craft 2 Turbine Rotors and 4 Turbine Blades.", "", "&7&oBlades catch the steam; the rotor carries them."]
	"quest.1C3C4D24B04BA98A.title": "Blades and Rotors"
	"quest.1C479A4F9C1D7C69.quest_desc": ["Harvest straw by cutting ripe wheat with a knife, then keep 8 Straw.", "", "&7&oStraw makes rope and bales, and it feeds the compost heap."]
	"quest.1C479A4F9C1D7C69.title": "Cut Some Straw"
	"quest.1C64D07B2EFB87A0.quest_desc": ["Finish every other quest in this chapter.", "", "&7&oEvery cable live, every motor humming."]
	"quest.1C64D07B2EFB87A0.quest_subtitle": "Chapter reward: Golden Bloom Die"
	"quest.1C64D07B2EFB87A0.title": "Additions Mastered"
	"quest.1C6FFF2355810AE4.quest_desc": ["Craft a copper Cooking Pot, a Cooking Pan and a Cloche.", "", "&7&oCopper pots look right in a candlelit kitchen."]
	"quest.1C6FFF2355810AE4.title": "The Chef's Kitchen"
	"quest.1C87F0AD7571B364.quest_desc": ["Find wild crops and bring home Strawberry, Tomato and Lettuce Seeds.", "", "&7&oWild plants grow across the countryside. Every one drops seeds."]
	"quest.1C87F0AD7571B364.title": "Farm Life"
	"quest.1C99C9F89EE5CEFA.quest_desc": ["Finish every other quest in this chapter.", "", "&7&oA garden that hums with mana."]
	"quest.1C99C9F89EE5CEFA.quest_subtitle": "Chapter reward: Bloom Die"
	"quest.1C99C9F89EE5CEFA.title": "Botania Mastered"
	"quest.1CC11ADCFB1CCD41.quest_desc": ["Blocks, furniture and the tools to place them."]
	"quest.1CC11ADCFB1CCD41.title": "Build"
	"quest.1CC4CDE5AC917E05.quest_desc": ["Get 2 Rich Soil by letting your Organic Compost mature.", "", "&7&oCrops love it, and so do mushrooms."]
	"quest.1CC4CDE5AC917E05.title": "Rich Soil"
	"quest.1CE3C605A19F8125.quest_desc": ["Weave an Arcane Cloth from 8 Arcane Essence and a block of wool.", "", "&7&oWizard hats and robes all begin as this cloth."]
	"quest.1CE3C605A19F8125.title": "Arcane Cloth"
	"quest.1D02972C452E776E.quest_desc": ["Craft a Scroll Forge.", "", "&7&oCrying obsidian and deepslate, for turning ink and paper into scrolls."]
	"quest.1D02972C452E776E.title": "Scroll Forge"
	"quest.1D0C35F70A79D91F.quest_desc": ["Craft an Encased Fan.", "", "&7&oBlow items through fire, lava or water to process them in bulk."]
	"quest.1D0C35F70A79D91F.title": "Air on Demand"
	"quest.1D2655A34E330901.quest_desc": ["Craft 2 Jars and a Sack.", "", "&7&oJars hold small things, sacks hold plenty, and both look good on a shelf."]
	"quest.1D2655A34E330901.title": "Jars and Sacks"
	"quest.1D4C3F233CE2361A.quest_desc": ["Hold fiery tears, ancient anima, golem steel and an elytra.", "", "&7&oThe hardest proof there is. After this the world is yours."]
	"quest.1D4C3F233CE2361A.quest_subtitle": "Capstone: Elderheart Die. Never takes items"
	"quest.1D4C3F233CE2361A.title": "Ready for Forever"
	"quest.1D551F0207E36FC3.quest_desc": ["Slay a Fire Dragon and an Ice Dragon.", "", "&7&oOne breathes flame, the other frost. Bring plenty of food and arrows."]
	"quest.1D551F0207E36FC3.quest_subtitle": "Hard quest: Starbloom Die"
	"quest.1D551F0207E36FC3.title": "Fire and Ice"
	"quest.1D848BDED96742BF.quest_desc": ["Craft a Diamond Greataxe and a Diamond Greathammer.", "", "&7&oSlow, wide and brutal. Each swing has to count."]
	"quest.1D848BDED96742BF.title": "Heavy Steel"
	"quest.1D94BAB27BC56C69.quest_desc": ["Finish every other quest in this chapter.", "", "&7&oThe raid is over, at least until the next one."]
	"quest.1D94BAB27BC56C69.quest_subtitle": "Chapter reward: Golden Bloom Die"
	"quest.1D94BAB27BC56C69.title": "Illager Invasion Mastered"
	"quest.1D9ACF79C95955CF.quest_desc": ["Upgrade to a Netherite Brewing Station and brew a Dark Brew.", "", "&7&oThree whiskies blended in a netherite still."]
	"quest.1D9ACF79C95955CF.quest_subtitle": "Needs a Netherite upgrade"
	"quest.1D9ACF79C95955CF.title": "Dark Brew"
	"quest.1D9E7B1F0C37F9A8.quest_desc": ["Defeat a Bogged in a swamp.", "", "&7&oIts arrows leave poison behind."]
	"quest.1D9E7B1F0C37F9A8.title": "Poison Arrows"
	"quest.1DC25C5927EBBF6F.quest_desc": ["Craft a Grave.", "", "&7&oIf you die, your things wait in a grave where you fell."]
	"quest.1DC25C5927EBBF6F.title": "If You Fall"
	"quest.1E0780239D9D5B0D.quest_desc": ["Cook a Vegetable Soup, Beef Stew, Chicken Soup or Mixed Salad.", "", "&7&oHot dishes grant Nourishment, which holds off hunger for a while."]
	"quest.1E0780239D9D5B0D.title": "First Hot Meal"
	"quest.1E141457636D5CE6.quest_desc": ["Finish every other quest in this chapter.", "", "&7&oEvery leaf steeped and every cup poured."]
	"quest.1E141457636D5CE6.quest_subtitle": "Chapter reward: Golden Bloom Die"
	"quest.1E141457636D5CE6.title": "HerbalBrews Mastered"
	"quest.1E17F2D4B90F6A7B.quest_desc": ["Craft 2 LV Wire Connectors and 2 LV Wire Coils, then connect a wire.", "", "&7&oClick one connector, then the next. Mind the voltage rating."]
	"quest.1E17F2D4B90F6A7B.title": "Run a Cable"
	"quest.1E3A95E6BC21D7F5.quest_desc": ["Find a pillager outpost and kill 4 pillagers.", "", "&7&oPillagers shoot first and ask nothing."]
	"quest.1E3A95E6BC21D7F5.quest_subtitle": "Dangerous: pillagers hit hard"
	"quest.1E3A95E6BC21D7F5.title": "Pillager Patrol"
	"quest.1E43BD07297FDCED.quest_desc": ["Cook a Vegetable Soup, a Beef Stew and a Chicken Soup.", "", "&7&oThree different bowls count as three different foods."]
	"quest.1E43BD07297FDCED.title": "Hot Dishes"
	"quest.1E4495C41ABE4DFC.quest_desc": ["Mix 4 Sweet Dough and bake 4 Croissants.", "", "&7&oCroissants need sweet dough, yeast and sugar, and a hot stove."]
	"quest.1E4495C41ABE4DFC.title": "Sweet Pastry"
	"quest.1E618E4A818F9C80.quest_desc": ["Chisel 2 Iron Blocks and 2 Copper Blocks into their Gears pattern.", "", "&7&oEven a block of metal can look like a machine."]
	"quest.1E618E4A818F9C80.title": "Plated Metal"
	"quest.1E6F24A9BF7E6B2B.quest_desc": ["Craft a Bow and 32 Arrows.", "", "&7&oSome fights are best won before they reach you."]
	"quest.1E6F24A9BF7E6B2B.title": "From a Distance"
	"quest.1E8A92EF2C52CB1E.quest_desc": ["Finish every other quest in this chapter.", "", "&7&oOne very well-kept and slightly overfed hamster."]
	"quest.1E8A92EF2C52CB1E.quest_subtitle": "Chapter reward: Bloom Die"
	"quest.1E8A92EF2C52CB1E.title": "Hamsters Mastered"
	"quest.1E9DF79E69276202.quest_desc": ["Catch 4 unusual fish of any kind.", "", "&7&oOdd shapes, odd colours and odd tempers."]
	"quest.1E9DF79E69276202.title": "Strange Catches"
	"quest.1EBB1620B7C2B97E.quest_desc": ["Tame a Glare in a lush cave.", "", "&7&oGlares like the dark, and they like glow berries."]
	"quest.1EBB1620B7C2B97E.title": "Glow in the Dark"
	"quest.1EE275FEF18E0492.quest_desc": ["Slay 3 Stymphalian Birds and craft a Stymphalian Bird Dagger.", "", "&7&oMetal feathers fall like arrows. Bring a shield."]
	"quest.1EE275FEF18E0492.title": "Rain of Feathers"
	"quest.1EFD0B5205A292AD.quest_desc": ["Smelt 9 Skyjade Gemstones from Skyjade Ore.", "", "&7&oA green gem, the deeper sky's answer to zanite."]
	"quest.1EFD0B5205A292AD.title": "Skyjade"
	"quest.1EFE80B6AD5FAB2D.quest_desc": ["Make Hot Cocoa, Apple Cider and Melon Juice.", "", "&7&oBottled drinks are food too, and they fill the book."]
	"quest.1EFE80B6AD5FAB2D.title": "Something to Drink"
	"quest.1F05B91AA6CD5F2C.quest_desc": ["Enter the Gauntlet arena, slay the Nether Gauntlet and take its Blazing Eye.", "", "&7&oA blackstone fist with a burning eye. Bring fire resistance."]
	"quest.1F05B91AA6CD5F2C.quest_subtitle": "Needs the Nether"
	"quest.1F05B91AA6CD5F2C.title": "The Gauntlet"
	"quest.1F1633DFBA6FF487.quest_desc": ["Gather 8 Dragon Bones and 8 dragon scales of any colour.", "", "&7&oA fallen dragon leaves enough to equip a small army."]
	"quest.1F1633DFBA6FF487.title": "Bone and Scale"
	"quest.1F3FB7F78A70BEE5.quest_desc": ["Gather 8 Certus Quartz Crystals and craft a Charger.", "", "&7&oEverything in AE2 grows from these crystals."]
	"quest.1F3FB7F78A70BEE5.title": "Certus Quartz"
	"quest.1F532ADDB0EA233D.quest_desc": ["Turn a Snow Golem into a Mutant Snow Golem.", "", "&7&oThe one mutant that fights for you. It hurls ice at anything hostile."]
	"quest.1F532ADDB0EA233D.title": "Snow Job"
	"quest.1F555780AF99DD8E.quest_desc": ["Craft a Source Jar.", "", "&7&oMachines in Ars drink Source. Jars hold it."]
	"quest.1F555780AF99DD8E.title": "Source Jar"
	"quest.1F71381A754A3969.quest_desc": ["Finish every other quest in this chapter.", "", "&7&oEvery breed met, and you still have both eyebrows."]
	"quest.1F71381A754A3969.quest_subtitle": "Chapter reward: Bloom Die"
	"quest.1F71381A754A3969.title": "Creepers Mastered"
	"quest.1F7AE61A127973AF.quest_desc": ["Craft 2 Glowsticks from Glowslime and sticks.", "", "&7&oGlowslime comes from deep-sea glowers like barreleyes and crown jellyfish."]
	"quest.1F7AE61A127973AF.title": "Light in the Dark"
	"quest.1FE662F29A162A91.quest_desc": ["Make 8 Reinforced Alloys, 4 Elite Control Circuits and an Elite Tier Installer.", "", "&7&oDiamond-infused alloy lifts your circuits another tier."]
	"quest.1FE662F29A162A91.title": "Elite Tier"
	"quest.2013B85ABE77AD3F.quest_desc": ["Craft an Oak Horticulturist Table and find a village.", "", "&7&oA new job site gives a jobless villager a new profession."]
	"quest.2013B85ABE77AD3F.title": "New Trades"
	"quest.201F628A9BAAB262.quest_desc": ["Craft the Hamster Tips guidebook from a book and a Sliced Cucumber.", "", "&7&oEverything about hamster care in one slim volume."]
	"quest.201F628A9BAAB262.title": "Hamster Care"
	"quest.203B135F262C7D60.quest_desc": ["Craft 6 Inventory Cables.", "", "&7&oRun them between chests and the terminal sees the lot."]
	"quest.203B135F262C7D60.title": "Connect the Chests"
	"quest.206D2C36F860DC68.quest_desc": ["Slay the Warden and take its Heart of the Deep.", "", "&7&oThe heart wakes the city's portal. The Warden cannot see you; it does not need to."]
	"quest.206D2C36F860DC68.quest_subtitle": "Hard quest: Starbloom Die"
	"quest.206D2C36F860DC68.title": "The Warden's Heart"
	"quest.20B3D3EE1A68C956.quest_desc": ["Craft an Oak Raft and sail to a coral reef.", "", "&7&oThe reefs here are far richer than vanilla ocean."]
	"quest.20B3D3EE1A68C956.title": "Under the Waves"
	"quest.20DCEFDF6902A8A4.quest_desc": ["Pick a Red, a Green and a Yellow Bell Pepper.", "", "&7&oBell peppers come in many colours, and each has its own dishes."]
	"quest.20DCEFDF6902A8A4.title": "Country Cooking"
	"quest.21016DF6F9B302C5.quest_desc": ["Craft an Unusual Sandwich from a fillet, 2 kelp and 2 bread.", "", "&7&oBest eaten without thinking about it."]
	"quest.21016DF6F9B302C5.title": "The Unusual Sandwich"
	"quest.211D7AC0A9DEB912.quest_desc": ["Make 9 Fertilizer and pack it into Fertilized Soil.", "", "&7&oBone meal and rotten flesh dry into fertilizer."]
	"quest.211D7AC0A9DEB912.title": "Feed the Soil"
	"quest.21251B119BBB2685.quest_desc": ["Craft 4 Candles of any colour and 2 Soul Lanterns.", "", "&7&oCandles for the table, soul lamps for the dark corners."]
	"quest.21251B119BBB2685.title": "Cosy Light"
	"quest.212CB2240E16A269.quest_desc": ["Kill 3 Crimson Mosquitoes and collect a Mosquito Proboscis.", "", "&7&oThey swarm in crimson forests; only about one in ten leaves its proboscis."]
	"quest.212CB2240E16A269.title": "A Taste for Blood"
	"quest.21486E095AE50967.quest_desc": ["Slay 5 Skeletons and 3 Creepers.", "", "&7&oShoot the skeletons and never let the creepers get close."]
	"quest.21486E095AE50967.title": "Bones and Bangs"
	"quest.215FADFE5A7202D9.quest_desc": ["Defeat a Wilden Hunter, a Wilden Stalker and a Wilden Defender.", "", "&7&oThey haunt the archwood and their dens. Their drops feed the summoning rituals."]
	"quest.215FADFE5A7202D9.quest_subtitle": "Hard quest: Golden Bloom Die"
	"quest.215FADFE5A7202D9.title": "The Wilden Hunt"
	"quest.2173CE79600AEDF4.quest_desc": ["Craft a Meteorite Compass, find a meteorite and mine 8 Sky Stone.", "", "&7&oSky stone resists most picks: bring your best."]
	"quest.2173CE79600AEDF4.title": "Meteorites"
	"quest.21A05B05CCB713BD.quest_desc": ["Make 8 Andesite Alloy from andesite and iron nuggets.", "", "&7&oThe grey heart of every early Create machine."]
	"quest.21A05B05CCB713BD.title": "Andesite Alloy"
	"quest.21A6DEC2EF247A6C.quest_desc": ["Craft a Tier 1 Rocket, reach the Moon and bring back 8 Desh Ingots.", "", "&7&oDesh ore lies in the lunar rock; you will need plenty of it."]
	"quest.21A6DEC2EF247A6C.title": "The Moon"
	"quest.21C72AA1486486C2.quest_desc": ["Cook a Fried Hoglin Chop with loin, wheat, milk, egg and pepper.", "", "&7&oRich, spicy and hard to put down."]
	"quest.21C72AA1486486C2.title": "Fried Hoglin Chop"
	"quest.21D5DE4ECA7AD2E3.quest_desc": ["Smelt 2 Knightmetal Ingots from armour shards.", "", "&7&oNine shards make a cluster, and a cluster makes an ingot."]
	"quest.21D5DE4ECA7AD2E3.title": "Knightmetal"
	"quest.21DD9C73C8305E00.quest_desc": ["Plant rice in shallow water and harvest 8 Rice.", "", "&7&oRice ripens into tall panicles, and stew pots love it."]
	"quest.21DD9C73C8305E00.title": "Paddy Fields"
	"quest.21DD9F7FC56A6698.quest_desc": ["Find a Sorcerer Hut, slay its Sorcerer and take 2 Unusual Dust.", "", "&7&oA spellcaster in a lonely hut, guarding a strange dust."]
	"quest.21DD9F7FC56A6698.title": "The Sorcerer's Hut"
	"quest.21DFB5164C030D57.quest_desc": ["Finish the four seasonal advancement lines, from planting wheat to baking a cake.", "", "&7&oEach finished line pays out a Greenhouse Essence for its season."]
	"quest.21DFB5164C030D57.title": "Through the Year"
	"quest.21E2D9B23E7784B6.quest_desc": ["Gather 3 Hide and craft a Knapsack.", "", "&7&oBoar hide makes a tough pack."]
	"quest.21E2D9B23E7784B6.title": "A Sturdy Pack"
	"quest.21E90D765C15392C.quest_desc": ["Find a Gelid in a snowy biome and defeat it.", "", "&7&oA frostbitten take on a familiar face."]
	"quest.21E90D765C15392C.title": "New Variants"
	"quest.21ED6C6469F316CF.quest_desc": ["Make a Tentacle on a Stick and bake it.", "", "&7&oSmelt it, smoke it or hold it over a campfire."]
	"quest.21ED6C6469F316CF.title": "Tentacle Skewer"
	"quest.224B728060FE6467.quest_desc": ["Craft a Refined Glowstone Pickaxe and Helmet.", "", "&7&oQuick to mine with and easy to enchant."]
	"quest.224B728060FE6467.title": "Refined Glowstone"
	"quest.22A31761778462F0.quest_desc": ["Reach the Nether and craft a Nether Stove.", "", "&7&oNether bricks and blackstone make a stove that suits the heat down there."]
	"quest.22A31761778462F0.title": "Cooking With Fire"
	"quest.22A44E76265EFE02.quest_desc": ["Kill a Ghast with its own fireball and collect a Ghast Tear.", "", "&7&oHit the fireball and it flies home."]
	"quest.22A44E76265EFE02.title": "Return to Sender"
	"quest.22B55A8779119BA2.quest_desc": ["Kill an elder guardian and cook a slice of its meat.", "", "&7&oThe monument's old keeper makes a fierce dinner."]
	"quest.22B55A8779119BA2.title": "The Elder's Feast"
	"quest.23192F0B941BE922.quest_desc": ["Craft a Sophisticated Barrel.", "", "&7&oBarrels stack tidily in a wall and take the same upgrades."]
	"quest.23192F0B941BE922.title": "Barrels Too"
	"quest.232A2BB0F982DD13.quest_desc": ["Craft a QIO Drive, a QIO Drive Array and a QIO Dashboard.", "", "&7&oOne networked inventory, shared across your whole base."]
	"quest.232A2BB0F982DD13.title": "QIO Storage"
	"quest.232E3EE65ED4731E.quest_desc": ["Smelt 4 Silver Ingots and alloy 4 Electrum Ingots.", "", "&7&oGold and silver together carry mid-voltage power."]
	"quest.232E3EE65ED4731E.title": "Silver and Electrum"
	"quest.234E8D19B4FE84C7.quest_desc": ["Craft a Familiar Ring.", "", "&7&oBind a captured familiar to it and it follows you, helping in small ways."]
	"quest.234E8D19B4FE84C7.title": "A Familiar of Your Own"
	"quest.235018AA283F9893.quest_desc": ["Finish every other quest in this chapter.", "", "&7&oBones dug up, eggs hatched, giants remembered."]
	"quest.235018AA283F9893.quest_subtitle": "Chapter reward: Moonpetal Die"
	"quest.235018AA283F9893.title": "Unusual Prehistory Mastered"
	"quest.2375D9A70BB16BAB.quest_desc": ["Craft 4 Mechanical Belts from dried kelp.", "", "&7&oA belt moves items and links two shafts at once."]
	"quest.2375D9A70BB16BAB.title": "On the Belt"
	"quest.23BBF616F076552C.quest_desc": ["Collect 2 Rough Barnacle Blocks and craft a Barnacle Block.", "", "&7&oThey grow on a hullback's back; an axe scrapes them off."]
	"quest.23BBF616F076552C.title": "Shell and Salt"
	"quest.23D5D0F46C768623.quest_desc": ["Craft a Mining Drill and an Iron Drill Head.", "", "&7&oFuel in the tank, a head on the end, and rock gives way."]
	"quest.23D5D0F46C768623.title": "Mining Drill"
	"quest.23E7F38026FC4CAC.quest_desc": ["Craft an Oven and a Pie Crust, then bake a pie.", "", "&7&oPies bake in the Oven from Cultural Delights: apple, cheesecake or chocolate."]
	"quest.23E7F38026FC4CAC.title": "Out of the Oven"
	"quest.23F0446960E181D7.quest_desc": ["Build a home, cook, and try a little tech and magic.", "", "&7&oAny chapter in this row makes a good first step."]
	"quest.23F0446960E181D7.quest_subtitle": "Home ring, under 2 km"
	"quest.23F0446960E181D7.title": "Settle"
	"quest.23FDE7EAA5A896C9.quest_desc": ["Finish every other quest in this chapter.", "", "&7&oEvery glyph learned, every spell your own."]
	"quest.23FDE7EAA5A896C9.quest_subtitle": "Chapter reward: Bloom Die"
	"quest.23FDE7EAA5A896C9.title": "Ars Nouveau Mastered"
	"quest.2418BD9A33284D73.quest_desc": ["Craft a Mana Spreader.", "", "&7&oIt fires bursts of mana at pools, flowers and anything else that wants some."]
	"quest.2418BD9A33284D73.title": "Mana Spreader"
	"quest.241B210BF0915328.quest_desc": ["Craft a Sonorous Staff.", "", "&7&oSoul crystals, sculk bones and another Heart of the Deep."]
	"quest.241B210BF0915328.title": "Sound the Staff"
	"quest.242A964243D1B593.quest_desc": ["Finish every other quest in this chapter.", "", "&7&oEvery creature of the near wild, noted and understood."]
	"quest.242A964243D1B593.quest_subtitle": "Chapter reward: Bloom Die"
	"quest.242A964243D1B593.title": "Naturalist Mastered"
	"quest.24976F6EF515441E.quest_desc": ["Give a sword to an unemployed villager to make a new guard.", "", "&7&oA jobless villager handed a blade takes up the watch, and can follow you out."]
	"quest.24976F6EF515441E.title": "New Recruit"
	"quest.24AC7D644EFE1902.quest_desc": ["Brew a Nettle, Ribwort or Strawberry Tea in the pot.", "", "&7&oWild herbs or berries steeped in water make a cup."]
	"quest.24AC7D644EFE1902.title": "A Cup of Tea"
	"quest.24D1F29CABC633B3.quest_desc": ["Put a Spiral Fossil in the Transmogrifier to get 2 Ammonite Eggs.", "", "&7&oThe machine needs about a minute for each fossil. Ammonites hatch in water."]
	"quest.24D1F29CABC633B3.title": "Life from Stone"
	"quest.24E1FCA529D8DD35.quest_desc": ["Craft 2 Oak Drawers and 3 Oak Shelves.", "", "&7&oPut away the clutter, or put it on show."]
	"quest.24E1FCA529D8DD35.title": "Drawers and Shelves"
	"quest.24FFAC35802BAC69.quest_desc": ["Craft an Enrichment Chamber and a Crusher.", "", "&7&oEnrich an ore and it yields two dusts, not one."]
	"quest.24FFAC35802BAC69.title": "Ore Doubling"
	"quest.2565C349C305BB05.quest_desc": ["Craft a Pure Daisy.", "", "&7&oBeside stone or logs it slowly purifies them into living rock and wood."]
	"quest.2565C349C305BB05.title": "Pure Daisy"
	"quest.25F1851B3D7116CE.quest_desc": ["Visit a tropical island and harvest 2 Coconuts and a Mango.", "", "&7&oIsland fruit makes a welcome change from fish."]
	"quest.25F1851B3D7116CE.title": "Island Fruit"
	"quest.2607018913DDBF77.quest_desc": ["Blast raw mithril into scrap and craft a Mithril Ingot from 4 scrap.", "", "&7&oFound deep underground, and worth the digging."]
	"quest.2607018913DDBF77.title": "Mithril"
	"quest.26219B2ADBA25E94.quest_desc": ["Craft all five feasts: roast chicken, shepherd's pie, pumpkin, ham and rice rolls.", "", "&7&oA table that groans is a table well fed."]
	"quest.26219B2ADBA25E94.quest_subtitle": "Hard quest: Golden Bloom Die"
	"quest.26219B2ADBA25E94.title": "The Grand Banquet"
	"quest.2643AB7C0C6159BC.quest_desc": ["Craft a Mana Pool.", "", "&7&oIt stores mana, and items dropped in a full pool can be infused."]
	"quest.2643AB7C0C6159BC.title": "Mana Pool"
	"quest.26563070BBBF107D.quest_desc": ["Catch 4 Herring or Bluefish.", "", "&7&oOpen water gives bigger fish than any pond."]
	"quest.26563070BBBF107D.title": "Catch of the Day"
	"quest.26C6EFD606AE2D11.quest_desc": ["Visit a lush cave and bring home an axolotl in a bucket.", "", "&7&oTen extra colours, from Golden to Cyanide, now swim beside vanilla's five."]
	"quest.26C6EFD606AE2D11.title": "Every Colour"
	"quest.26E04AA3F2264E49.quest_desc": ["Hold 8 Experience Blocks and press 2 Enchanting Templates.", "", "&7&oNinety nuggets of crushed ore, pressed and hoarded."]
	"quest.26E04AA3F2264E49.quest_subtitle": "Hard quest: Moonpetal Die"
	"quest.26E04AA3F2264E49.title": "Pockets Full of Light"
	"quest.26F9D4B95E4E37F7.quest_desc": ["Finish every other quest in this chapter.", "", "&7&oDown here, you are the rot beast."]
	"quest.26F9D4B95E4E37F7.quest_subtitle": "Chapter reward: Golden Bloom Die"
	"quest.26F9D4B95E4E37F7.title": "Undergarden Mastered"
	"quest.2741462F91FCA2AE.quest_desc": ["Find a cliff fossil on a stony shore and brush out a Spiral Fossil.", "", "&7&oOld bones jut from the rock where the sea meets stone; fossil beds sit among them."]
	"quest.2741462F91FCA2AE.title": "Fossil Cliffs"
	"quest.27573D7FDC0D4472.quest_desc": ["Craft an Open Crate.", "", "&7&oA lidless crate that bridges the network and the world outside."]
	"quest.27573D7FDC0D4472.title": "Open Crate"
	"quest.2761E123FCF9704B.quest_desc": ["Craft a Bestiary from 3 Manuscripts.", "", "&7&oEvery beast in this book can be read, drawn and, sooner or later, hunted."]
	"quest.2761E123FCF9704B.title": "Dragon Tracks"
	"quest.27652596184FFAC6.quest_desc": ["Sail to a deep frozen or deep cold ocean and find the Ice Maze.", "", "&7&oA frozen labyrinth under a blizzard. Bring warmth, torches and patience."]
	"quest.27652596184FFAC6.title": "The Ice Maze"
	"quest.276B25DE00A88308.quest_desc": ["Finish every other quest in this chapter.", "", "&7&oYou listened, and the dark answered."]
	"quest.276B25DE00A88308.quest_subtitle": "Chapter reward: Moonpetal Die"
	"quest.276B25DE00A88308.title": "Otherside Mastered"
	"quest.277536421F33391A.quest_desc": ["Craft a Skyjade Helmet and Chestplate.", "", "&7&oLight and sturdy, and a base for the storm gear to come."]
	"quest.277536421F33391A.title": "Skyjade Armour"
	"quest.277CDD5E31158D3C.quest_desc": ["Craft a Dissolution Chamber, a Chemical Washer and a Chemical Crystallizer.", "", "&7&oDissolve, wash, crystallise: five crystals from every ore."]
	"quest.277CDD5E31158D3C.title": "Five-Fold Ore"
	"quest.278549A3909515DF.quest_desc": ["Craft a Roaster and make Bacon with Eggs.", "", "&7&oMany roasted dishes need butter, so keep the bowl busy."]
	"quest.278549A3909515DF.title": "Roast Dinner"
	"quest.2788EA0908E60EBD.quest_desc": ["Finish every other quest in this chapter.", "", "&7&oA full larder and a pot that never goes cold."]
	"quest.2788EA0908E60EBD.quest_subtitle": "Chapter reward: Bloom Die"
	"quest.2788EA0908E60EBD.title": "Farmer's Delight Mastered"
	"quest.27A9F46114DBFAD6.quest_desc": ["Form an Excavator with its Bucket Wheel and set a Core Sample Drill.", "", "&7&oSurvey the chunk first. Then the wheel digs out what the drill found."]
	"quest.27A9F46114DBFAD6.quest_subtitle": "Hard quest: Moonpetal Die"
	"quest.27A9F46114DBFAD6.title": "The Excavator"
	"quest.27C80BC3BF0368A9.quest_desc": ["Craft a Runic Altar and make 2 Runes of Water.", "", "&7&oToss in the ingredients and a livingrock, feed it mana, then tap it with the wand."]
	"quest.27C80BC3BF0368A9.title": "Runic Altar"
	"quest.27CAB569EA4DF3E1.quest_desc": ["Infuse 4 Manasteel Ingots by dropping iron ingots into a full pool.", "", "&7&oEach ingot drinks 3000 mana before it is ready."]
	"quest.27CAB569EA4DF3E1.title": "Manasteel"
	"quest.27EEE61EDAAD51B6.quest_desc": ["Slay The Gatekeeper.", "", "&7&oIt guards more than a doorway."]
	"quest.27EEE61EDAAD51B6.title": "The Gatekeeper"
	"quest.27FD0D26B5BFB9A6.quest_desc": ["Craft an Ostrum Engine and a Tier 3 Rocket.", "", "&7&oA tier 3 rocket reaches Mercury and Venus, where calorite waits."]
	"quest.27FD0D26B5BFB9A6.title": "Ostrum Rocket"
	"quest.28366AAB296E4B17.quest_desc": ["Creatures, fish, photos and the dice themselves."]
	"quest.28366AAB296E4B17.title": "Collect"
	"quest.285F224BEB9077BE.quest_desc": ["Ferment 2 bottles of Red Wine from red grape juice, sugar and a bottle.", "", "&7&oGive it time. Wine only improves in the barrel."]
	"quest.285F224BEB9077BE.title": "First Wine"
	"quest.2867FD4A8738CEA7.quest_desc": ["Craft 2 Experience Blocks from 18 nuggets.", "", "&7&oCompact to carry, and each block grinds back to liquid."]
	"quest.2867FD4A8738CEA7.title": "Solid Experience"
	"quest.2870EDF3E891E4D2.quest_desc": ["Finish every other quest in this chapter.", "", "&7&oEvery wall in any texture, and nobody can tell what is behind it."]
	"quest.2870EDF3E891E4D2.quest_subtitle": "Chapter reward: Golden Bloom Die"
	"quest.2870EDF3E891E4D2.title": "FramedBlocks Mastered"
	"quest.2873B36409BF6B7A.quest_desc": ["Collect 2 Bear Fur from grizzly bears and craft a Falconry Glove.", "", "&7&oA tamed eagle perches on a gloved hand and launches from it."]
	"quest.2873B36409BF6B7A.title": "Hands for Hawks"
	"quest.289BAA475C27FC15.quest_desc": ["Find a Verdant in a jungle and defeat it.", "", "&7&oJungles breed more than one overgrown mob."]
	"quest.289BAA475C27FC15.title": "Evergreen"
	"quest.28B9789D367D3B02.quest_desc": ["Climb the lich tower and kill the Lich.", "", "&7&oBreak its shields, ignore the shadow clones and keep moving."]
	"quest.28B9789D367D3B02.title": "The Lich Tower"
	"quest.2912F4C16F945A98.quest_desc": ["Smelt 4 Osmium Ingots and craft a Metallurgic Infuser.", "", "&7&oCopper and redstone go in, infused alloy comes out."]
	"quest.2912F4C16F945A98.title": "Metallurgic Infuser"
	"quest.297290EC699ADA22.quest_desc": ["Chisel 16 Stone into Stone Brick Pattern.", "", "&7&oPlain stone becomes paving, tiles and worn paths."]
	"quest.297290EC699ADA22.title": "Cut Stone"
	"quest.29733FA019BEDAD8.quest_desc": ["Craft an Apple Press, 4 Apple Mash and 2 Apple Juice.", "", "&7&oApples are mashed in the press, then bottled as juice."]
	"quest.29733FA019BEDAD8.title": "The Apple Press"
	"quest.298F8BAEA2A99FBA.quest_desc": ["Finish every other quest in this chapter.", "", "&7&oReady for whatever the night sends."]
	"quest.298F8BAEA2A99FBA.quest_subtitle": "Chapter reward: Bloom Die"
	"quest.298F8BAEA2A99FBA.title": "Combat Basics Mastered"
	"quest.29B452AEB594A574.quest_desc": ["Craft 2 Oak Cabinets and 4 Canvas.", "", "&7&oCabinets hold your stores. Canvas makes rugs and signs to match."]
	"quest.29B452AEB594A574.title": "A Proper Kitchen"
	"quest.29C37F3965E08D79.quest_desc": ["Gather 4 Hops, dry 4 Wheat, then brew a Wheat Beer.", "", "&7&oHops, dried grain and yeast go into the station."]
	"quest.29C37F3965E08D79.title": "First Beer"
	"quest.29D067FC51E45C01.quest_desc": ["Finish every other quest in this chapter.", "", "&7&oThe whale is saddled and the sea is yours."]
	"quest.29D067FC51E45C01.quest_subtitle": "Chapter reward: Golden Bloom Die"
	"quest.29D067FC51E45C01.title": "Whaleborne Mastered"
	"quest.29D59978D03B958A.quest_desc": ["Kill a ghast and cook Ghasta with Cream.", "", "&7&oMagma cream, a ghast tear and a bowl of ghasta."]
	"quest.29D59978D03B958A.title": "Ghasta with Cream"
	"quest.2A01962E32CD1D6F.quest_desc": ["Make 4 Steel Ingots.", "", "&7&oHarder than iron, and the metal behind every serious machine."]
	"quest.2A01962E32CD1D6F.title": "Steel"
	"quest.2A2280D2EDAD7C6B.quest_desc": ["Craft a Jam Pot and 3 Jars, then cook Strawberry Jam.", "", "&7&oBerries and sugar simmer into jam. Spread it on bread at the board."]
	"quest.2A2280D2EDAD7C6B.title": "Jam Jar"
	"quest.2A25BD62F82CAEE6.quest_desc": ["Craft a Rolling Mill and 2 Capacitors.", "", "&7&oRolling mills turn ingots and sheets into rods and wire."]
	"quest.2A25BD62F82CAEE6.title": "Plug Into Create"
	"quest.2A5618A3B66AED81.quest_desc": ["Find a Key Charger.", "", "&7&oFound deep in the dungeons, and worth carrying home."]
	"quest.2A5618A3B66AED81.title": "Key Charger"
	"quest.2A5E6D5E242EF815.quest_desc": ["Craft an Inscriber and collect all 4 processor presses.", "", "&7&oMeteorite loot holds the presses; copy each in an Inscriber with an iron block."]
	"quest.2A5E6D5E242EF815.title": "Inscriber and Presses"
	"quest.2A76DD1279DB1D0F.quest_desc": ["Craft a Configurator, 4 HDPE Sheets and a Meka-Tool.", "", "&7&oUltimate circuits and polonium pellets make this the long road."]
	"quest.2A76DD1279DB1D0F.quest_subtitle": "Hard quest: Starbloom Die"
	"quest.2A76DD1279DB1D0F.title": "Meka-Tool"
	"quest.2A8697C512BF41CB.quest_desc": ["Gather 9 Red Grapes.", "", "&7&oRipe bunches come off the vine; keep a few back as seed."]
	"quest.2A8697C512BF41CB.title": "Grape Harvest"
	"quest.2AAE2642248A0985.quest_desc": ["Craft a Scribe's Table.", "", "&7&oNew glyphs are crafted and learned here, from essences and ordinary items."]
	"quest.2AAE2642248A0985.title": "Scribe's Table"
	"quest.2B147E642FD72969.quest_desc": ["Craft a Pitchfork, a Plow and a Seeder, and turn fertilized soil with the pitchfork.", "", "&7&oThe plow breaks ground and the seeder sows it, row after row."]
	"quest.2B147E642FD72969.title": "Farm Tools"
	"quest.2B361F9993224331.quest_desc": ["Craft Fish Food, Calm Food and Diet Food.", "", "&7&oBone meal mixed with something from the sea."]
	"quest.2B361F9993224331.title": "Special Feed"
	"quest.2B5E75A09BF6AC92.quest_desc": ["Find the bronze dungeon and kill the Slider.", "", "&7&oOnly a pickaxe hurts it, and it hits hard when it slides."]
	"quest.2B5E75A09BF6AC92.title": "The Bronze Dungeon"
	"quest.2B717612B71E983C.quest_desc": ["Defeat 3 Husks in a desert.", "", "&7&oSand-baked and hungry, and they leave you hungry too."]
	"quest.2B717612B71E983C.title": "Sand Walkers"
	"quest.2B8949183BE78A95.quest_desc": ["Kill 4 Quail and cook 4 Quail.", "", "&7&oThe first proper meal this high up."]
	"quest.2B8949183BE78A95.title": "Quail Dinner"
	"quest.2B982D8BA8C66CDD.quest_desc": ["Craft 4 Reinforced, 4 Slick and 6 Road plastic blocks, all white.", "", "&7&oReinforced shrugs off explosions; roads speed up anyone who walks on them."]
	"quest.2B982D8BA8C66CDD.title": "Plastic Variants"
	"quest.2BC3D69B0193FCF1.quest_desc": ["Craft 2 Teleportation Cores and a Teleporter, then teleport through one.", "", "&7&oBuild two on the same frequency, each in its frame, and step across."]
	"quest.2BC3D69B0193FCF1.title": "Teleportation"
	"quest.2BC554463FC43A15.quest_desc": ["Craft 16 Andesite Bars and 8 Andesite Catwalks.", "", "&7&oWalkways are the quickest way to make a factory look like one."]
	"quest.2BC554463FC43A15.title": "Industrial Looks"
	"quest.2BCDAF7923769D29.quest_desc": ["Slay Frostmaw and take its Ice Crystal.", "", "&7&oA great beast of the frozen wastes. Dress warm and hit hard."]
	"quest.2BCDAF7923769D29.title": "Frostmaw"
	"quest.2C0744B068AA53E9.quest_desc": ["Kill 2 Porcupine Lobsters, collect 2 Lobster Spikes and craft a Prismarine Spear.", "", "&7&oOnly about half of them give up a spike, so expect to hunt a few."]
	"quest.2C0744B068AA53E9.title": "Spiny Spear"
	"quest.2C07676FF0D31C4E.quest_desc": ["Find a village and meet the guards who stand watch there.", "", "&7&oVillagers sleep easier when somebody carries a sword."]
	"quest.2C07676FF0D31C4E.title": "Village Watch"
	"quest.2C5102CB49F93F6D.quest_desc": ["Find an End City and slay 4 Shulkers.", "", "&7&oPurpur towers and a lot of floating boxes."]
	"quest.2C5102CB49F93F6D.title": "End City Raid"
	"quest.2C62D0F9AB4F889E.quest_desc": ["Craft a Salvager Suit.", "", "&7&oLeather and iron, stitched around an echo of the ship graveyard."]
	"quest.2C62D0F9AB4F889E.title": "Salvager's Suit"
	"quest.2C6ADCA2BAC10802.quest_desc": ["Craft a Zanite Pickaxe and a Zanite Sword.", "", "&7&oWorn zanite tools are fast tools, so use them hard."]
	"quest.2C6ADCA2BAC10802.title": "Zanite Tools"
	"quest.2C7383E356F10A61.quest_desc": ["Gather 5 Chromatic Aerclouds and craft a Stratus Ingot.", "", "&7&oThe rarest metal of the sky, built from cloud and gravity."]
	"quest.2C7383E356F10A61.title": "Stratus"
	"quest.2C862894FE756B67.quest_desc": ["Find an Ancient Temple in the Deeplands.", "", "&7&oCold gloomslate halls, older than your arrival."]
	"quest.2C862894FE756B67.title": "The Ancient Temple"
	"quest.2CABFD3A90F71B57.quest_desc": ["Craft 27 Blast Bricks and form a Blast Furnace with your hammer.", "", "&7&oIron and coke go in. Steel comes out, slowly."]
	"quest.2CABFD3A90F71B57.title": "Blast Furnace"
	"quest.2CC467EE11EF8711.quest_desc": ["Finish every other quest in this chapter.", "", "&7&oThe void looks back at you, and blinks first."]
	"quest.2CC467EE11EF8711.quest_subtitle": "Chapter reward: Starbloom Die"
	"quest.2CC467EE11EF8711.title": "The End Mastered"
	"quest.2CCFFC839CAB9B49.quest_desc": ["Visit a Smogstem Forest and a Wigglewood Forest.", "", "&7&oTwo forests, no sunlight."]
	"quest.2CCFFC839CAB9B49.title": "Smog and Wigglewood"
	"quest.2CEB5B8DEEC57E68.quest_desc": ["Craft 2 Extended Machine Frames and a Crystal Assembler.", "", "&7&oMost of this mod's machines come out of the assembler, not a crafting grid."]
	"quest.2CEB5B8DEEC57E68.title": "Crystal Assembler"
	"quest.2CF00F979EF59D61.quest_desc": ["Slay a Naga and craft a Naga Fang Dagger.", "", "&7&oA serpent that dives from above. Its fang makes a fine dagger."]
	"quest.2CF00F979EF59D61.title": "Winged Serpent"
	"quest.2CF2DABB61A8C9E7.quest_desc": ["Craft a Mechanical Arm.", "", "&7&oIt picks up, sorts and drops without a funnel in sight."]
	"quest.2CF2DABB61A8C9E7.title": "Helping Hand"
	"quest.2CF7D0F4040FAFF4.quest_desc": ["Slay 3 Nightfall Spiders and 3 Lonestar Skeletons.", "", "&7&oHostile mobs of the twilit wild."]
	"quest.2CF7D0F4040FAFF4.title": "Night Hunters"
	"quest.2CFDA77CB9EA1D7C.quest_desc": ["Collect 3 Wither Skeleton Skulls and kill the Wither.", "", "&7&oSoul sand, three skulls and a very open space."]
	"quest.2CFDA77CB9EA1D7C.quest_subtitle": "Hard quest: Moonpetal Die"
	"quest.2CFDA77CB9EA1D7C.title": "Wither Away"
	"quest.2CFEC5B161D06C56.quest_desc": ["Craft a Portal Keyhole.", "", "&7&oGilded portal, ender eye and a trapped chest."]
	"quest.2CFEC5B161D06C56.title": "Turn the Key"
	"quest.2D10FABFCA4B0EFF.quest_desc": ["Distil JoJannik Select, Lilitu Single Malt and MaggoAllan.", "", "&7&oEach blend takes two dried grains and a pinch of yeast."]
	"quest.2D10FABFCA4B0EFF.title": "The Whiskey Shelf"
	"quest.2D453B92B6FDE379.quest_desc": ["Finish every other quest in this chapter.", "", "&7&oEvery cut, connected and tidy."]
	"quest.2D453B92B6FDE379.quest_subtitle": "Chapter reward: Golden Bloom Die"
	"quest.2D453B92B6FDE379.title": "Rechiseled: Create Mastered"
	"quest.2D4B5F644AF97849.quest_desc": ["Craft a Petal Apothecary.", "", "&7&oFill it with water, then drop in petals and a seed to brew a flower."]
	"quest.2D4B5F644AF97849.title": "Petal Apothecary"
	"quest.2D59948203366427.quest_desc": ["Craft an End Stone Knife and a Purpur Knife.", "", "&7&oPopped chorus fruit is the handle. Smelt chorus fruit to get it."]
	"quest.2D59948203366427.title": "End Knives"
	"quest.2D7DA9082E39F8C9.quest_desc": ["Mix 8 Biomass in a heated basin and compact 16 Biomass Pellets.", "", "&7&oCompacted plant matter makes a clean fuel for burners."]
	"quest.2D7DA9082E39F8C9.title": "Burner Fuel"
	"quest.2D824276F34FAB66.quest_desc": ["Slay 2 Dread Knights and 3 Dread Ghouls.", "", "&7&oArmoured, mounted and slow to fall. Fight them one at a time."]
	"quest.2D824276F34FAB66.title": "The Dreaded Host"
	"quest.2D973B58F4DC46D7.quest_desc": ["Visit a tide pool and collect a Sea Star and a Sea Urchin.", "", "&7&oSmall creatures cling to the rocks at low tide."]
	"quest.2D973B58F4DC46D7.title": "Tide Pools"
	"quest.2DA9F9B833EBAC99.quest_desc": ["Find a ruined portal.", "", "&7&oIts chest is yours alone: every player gets their own loot."]
	"quest.2DA9F9B833EBAC99.title": "Old Stones"
	"quest.2DB01D2A731932FF.quest_desc": ["Recover a Cannon from sunken loot.", "", "&7&oMount it on the hullback's back and nothing at sea is out of reach."]
	"quest.2DB01D2A731932FF.title": "Broadside"
	"quest.2DCDF14D2493746F.quest_desc": ["Craft a Blank Magic Map.", "", "&7&oA focus of feather, berry and glowstone shows the forest as you walk."]
	"quest.2DCDF14D2493746F.title": "Chart the Woods"
	"quest.2DD38EA8ABC38AD4.quest_desc": ["Kill a Shockcat, take a Shocking Tendril and craft Nautical Lamps.", "", "&7&oAbout half of them drop a tendril, and one tendril lights three lamps."]
	"quest.2DD38EA8ABC38AD4.title": "Shock Value"
	"quest.2DF9DCA619841240.quest_desc": ["Find a village and look for the waystone in its square.", "", "&7&oTouch one and it remembers you."]
	"quest.2DF9DCA619841240.title": "Stones in the Square"
	"quest.2DFD5D466B583C43.quest_desc": ["Find an Illusioner Shack and defeat the illusioner inside.", "", "&7&oHe fills the air with copies of himself, so strike the real one."]
	"quest.2DFD5D466B583C43.quest_subtitle": "Dangerous: bring armour and a shield"
	"quest.2DFD5D466B583C43.title": "Smoke and Mirrors"
	"quest.2E0B4C161D96DDFF.quest_desc": ["Make 4 Entro Crystals and 4 Entro Infused Ingots.", "", "&7&oEntro is the crystal behind nearly every part of this mod."]
	"quest.2E0B4C161D96DDFF.title": "Entro"
	"quest.2E0C963E2B859E36.quest_desc": ["Craft a Stove and a Cooking Pot.", "", "&7&oBakery, Brewery and Candlelight dishes cook on these stations too."]
	"quest.2E0C963E2B859E36.title": "Stove and Pot"
	"quest.2E176CA171CCBC15.quest_desc": ["Craft 2 Blue Brass Cage Lamps and a Blue Shipping Container.", "", "&7&oLamps for the yard, a crate to keep your cargo in."]
	"quest.2E176CA171CCBC15.title": "Lamps and Containers"
	"quest.2E1FF3E9C0B1A0BE.quest_desc": ["Light an Aether portal and step into the Aether.", "", "&7&oA glowstone frame lit with water. Fall off an island and you land in the Overworld."]
	"quest.2E1FF3E9C0B1A0BE.title": "Above the Clouds"
	"quest.2E246635B714B35E.quest_desc": ["Finish every other quest in this chapter.", "", "&7&oEvery colour in the tank and a friend at your side."]
	"quest.2E246635B714B35E.quest_subtitle": "Chapter reward: Golden Bloom Die"
	"quest.2E246635B714B35E.title": "Axolotls Mastered"
	"quest.2E6004B98BFD4F3F.quest_desc": ["Make 2 Electron Tubes and a Deployer.", "", "&7&oIt places, uses and attacks like a player who never sleeps."]
	"quest.2E6004B98BFD4F3F.title": "A Hand That Never Tires"
	"quest.2E65C87189646EB5.quest_desc": ["Craft a Manaweave Cloth from 4 Mana String.", "", "&7&oArmour stitched from it is light and mends itself with mana."]
	"quest.2E65C87189646EB5.title": "Manaweave"
	"quest.2EA50E7649911112.quest_desc": ["Cook a Stuffed Red Bell Pepper.", "", "&7&oRoasted, sliced or stuffed: every colour makes something different."]
	"quest.2EA50E7649911112.title": "Stuffed Peppers"
	"quest.2EAE7562C5EAF4D9.quest_desc": ["Take a selfie.", "", "&7&oTurn the camera round on yourself."]
	"quest.2EAE7562C5EAF4D9.title": "Spotlight"
	"quest.2EB42723EC89A6BB.quest_desc": ["Enter the Otherside dimension.", "", "&7&oA lightless world where the sculk grows wild."]
	"quest.2EB42723EC89A6BB.title": "The Otherside"
	"quest.2EC159756065E200.quest_desc": ["Craft 4 Basic and 4 Light Engineering Blocks.", "", "&7&oThe frames that most machines and components are built around."]
	"quest.2EC159756065E200.title": "Engineering Blocks"
	"quest.2ECC4AFFE76A1278.quest_desc": ["Craft an ME Wireless Connector and a Wireless Hub.", "", "&7&oLink machines to your network with no cables at all."]
	"quest.2ECC4AFFE76A1278.title": "Wireless Hub"
	"quest.2ED3445AF3FEC044.quest_desc": ["Craft a Brush and uncover a pottery sherd.", "", "&7&oSuspicious sand and gravel in ruins and old wells hide small treasures."]
	"quest.2ED3445AF3FEC044.title": "Brush Off the Past"
	"quest.2EFCF6B0D2A46487.quest_desc": ["Smelt 4 Ironwood Ingots from Raw Ironwood.", "", "&7&oLiveroot, raw iron and a gold nugget make the raw ironwood."]
	"quest.2EFCF6B0D2A46487.title": "Ironwood"
	"quest.2F0EBE55CA450477.quest_desc": ["Find a Brewfest tent out in the world.", "", "&7&oLong benches, big barrels and plenty of mugs."]
	"quest.2F0EBE55CA450477.title": "Brewfest"
	"quest.2F24676856EB503E.quest_desc": ["Craft an Oak Fish Plaque to show off a prize catch.", "", "&7&oA trophy for the fish that nearly got away."]
	"quest.2F24676856EB503E.title": "Mounted on the Wall"
	"quest.2F33D9538D85D2E4.quest_desc": ["Craft a Helm from logs, sticks and a lead.", "", "&7&oEvery vessel needs someone at the wheel."]
	"quest.2F33D9538D85D2E4.title": "At the Wheel"
	"quest.2F34D75E9F112DC9.quest_desc": ["Craft an Incubator and hatch a Moa from an egg.", "", "&7&oA Moa jumps again and again, and is a good way to cross gaps."]
	"quest.2F34D75E9F112DC9.title": "Moa Rider"
	"quest.2F405375980971B7.quest_desc": ["Gather 8 Dark Cherry Logs and a Dark Cherry Sapling.", "", "&7&oIts dark wood makes fine barrels, shelves and tables for a cellar."]
	"quest.2F405375980971B7.title": "Dark Cherry Grove"
	"quest.2F504F6D387EBE32.quest_desc": ["Tame a wild hamster with Sliced Cucumber.", "", "&7&oIt can take a few slices; their cheeks hold more than you would think."]
	"quest.2F504F6D387EBE32.title": "Cheek to Cheek"
	"quest.2F50AA932C21BA64.quest_desc": ["Craft Shellstone from 2 Calcite and 2 Snail Shells.", "", "&7&oSnail shells and calcite make a pale, patterned stone."]
	"quest.2F50AA932C21BA64.title": "Shellstone"
	"quest.2F5B324A12BA9261.quest_desc": ["Craft 2 Alternators, 2 Electric Motors and 4 Accumulators.", "", "&7&oGeneration, storage and drive, all on one grid."]
	"quest.2F5B324A12BA9261.quest_subtitle": "Hard quest: Moonpetal Die"
	"quest.2F5B324A12BA9261.title": "Grid Engineer"
	"quest.2F8B25E3CD64E4F5.quest_desc": ["Find the Golem Forge.", "", "&7&oA forge older than any smith."]
	"quest.2F8B25E3CD64E4F5.title": "The Golem Forge"
	"quest.2FB70F2B6F1DC044.quest_desc": ["Collect a Gazelle Horn and 2 Kangaroo Meat.", "", "&7&oEvery creature leaves something worth keeping."]
	"quest.2FB70F2B6F1DC044.title": "First Trophies"
	"quest.2FEE0D524261B1E3.quest_desc": ["Find 2 Red Grape Seeds and 2 White Grape Seeds.", "", "&7&oVines are slow growers. Plant early and be patient."]
	"quest.2FEE0D524261B1E3.title": "Grapes by Season"
	"quest.2FFD947EF4A3CFA5.quest_desc": ["Craft 6 Oak Picket Fences and 4 Oak Hedges.", "", "&7&oWhite pickets, or a green wall made of leaves."]
	"quest.2FFD947EF4A3CFA5.title": "Fences and Hedges"
	"quest.302FB2599DD4E357.quest_desc": ["Craft 16 Basic Universal Cables and an Energy Tablet.", "", "&7&oCables carry Joules between machines; tablets are portable power."]
	"quest.302FB2599DD4E357.title": "Power Lines"
	"quest.30328790B290DCFA.quest_desc": ["Simmer a Goulash in the cooking pot.", "", "&7&oOnion, beef, carrot, potato and tomato soup, all in one bowl."]
	"quest.30328790B290DCFA.title": "Farmhouse Supper"
	"quest.304A6C91DF3F0B2D.quest_desc": ["Craft a Mincer and grind 4 Minced Beef.", "", "&7&oThe mincer also grinds wheat into flour."]
	"quest.304A6C91DF3F0B2D.title": "The Mincer"
	"quest.30778DBFDA0FA47A.quest_desc": ["Craft an Uncrafting Table.", "", "&7&oA Maze Map Focus from the labyrinth sits at its heart. It takes crafted items apart."]
	"quest.30778DBFDA0FA47A.title": "Take It Apart"
	"quest.30B4D0F799A18AD5.quest_desc": ["Craft 4 Redstone Lamps and a Lever to switch the lights.", "", "&7&oDim the room before the film starts."]
	"quest.30B4D0F799A18AD5.title": "Lights Down"
	"quest.30D226C24404F502.quest_desc": ["Find a small graveyard, then slay 2 Ghouls in the woods at night.", "", "&7&oGraveyards sit in open country. Ghouls prefer the trees."]
	"quest.30D226C24404F502.title": "Restless Ground"
	"quest.30E2E8C9B848F398.quest_desc": ["Craft a Steel Pickaxe, Axe and Shovel.", "", "&7&oTougher than iron and still cheap."]
	"quest.30E2E8C9B848F398.title": "Steel Tools"
	"quest.30EC691F1DB92A67.quest_desc": ["Collect 2 Raven Feathers.", "", "&7&oRavens are shy. Creep up on them, or let them come to you."]
	"quest.30EC691F1DB92A67.title": "Black Feathers"
	"quest.30FF61B4D2EAEA5E.quest_desc": ["Craft 27 Coke Bricks and form a Coke Oven with your hammer.", "", "&7&oCoal in, coal coke and creosote oil out."]
	"quest.30FF61B4D2EAEA5E.title": "Coke Oven"
	"quest.3115DF7E327247CC.quest_desc": ["Visit the Yagroot Swamp and kill 3 Venomites.", "", "&7&oPoison pools and stinging insects. Pack an antidote."]
	"quest.3115DF7E327247CC.title": "The Yagroot Swamp"
	"quest.315A4AA2D7D49C6A.quest_desc": ["Craft 8 Conveyor Belts and lay one down.", "", "&7&oCheap, tireless transport, and mobs ride it too."]
	"quest.315A4AA2D7D49C6A.title": "Conveyor Belts"
	"quest.31D70B39A9976A58.quest_desc": ["Upgrade to a Gold Backpack with 8 gold ingots.", "", "&7&oHeavy on the back, light on excuses to leave things behind."]
	"quest.31D70B39A9976A58.title": "Gold Backpack"
	"quest.3213BDB3FCD73A0B.quest_desc": ["Craft a Heat Generator and bring a bucket of lava to feed it.", "", "&7&oBurn lava or any furnace fuel for steady power."]
	"quest.3213BDB3FCD73A0B.title": "Heat Generator"
	"quest.324FD417C4BACA14.quest_desc": ["Enter the Starlight dimension.", "", "&7&oAlways night here, and always bright."]
	"quest.324FD417C4BACA14.title": "Starlit Skies"
	"quest.3271E1569F6D3D0F.quest_desc": ["Defeat a Swamp Creeper in a swamp.", "", "&7&oIt lurks where the water is dark and still."]
	"quest.3271E1569F6D3D0F.title": "Murky Waters"
	"quest.32958A5998E8C454.quest_desc": ["Craft an HV Accumulator and 2 Electrum Coil Blocks, then a Railgun.", "", "&7&oAluminium, plastic and electron tubes: the longest chain in the book."]
	"quest.32958A5998E8C454.quest_subtitle": "Hard quest: Moonpetal Die"
	"quest.32958A5998E8C454.title": "The Railgun"
	"quest.32B32B535DB84F5D.quest_desc": ["Find the Chapel of Light.", "", "&7&oA quiet place at the edge of the dark."]
	"quest.32B32B535DB84F5D.title": "Chapel of Light"
	"quest.3324CEDC7453490C.quest_desc": ["Finish every other quest in this chapter.", "", "&7&oEvery mask collected, every giant laid low."]
	"quest.3324CEDC7453490C.quest_subtitle": "Chapter reward: Golden Bloom Die"
	"quest.3324CEDC7453490C.title": "Mowzie's Mobs Mastered"
	"quest.33266184B68DFE9A.quest_desc": ["Craft 8 Treated Wood from planks and creosote oil.", "", "&7&oPlain planks, soaked in the oven's creosote, become engineering timber."]
	"quest.33266184B68DFE9A.title": "Treated Wood"
	"quest.3331FE7D21903FCD.quest_desc": ["Find a Denizen Camp.", "", "&7&oMasked locals with a grudge."]
	"quest.3331FE7D21903FCD.title": "Denizen Camp"
	"quest.333B53FD8EDA00C0.quest_desc": ["The End, the deepest dungeons and the last bosses.", "", "&7&oOnly the brave build this far out."]
	"quest.333B53FD8EDA00C0.quest_subtitle": "Deep Wilds, 10 km and beyond"
	"quest.333B53FD8EDA00C0.title": "Legend"
	"quest.334CDB84D42659CA.quest_desc": ["Craft a Notice Board and 4 Item Shelves.", "", "&7&oPin paper to the board; set one item on each shelf."]
	"quest.334CDB84D42659CA.title": "Leave a Note"
	"quest.339230612EB13C2B.quest_desc": ["Gather 96 Bricks for circles, cylinders and domes.", "", "&7&oRound modes need a big stack of one block."]
	"quest.339230612EB13C2B.title": "Round Things Off"
	"quest.33E610E1C1B32122.quest_desc": ["Craft a Warp Stone.", "", "&7&oAmethyst, pearls and an emerald: the core of every waystone."]
	"quest.33E610E1C1B32122.title": "The Warp Stone"
	"quest.33FEC75D17EF40B1.quest_desc": ["Find a fortress and collect 4 Blaze Rods from Blazes.", "", "&7&oDark bricks, narrow bridges and a spawner full of fire."]
	"quest.33FEC75D17EF40B1.title": "Fortress Rods"
	"quest.3428C821939372FD.quest_desc": ["Craft a Skyroot Bed and sleep in the Aether.", "", "&7&oSleep up here and you wake up here."]
	"quest.3428C821939372FD.title": "A Night Above"
	"quest.34453BD6327CDAA7.quest_desc": ["Spout 1000 mB of liquid experience onto a Cake Base o' Enchanting.", "", "&7&oSlice it, eat it, and the levels come back."]
	"quest.34453BD6327CDAA7.title": "Cake o' Enchanting"
	"quest.34C7CD2ABF197966.quest_desc": ["Craft 4 White Glow Panels.", "", "&7&oThin lights that stick to any face, built from HDPE sheets."]
	"quest.34C7CD2ABF197966.title": "Glow Panels"
	"quest.34D50837DEB93508.quest_desc": ["Roast 4 Coffee Beans and brew a Coffee.", "", "&7&oRoasting turns a green bean into a dark one."]
	"quest.34D50837DEB93508.title": "Coffee Beans"
	"quest.351464C42D728F4F.quest_desc": ["Craft a Cutting Board and use it.", "", "&7&oCarve, slice and assemble here. Many recipes in this mod start on the board."]
	"quest.351464C42D728F4F.title": "A Proper Cutting Board"
	"quest.351633D1E8D335B0.quest_desc": ["Smith a Blaze Forger from a Blaze Burner and an Anvil with another upgrade template.", "", "&7&oRepair and combine items with liquid experience."]
	"quest.351633D1E8D335B0.title": "Anvil Without the Trips"
	"quest.35E6299901C81B4C.quest_desc": ["Find a Hydra cave and slay the Hydra.", "", "&7&oCut one head off and the rest keep biting. Poison is only the start."]
	"quest.35E6299901C81B4C.title": "Many Heads"
	"quest.35E75AC1B2741A07.quest_desc": ["Defeat a Birch Creeper in a birch forest.", "", "&7&oEach biome now grows its own kind of creeper."]
	"quest.35E75AC1B2741A07.title": "Creepers Everywhere"
	"quest.35FE81BC98023008.quest_desc": ["Craft a Seasonal Prayer Scroll.", "", "&7&oUsed on a core container, it slowly nurtures a core for the current season."]
	"quest.35FE81BC98023008.title": "A Seasonal Prayer"
	"quest.36AFD4DFE86652D4.quest_desc": ["Craft an End Stove and cook Chorus Sauce.", "", "&7&oSucculents and chorus fruit make a sauce that goes with everything."]
	"quest.36AFD4DFE86652D4.title": "The End Stove"
	"quest.37058AAFF6AD4B2C.quest_desc": ["Craft an Inscription Table.", "", "&7&oSpells are written onto a book here, one slot at a time."]
	"quest.37058AAFF6AD4B2C.title": "Inscription Table"
	"quest.37217755F3846349.quest_desc": ["Cross the Crystallized Desert and gather 16 Crystallized Sand.", "", "&7&oSand that has hardened into glittering glass."]
	"quest.37217755F3846349.title": "Crystal Sands"
	"quest.374434B0EC98054D.quest_desc": ["Finish every other quest in this chapter.", "", "&7&oBigger, louder and all of them defeated."]
	"quest.374434B0EC98054D.quest_subtitle": "Chapter reward: Moonpetal Die"
	"quest.374434B0EC98054D.title": "Mutants Mastered"
	"quest.374D0A2ACA677411.quest_desc": ["Find a Lich Tower, slay the Night Lich and take its Ancient Anima.", "", "&7&oA necromancer of night: all comets, minions and a lot of teleporting."]
	"quest.374D0A2ACA677411.title": "The Night Lich"
	"quest.37583C57AB5DC1B5.quest_desc": ["Craft a Nasa Workbench, a Compressor and a Launch Pad.", "", "&7&oRockets are built at the workbench from steel plates pressed in a compressor."]
	"quest.37583C57AB5DC1B5.title": "Rocket Science"
	"quest.37696279DDA1CE6F.quest_desc": ["Finish every other quest in this chapter.", "", "&7&oNothing new in the world, only better places for everything old."]
	"quest.37696279DDA1CE6F.quest_subtitle": "Chapter reward: Bloom Die"
	"quest.37696279DDA1CE6F.title": "Amendments Mastered"
	"quest.37DB54EDD9D7E078.quest_desc": ["Craft a Crafting Table and a Wooden Pickaxe.", "", "&7&oYou woke up somewhere quiet. The further you go from here, the wilder it gets."]
	"quest.37DB54EDD9D7E078.title": "The Meadow Camp"
	"quest.382132D027B31E9F.quest_desc": ["Reach the Deeplands and Overcast Columns, then bring back 2 Soul Crystals.", "", "&7&oThe deepest, darkest reaches of the Otherside."]
	"quest.382132D027B31E9F.title": "The Deeplands"
	"quest.386AAFC8A77F28E0.quest_desc": ["Craft a Portal Key and a Gilded Portal.", "", "&7&oA name tag and a blaze rod open the way."]
	"quest.386AAFC8A77F28E0.title": "Keys to Elsewhere"
	"quest.388CC48611CB2FB1.quest_desc": ["Purify 2 White Chalk and 2 Yellow Chalk in spirit fire.", "", "&7&oRitual circles are drawn on the ground in chalk, so bring plenty."]
	"quest.388CC48611CB2FB1.title": "Chalk and Circles"
	"quest.38AE8AFD25D35FE7.quest_desc": ["Try your chosen combat style on 3 zombies.", "", "&7&oSkilled or simple, your pick. The shrine at spawn lets you switch, with a cooldown."]
	"quest.38AE8AFD25D35FE7.title": "Choose Your Style"
	"quest.38D074B94D332E89.quest_desc": ["Make a Honey Cookie, a Sweet Berry Cookie and a Cake.", "", "&7&oSugar counts as variety just as much as vegetables do."]
	"quest.38D074B94D332E89.title": "Sweet Tooth"
	"quest.38E656927B95A2F5.quest_desc": ["Slay a Marauder and a Basher.", "", "&7&oThe raid has new recruits. Bashers hide behind shields, so bring an axe."]
	"quest.38E656927B95A2F5.title": "New Faces in the Raid"
	"quest.38E8822BD55060B0.quest_desc": ["Take an Elytra from an End ship.", "", "&7&oSome cities moor a ship nearby. Its prize lets you glide."]
	"quest.38E8822BD55060B0.title": "Wings of the End"
	"quest.391F8C011ABF806F.quest_desc": ["Craft a Moonpetal Dice from 3 Golden Bloom Dice, 4 Amethyst Shards and an Eye of Ender.", "", "&7&oGolden dice come from hard quests and later chapters. Better odds, and mishaps return."]
	"quest.391F8C011ABF806F.quest_subtitle": "Needs an Eye of Ender and 3 Golden Bloom Dice"
	"quest.391F8C011ABF806F.title": "Moonpetal"
	"quest.3922D7250ABE8E20.quest_desc": ["Craft a Catalyst.", "", "&7&oUse it on a stone brick frame to open the way down."]
	"quest.3922D7250ABE8E20.title": "Below the Below"
	"quest.394B33FBDC1E9889.quest_desc": ["Finish every other quest in this chapter.", "", "&7&oEvery ore multiplied, every watt accounted for."]
	"quest.394B33FBDC1E9889.quest_subtitle": "Chapter reward: Moonpetal Die"
	"quest.394B33FBDC1E9889.title": "Mekanism Mastered"
	"quest.394C56A47BAA8080.quest_desc": ["Bind an Afrit book, summon an Unbound Afrit by ritual and defeat it.", "", "&7&oIesnium, gunpowder and a sacrificed cow call up a fire spirit in a foul mood."]
	"quest.394C56A47BAA8080.quest_subtitle": "Hard quest: Moonpetal Die"
	"quest.394C56A47BAA8080.title": "The Unbound Afrit"
	"quest.39739D3DAA23CF4F.quest_desc": ["Kill 3 slimes, then craft a Framed Tank and a Framed Bouncy Cube.", "", "&7&oThe tank shows off whatever fluid it holds. The cube needs slimeballs."]
	"quest.39739D3DAA23CF4F.title": "Bounce and Splash"
	"quest.39BE87EB3FC3C17C.quest_desc": ["Defeat a Beach Creeper on a beach.", "", "&7&oA fuse on the shore sounds like the tide."]
	"quest.39BE87EB3FC3C17C.title": "Sand and Surf"
	"quest.39E54A8CB74CD267.quest_desc": ["Craft a full set of Sorceror armour: collar, wrap, leggings and footpads.", "", "&7&oMagic clothing that deepens your mana pool, one piece at a time."]
	"quest.39E54A8CB74CD267.title": "Sorcerer's Wardrobe"
	"quest.39F25A41DCAFBEA4.quest_desc": ["Finish every other quest in this chapter.", "", "&7&oEvery drop of experience put to work."]
	"quest.39F25A41DCAFBEA4.quest_subtitle": "Chapter reward: Golden Bloom Die"
	"quest.39F25A41DCAFBEA4.title": "Enchantment Industry Mastered"
	"quest.39FA0CA9B3E96CC7.quest_desc": ["Smith a Storm Sword at a smithing table.", "", "&7&oA skyjade blade, a stormforged template and a squall plate."]
	"quest.39FA0CA9B3E96CC7.title": "Stormforged"
	"quest.3A753F1E557718B4.quest_desc": ["Other worlds, far biomes and the roads between them."]
	"quest.3A753F1E557718B4.title": "Explore"
	"quest.3A92FC5EF8C0F65E.quest_desc": ["Craft a Honey Compass.", "", "&7&oPoint it at the hive's secrets."]
	"quest.3A92FC5EF8C0F65E.title": "Honey Compass"
	"quest.3AC035BA89DEC022.quest_desc": ["Find the gold dungeon and kill the Sun Spirit.", "", "&7&oFire from every side. Bring fire resistance and plenty of food."]
	"quest.3AC035BA89DEC022.quest_subtitle": "Hard quest: Moonpetal Die"
	"quest.3AC035BA89DEC022.title": "The Sun Spirit"
	"quest.3AF8280C178D0384.quest_desc": ["Finish every other quest in this chapter.", "", "&7&oThe stars shine a little brighter for you."]
	"quest.3AF8280C178D0384.quest_subtitle": "Chapter reward: Moonpetal Die"
	"quest.3AF8280C178D0384.title": "Starlight Mastered"
	"quest.3AFF74EA9FFEAB12.quest_desc": ["Finish every other quest in this chapter.", "", "&7&oFresh from the deep, cooked just right."]
	"quest.3AFF74EA9FFEAB12.quest_subtitle": "Chapter reward: Golden Bloom Die"
	"quest.3AFF74EA9FFEAB12.title": "Ocean's Delight Mastered"
	"quest.3B0EE725CF460007.quest_desc": ["Finish every other quest in this chapter.", "", "&7&oThe storm is quiet, and the deeper sky is yours."]
	"quest.3B0EE725CF460007.quest_subtitle": "Chapter reward: Moonpetal Die"
	"quest.3B0EE725CF460007.title": "Deep Aether Mastered"
	"quest.3B39E42D602E82FA.quest_desc": ["Catch 2 Pondies.", "", "&7&oRivers and forest ponds are where they gather."]
	"quest.3B39E42D602E82FA.title": "Pond Life"
	"quest.3B55314859D3FA5E.quest_desc": ["Finish every other quest in this chapter.", "", "&7&oFour bosses down and the sky a little quieter."]
	"quest.3B55314859D3FA5E.quest_subtitle": "Chapter reward: Starbloom Die"
	"quest.3B55314859D3FA5E.title": "Bosses Mastered"
	"quest.3BAFEACFB9834B54.quest_desc": ["Find an Illusioner Tower, slay its Illusioner and take 2 Illusionary Dust.", "", "&7&oNothing in there is quite where it looks."]
	"quest.3BAFEACFB9834B54.title": "The Illusioner's Tower"
	"quest.3BB9994AB47EFDC6.quest_desc": ["Craft a Purification Chamber and a Chemical Injection Chamber.", "", "&7&oOxygen yields three clumps per ore; hydrogen chloride yields four shards."]
	"quest.3BB9994AB47EFDC6.title": "Triple Your Ore"
	"quest.3BCBA64C8DA01999.quest_desc": ["Craft a Winemaker Apron, Winemaker Boots and a Straw Hat.", "", "&7&oA proper vintner dresses for the vines."]
	"quest.3BCBA64C8DA01999.title": "Winemaker's Garb"
	"quest.3BCD7B91728DC7CD.quest_desc": ["Dungeons, towers and the first real bosses.", "", "&7&oSeasons start to matter out here."]
	"quest.3BCD7B91728DC7CD.quest_subtitle": "Frontier, 2 to 5 km"
	"quest.3BCD7B91728DC7CD.title": "Venture"
	"quest.3BDAA836254933F8.quest_desc": ["Form a Crusher and grind 8 Iron Grit.", "", "&7&oOre in, grit out, and sometimes a bonus."]
	"quest.3BDAA836254933F8.title": "The Crusher"
	"quest.3BE8B75CF430D8D8.quest_desc": ["Slay an Invoker and take its Primal Essence.", "", "&7&oIt summons fangs from the floor. Never stand in a line."]
	"quest.3BE8B75CF430D8D8.title": "The Invoker"
	"quest.3C028E4ECF9C40B9.quest_desc": ["Craft 4 Heavy Engineering Blocks.", "", "&7&oSteel and electrum frames: the skeleton of the big multiblocks."]
	"quest.3C028E4ECF9C40B9.title": "Heavy Engineering"
	"quest.3C6D3F3FEFDCD2EA.quest_desc": ["Finish every other quest in this chapter.", "", "&7&oThe cold sea gave up its secrets, and you are still dry."]
	"quest.3C6D3F3FEFDCD2EA.quest_subtitle": "Chapter reward: Moonpetal Die"
	"quest.3C6D3F3FEFDCD2EA.title": "Aquamirae Mastered"
	"quest.3C854D9AA5123185.quest_desc": ["Craft a Waystone and set it down at home.", "", "&7&oPlace it once and every journey can end there."]
	"quest.3C854D9AA5123185.title": "Your Own Waystone"
	"quest.3C8AFD2BB3BA7C4F.quest_desc": ["Finish every other quest in this chapter.", "", "&7&oOld friends made, old foes beaten."]
	"quest.3C8AFD2BB3BA7C4F.quest_subtitle": "Chapter reward: Bloom Die"
	"quest.3C8AFD2BB3BA7C4F.title": "Friends \\& Foes Mastered"
	"quest.3CAA5646E1C18107.quest_desc": ["Find the Throne Pillar.", "", "&7&oWhere the Bee Queen holds court."]
	"quest.3CAA5646E1C18107.title": "The Throne Pillar"
	"quest.3CC01665BE50040F.quest_desc": ["Make Corn Dough and cook 4 Tortillas.", "", "&7&oDough crisps into tortillas on a campfire, in a smoker or in a furnace."]
	"quest.3CC01665BE50040F.title": "Corn Dough"
	"quest.3CD52E32EFABAE86.quest_desc": ["Chisel 16 Polished Cut Deepslate.", "", "&7&oThe darkest stone makes the sharpest edges."]
	"quest.3CD52E32EFABAE86.title": "Deepslate Cuts"
	"quest.3D296CE48D51E3D4.quest_desc": ["Craft an Ore Grinder from a grindstone, iron ingots and stone.", "", "&7&oA job site for villagers who work with ore."]
	"quest.3D296CE48D51E3D4.title": "Ore Grinder"
	"quest.3D2A6ED1F9EF5526.quest_desc": ["Craft a Cauldron and 3 Glass Bottles.", "", "&7&oCauldrons learn to hold more than plain water."]
	"quest.3D2A6ED1F9EF5526.title": "More Than Water"
	"quest.3D5C2D55DFEF9445.quest_desc": ["Finish every other quest in this chapter.", "", "&7&oEvery wheel turning, every belt running."]
	"quest.3D5C2D55DFEF9445.quest_subtitle": "Chapter reward: Bloom Die"
	"quest.3D5C2D55DFEF9445.title": "Create Mastered"
	"quest.3DA4E0EF0861DFBA.quest_desc": ["Craft a Hazmat Mask, Gown, Pants and Boots, plus a Geiger Counter.", "", "&7&oFission waste is dangerous; the suit blocks radiation and the counter reads it."]
	"quest.3DA4E0EF0861DFBA.title": "Radiation Safety"
	"quest.3DAB588FAFF9138E.quest_desc": ["Craft an Alteration Table.", "", "&7&oWeave thread onto your armour to add perks without changing its stats."]
	"quest.3DAB588FAFF9138E.title": "Alteration Table"
	"quest.3DB8DF5037885D97.quest_desc": ["Finish every other quest in this chapter.", "", "&7&oA blade for every hand and every enemy."]
	"quest.3DB8DF5037885D97.quest_subtitle": "Chapter reward: Golden Bloom Die"
	"quest.3DB8DF5037885D97.title": "Simply Swords Mastered"
	"quest.3DE593473ABDA592.quest_desc": ["Craft an Iron Katana and an Iron Rapier.", "", "&7&oLight blades trade weight for speed. Hit often and keep moving."]
	"quest.3DE593473ABDA592.title": "Quick Steel"
	"quest.3E4E6CD8EA88B14D.quest_desc": ["Finish every other quest in this chapter.", "", "&7&oThe last course, served at the edge of the world."]
	"quest.3E4E6CD8EA88B14D.quest_subtitle": "Chapter reward: Starbloom Die"
	"quest.3E4E6CD8EA88B14D.title": "End's Delight Mastered"
	"quest.3E7B68495234A5F3.quest_desc": ["Defend the village: kill 10 zombies.", "", "&7&oRing the village bell and villagers run indoors while the guards fight."]
	"quest.3E7B68495234A5F3.title": "Ring the Bell"
	"quest.3E9FD7016305DDF7.quest_desc": ["Defeat a Dripstone Creeper in dripstone caves.", "", "&7&oIt blends in with the stone teeth of the cave, and sheds a few when beaten."]
	"quest.3E9FD7016305DDF7.title": "Stone Teeth"
	"quest.3EA6F7553F2A477F.quest_desc": ["Craft a Starbuncle Charm.", "", "&7&oStarbuncles ferry items between chests for you, tirelessly."]
	"quest.3EA6F7553F2A477F.title": "A Helpful Starbuncle"
	"quest.3EBA1DF15BCCB5CA.quest_desc": ["Finish every other quest in this chapter.", "", "&7&oRopes tied, jars filled, every corner a little tidier."]
	"quest.3EBA1DF15BCCB5CA.quest_subtitle": "Chapter reward: Bloom Die"
	"quest.3EBA1DF15BCCB5CA.title": "Supplementaries Mastered"
	"quest.3EE0E33E14E8197A.quest_desc": ["Finish every other quest in this chapter.", "", "&7&oEvery chest connected, nothing lost."]
	"quest.3EE0E33E14E8197A.quest_subtitle": "Chapter reward: Golden Bloom Die"
	"quest.3EE0E33E14E8197A.title": "Tom's Storage Mastered"
	"quest.3F000EFF360B90DB.quest_desc": ["Summon a Dracolotl and catch it in a bucket.", "", "&7&oSet the egg on the pillar and use it. If it ever dies, the egg comes back."]
	"quest.3F000EFF360B90DB.title": "A Dragon in a Bucket"
	"quest.3F2264ACB3A48808.quest_desc": ["Craft 2 Mana Sparks.", "", "&7&oFloat them above pools and flowers to pass mana between neighbours."]
	"quest.3F2264ACB3A48808.title": "A Spark Between Friends"
	"quest.3F41120DD3C6173F.quest_desc": ["Craft a Honey Bucket.", "", "&7&oA bucket and a honey block make it."]
	"quest.3F41120DD3C6173F.title": "Bucket of Honey"
	"quest.3F55DA8633CC0538.quest_desc": ["Craft a Wireless Access Point, 2 Wireless Boosters and a Wireless Terminal.", "", "&7&oOpen your network from anywhere in range of the access point."]
	"quest.3F55DA8633CC0538.title": "Wireless Access"
	"quest.3F95C2084FDF8C19.quest_desc": ["Craft a Solar Generator and a Wind Generator.", "", "&7&oSolar needs open sky; wind pays better the higher you build."]
	"quest.3F95C2084FDF8C19.title": "Wind and Sun"
	"quest.3FCBFC1D35E8E2A0.quest_desc": ["Craft a Terrible Blade and a Terrible Fang.", "", "&7&oIron, fins and the parts of a fish that should not exist."]
	"quest.3FCBFC1D35E8E2A0.title": "Terrible Arms"
	"quest.4000FDE22293C49B.quest_desc": ["Craft a Portable Energy Interface.", "", "&7&oLike a portable storage interface, but for energy."]
	"quest.4000FDE22293C49B.title": "Charge on the Move"
	"quest.403011B01A706C41.quest_desc": ["Bake 2 Cakes.", "", "&7&oSet one cake on top of another for a double cake."]
	"quest.403011B01A706C41.title": "Double Helping"
	"quest.4033596EEE4EFED7.quest_desc": ["Craft 8 Turbine Casings, 2 Turbine Valves and 2 Turbine Vents.", "", "&7&oA turbine is a hollow tower: casing, valves for pipes, vents for steam."]
	"quest.4033596EEE4EFED7.title": "Turbine Shell"
	"quest.404E49A59E3381BD.quest_desc": ["Hunt a strider, mince the meat and make a Striderloaf.", "", "&7&oStriders walk the lava lakes. Bring something to cross them."]
	"quest.404E49A59E3381BD.title": "Striderloaf"
	"quest.40A73BF670E99DD7.quest_desc": ["Craft a Calorite Engine and a Tier 4 Rocket, then land on Venus and Glacio.", "", "&7&oVenus burns and Glacio freezes: pack for both."]
	"quest.40A73BF670E99DD7.quest_subtitle": "Hard quest: Elderheart Die"
	"quest.40A73BF670E99DD7.title": "Calorite Frontier"
	"quest.40AABC48D39E699B.quest_desc": ["Craft a Red Flag and 6 Red Bunting.", "", "&7&oFlags for the gate, bunting for the party."]
	"quest.40AABC48D39E699B.title": "Colours on the Breeze"
	"quest.40BE60B2576BCA64.quest_desc": ["Craft an Apprentice's Spell Book.", "", "&7&oGold, arcane essence and hogskin bind a book with room for more spells."]
	"quest.40BE60B2576BCA64.title": "Apprentice's Spell Book"
	"quest.4102F0BC4802779F.quest_desc": ["Craft a Combiner.", "", "&7&oSkyjade, ambrosium and holystone, set up for the harder recipes."]
	"quest.4102F0BC4802779F.title": "The Combiner"
	"quest.4127C092A7C1F5A6.quest_desc": ["Craft 4 Mechanical Crafters.", "", "&7&oLink them side by side for recipes bigger than your table."]
	"quest.4127C092A7C1F5A6.title": "Crafting Grid"
	"quest.41316F1DF1704DB2.quest_desc": ["Find any one unique sword in a dungeon chest.", "", "&7&oSome blades carry a name and a power. They sleep in chests, waiting."]
	"quest.41316F1DF1704DB2.title": "Legends in the Loot"
	"quest.414E8DE8D85633F5.quest_desc": ["Slay a Mutant Creeper.", "", "&7&oA creeper that grew up. Keep your distance and your shield high."]
	"quest.414E8DE8D85633F5.title": "Bigger Bang"
	"quest.417368984083DC51.quest_desc": ["Craft 8 Oak Roof pieces.", "", "&7&oProper slopes, ridges and eaves instead of a flat lid of stairs."]
	"quest.417368984083DC51.title": "A Real Roof"
	"quest.4178B2B6CDDD7B1B.quest_desc": ["Find the hydra lair and kill the Hydra.", "", "&7&oMany heads, many fires. Cut one and it grows back sooner than you think."]
	"quest.4178B2B6CDDD7B1B.quest_subtitle": "Hard quest: Golden Bloom Die"
	"quest.4178B2B6CDDD7B1B.title": "Fire in the Swamp"
	"quest.41C7C3DB8A0D2CCE.quest_desc": ["Find a Sempiternal Sanctum.", "", "&7&oA guarded shrine deep in the hive."]
	"quest.41C7C3DB8A0D2CCE.title": "Sempiternal Sanctum"
	"quest.42210416973B0AA3.quest_desc": ["Craft a Lepidopterist's Microscope from a spyglass, a stick and a stone slab.", "", "&7&oUnder the lens, every species has something to tell you."]
	"quest.42210416973B0AA3.title": "A Closer Look"
	"quest.422DB191261C2295.quest_desc": ["Gather 128 planks of any wood.", "", "&7&oWall mode lifts a flat face straight up from your line."]
	"quest.422DB191261C2295.title": "Raise a Wall"
	"quest.4237DD0032701C9F.quest_desc": ["Find a pixie village and collect 4 Pixie Dust.", "", "&7&oSmall, fast and fond of mischief. Their dust is worth the chase."]
	"quest.4237DD0032701C9F.title": "Dust and Hovels"
	"quest.4241D229F8DC878C.quest_desc": ["Craft an Empty Upgrade Orb.", "", "&7&oFour arcane ingots, four cinder essence and mithril, ready for a rune."]
	"quest.4241D229F8DC878C.title": "Upgrade Orb"
	"quest.426CCE7FDDE65642.quest_desc": ["Craft a Mechanical Press and press 8 Iron Sheets.", "", "&7&oMost Create recipes ask for sheets sooner or later."]
	"quest.426CCE7FDDE65642.title": "Under Pressure"
	"quest.42EE2AA9C5C32DF3.quest_desc": ["Craft a Kinetic Dynamo and place it.", "", "&7&oMount the windmill on its face: rotation in, flux out."]
	"quest.42EE2AA9C5C32DF3.title": "Kinetic Dynamo"
	"quest.432507CDCC1AF075.quest_desc": ["Craft an Animal Dictionary from a book, green dye and a creature drop.", "", "&7&oIt records what each animal eats and how it behaves."]
	"quest.432507CDCC1AF075.title": "Know Your Fauna"
	"quest.43619D5BD9D55C8F.quest_desc": ["Craft a Mana Lens.", "", "&7&oSlot it into a spreader to change how its bursts behave."]
	"quest.43619D5BD9D55C8F.title": "Mana Lens"
	"quest.439778CAB64FCCF7.quest_desc": ["Finish every other quest in this chapter.", "", "&7&oThe spirits know your name now."]
	"quest.439778CAB64FCCF7.quest_subtitle": "Chapter reward: Golden Bloom Die"
	"quest.439778CAB64FCCF7.title": "Occultism Mastered"
	"quest.43C28F162C67E1A4.quest_desc": ["Chisel 16 Sandstone into Sandstone Bricks.", "", "&7&oSand-coloured blocks look best with a carved edge."]
	"quest.43C28F162C67E1A4.title": "Desert Masonry"
	"quest.43CEABAF2961F5F4.quest_desc": ["Chisel 16 Oak Planks into Oak Plank Bricks.", "", "&7&oBeams, crates and weaves exist for every wood."]
	"quest.43CEABAF2961F5F4.title": "Carved Planks"
	"quest.441A7919B0A20051.quest_desc": ["Craft a Storage Controller.", "", "&7&oLink nearby chests and barrels and reach them from one place."]
	"quest.441A7919B0A20051.title": "One Screen for All"
	"quest.444E8F04C193DF24.quest_desc": ["Kill 3 pigs with a knife and smoke 2 Hams.", "", "&7&oPigs killed with a knife often drop Ham. Only a smoker cures it."]
	"quest.444E8F04C193DF24.title": "Hog Roast"
	"quest.444F4FF28BDFECEF.quest_desc": ["Craft a Worn Notebook from a book and lapis lazuli.", "", "&7&oThe guide to everything Ars. Keep it close."]
	"quest.444F4FF28BDFECEF.title": "A Worn Notebook"
	"quest.44B63291232380C7.quest_desc": ["Cook 2 Organic Ooze from slime, rotten flesh, sugar and milk.", "", "&7&oA thick brew from the cooking pot, and the Transmogrifier's only fuel."]
	"quest.44B63291232380C7.title": "Primordial Soup"
	"quest.44DE12FC8EBD28E7.quest_desc": ["Find a roadside sign in the wild.", "", "&7&oTravellers leave waymarks where the paths cross."]
	"quest.44DE12FC8EBD28E7.title": "Follow the Signs"
	"quest.4565107556884BB3.quest_desc": ["Craft an Import Bus, an Export Bus, a Storage Bus and an Interface.", "", "&7&oBuses move items in and out; interfaces hold and request them."]
	"quest.4565107556884BB3.title": "Buses and Interfaces"
	"quest.457310231AF5CBA2.quest_desc": ["Craft an Alchemist Cauldron and 2 Common Ink.", "", "&7&oInk sets the rarity of the scrolls you forge."]
	"quest.457310231AF5CBA2.title": "Ink and Cauldron"
	"quest.45B0FF110F104730.quest_desc": ["Finish every other quest in this chapter.", "", "&7&oBigger, faster and fully automatic."]
	"quest.45B0FF110F104730.quest_subtitle": "Chapter reward: Starbloom Die"
	"quest.45B0FF110F104730.title": "Extended AE Mastered"
	"quest.45FFE68E65019436.quest_desc": ["Craft 8 Andesite Mesh Fences.", "", "&7&oMesh guards a drop without blocking the view across the floor."]
	"quest.45FFE68E65019436.title": "Guard the Drop"
	"quest.460E7ED19289BE25.quest_desc": ["Craft 2 Framed Glowing Cubes and 4 Framed One-Way Windows.", "", "&7&oGlowing cubes shine; one-way windows show a wall from outside."]
	"quest.460E7ED19289BE25.title": "Lights and Windows"
	"quest.4624FD45A0203E9C.quest_desc": ["Find a Depleted Mine and smelt 8 Cloggrum Ingots.", "", "&7&oThe local iron, in all but name."]
	"quest.4624FD45A0203E9C.title": "Cloggrum"
	"quest.4675D6A773CF1FE9.quest_desc": ["Craft a Knife of any kind. Flint is the cheapest.", "", "&7&oKnives carve meat, slice cakes and cut straw from ripe crops."]
	"quest.4675D6A773CF1FE9.title": "A Kitchen Knife"
	"quest.468B1BFD775E266C.quest_desc": ["Craft an Orb of Prophecy.", "", "&7&oFive crystal shards set in glass: a key to the stars."]
	"quest.468B1BFD775E266C.title": "Orb of Prophecy"
	"quest.46ACA4593BA65321.quest_desc": ["Craft a Tesla Coil.", "", "&7&oIt charges items set beneath it and stings anything that wanders too close."]
	"quest.46ACA4593BA65321.title": "Tesla Coil"
	"quest.46C728A0D7FBD8AA.quest_desc": ["Craft a 1k and a 4k Storage Cell and a Cell Workbench.", "", "&7&oPartition a cell with the workbench so it takes only what you choose."]
	"quest.46C728A0D7FBD8AA.title": "Storage Cells"
	"quest.46DEC88E694A26C4.quest_desc": ["Build a Terrestrial Agglomeration Plate and make 2 Terrasteel Ingots.", "", "&7&oManasteel, a pearl and a diamond, soaked in half a million mana each."]
	"quest.46DEC88E694A26C4.quest_subtitle": "Hard quest: Golden Bloom Die"
	"quest.46DEC88E694A26C4.title": "Terrasteel"
	"quest.47063CEAB3D4D9E6.quest_desc": ["Build a Crafting Unit, a 4k Crafting Storage and 2 Co-Processing Units.", "", "&7&oUnits must touch to form one CPU; storage sets its size, accelerators its speed."]
	"quest.47063CEAB3D4D9E6.title": "Crafting CPU"
	"quest.471E5A181F389EC5.quest_desc": ["Open the Alfheim Gateway and trade for 8 Elementium Ingots.", "", "&7&oThe elves swap their metal for manasteel, and drive a hard bargain."]
	"quest.471E5A181F389EC5.title": "Elementium"
	"quest.474DBAA98298FB70.quest_desc": ["Craft a Staff of Suppression.", "", "&7&oAnima, heart and obsidian: the same stuff the bosses are made of."]
	"quest.474DBAA98298FB70.title": "Staff of Suppression"
	"quest.4787C2B90395BB17.quest_desc": ["Craft 8 Matrix Frames, a Craft Core, a Pattern Core and a Speed Core.", "", "&7&oOne huge multiblock that crafts many recipes at once."]
	"quest.4787C2B90395BB17.title": "Assembler Matrix"
	"quest.479C87B571265496.quest_desc": ["Craft 4 Gaia Pylons, then defeat the Gaia Guardian. Summoning her needs an active beacon.", "", "&7&oA beacon means a nether star first. Clear the arena and bring your best armour."]
	"quest.479C87B571265496.quest_subtitle": "Hard quest: Golden Bloom Die"
	"quest.479C87B571265496.title": "The Gaia Guardian"
	"quest.47A9FBC14D328717.quest_desc": ["Slay 3 Spiders and collect 8 String.", "", "&7&oThey climb walls and bite at night. Fight them on flat ground."]
	"quest.47A9FBC14D328717.title": "Eight Legs"
	"quest.47D629A0CE87D2F9.quest_desc": ["Upgrade your Novice Spell Book into an Apprentice Spell Book.", "", "&7&oCraft it with diamonds, quartz blocks, blaze rods and obsidian; your glyphs carry over."]
	"quest.47D629A0CE87D2F9.quest_subtitle": "Needs blaze rods from the Nether"
	"quest.47D629A0CE87D2F9.title": "Apprentice Spell Book"
	"quest.481B311AEE84C7C5.quest_desc": ["Craft an Experience Hatch.", "", "&7&oAttach it to a tank to move experience between you and the fluid system."]
	"quest.481B311AEE84C7C5.title": "Experience Hatch"
	"quest.48482FA5B7CD90BD.quest_desc": ["Enter the Bumblezone.", "", "&7&oSticky floors, buzzing air and bees everywhere."]
	"quest.48482FA5B7CD90BD.title": "Down the Honey Hole"
	"quest.486F571D4717661A.quest_desc": ["Slay a Lantern and gather 4 Luminous Jelly.", "", "&7&oSoft lights that drift in the dark. They give up a glowing jelly."]
	"quest.486F571D4717661A.title": "Lights in the Dark"
	"quest.48E2E8DCF4854DFF.quest_desc": ["Find a Cell Maze and a Hive Temple.", "", "&7&oHoneycomb corridors that all look the same."]
	"quest.48E2E8DCF4854DFF.title": "The Cell Maze"
	"quest.490CAC9234F62992.quest_desc": ["Gather 4 Crimson Shards and craft Crimson Bricks.", "", "&7&oShards from crimsonshell squid pack into red bricks."]
	"quest.490CAC9234F62992.title": "Red Shards"
	"quest.491BF54F43AF9C5B.quest_desc": ["Gather 4 Blobfish and bottle some Fish Oil.", "", "&7&oBlobfish live in the deep ocean and are better rendered than eaten."]
	"quest.491BF54F43AF9C5B.title": "Oil from the Deep"
	"quest.49204E2EA8D91E09.quest_desc": ["Defeat a Snowy Creeper in snowy plains.", "", "&7&oYou hear the hiss before you see it."]
	"quest.49204E2EA8D91E09.title": "White on White"
	"quest.496659F619516ADA.quest_desc": ["Upgrade to a Copper Brewing Station at the smithing table, with a Sentry Armour Trim.", "", "&7&oPillager outposts hold the trim. Copper stills turn grain into whiskey."]
	"quest.496659F619516ADA.quest_subtitle": "Needs a Sentry Armour Trim template"
	"quest.496659F619516ADA.title": "Copper Still"
	"quest.498AF34561D1FE6D.quest_desc": ["Ferment Cherry Wine, Noir Wine and Mead.", "", "&7&oCherries, sweet berries and honey each make a different bottle."]
	"quest.498AF34561D1FE6D.title": "A Cellar of Choices"
	"quest.4A002EBBD02F9721.quest_desc": ["Find the Void Blossom, slay it and take a Void Thorn.", "", "&7&oA giant flower in a cave of vines, with petals like blades."]
	"quest.4A002EBBD02F9721.title": "Void Blossom"
	"quest.4A0D558D2BA575EA.quest_desc": ["Craft a Humidity Tank and a Humidity Vent.", "", "&7&oThe tank adds humidity. The vent takes it away again."]
	"quest.4A0D558D2BA575EA.title": "Damp and Dry"
	"quest.4A12831981DF2E9E.quest_desc": ["Craft an Oak Coffin.", "", "&7&oEight planks and a bar of dark iron. The dead deserve some comfort."]
	"quest.4A12831981DF2E9E.title": "A Proper Burial"
	"quest.4A1A6BA4D0D41CAD.quest_desc": ["Infuse a Tiny Potato in a pool and pet it.", "", "&7&oIt does nothing useful, and nobody would part with theirs."]
	"quest.4A1A6BA4D0D41CAD.title": "Tiny Potato"
	"quest.4A1C2096F200F614.quest_desc": ["Visit a crimson forest and a warped forest.", "", "&7&oRed stems and blue stems, and a lot of things that bite."]
	"quest.4A1C2096F200F614.title": "Two Forests of Fungus"
	"quest.4A537662FF823B4D.quest_desc": ["Craft a Blank Build Key and enter your personal space.", "", "&7&oBuild your own dungeon from a clean slate."]
	"quest.4A537662FF823B4D.title": "A Space of Your Own"
	"quest.4A53F9D76631D536.quest_desc": ["Craft 2 Warp Plates.", "", "&7&oTwo plates, one link. Good for bases you visit every day."]
	"quest.4A53F9D76631D536.title": "Warp Plates"
	"quest.4A6EF997A3FAD5FC.quest_desc": ["Make Yeast, 5 Dough and 3 Farmer's Bread.", "", "&7&oYeast ferments in the pot. Dough is mixed in the bowl, then baked."]
	"quest.4A6EF997A3FAD5FC.title": "Daily Bread"
	"quest.4A830905048401F3.quest_desc": ["Assemble a Precision Mechanism with your deployer.", "", "&7&oOn a golden sheet: deploy a cog, a large cog, a nugget. Repeat."]
	"quest.4A830905048401F3.title": "Precision Mechanism"
	"quest.4A9CCFEB66DFCC18.quest_desc": ["Craft 6 Ropes and a Doormat from flax.", "", "&7&oRope hangs, binds and climbs; the mod keeps finding new work for it."]
	"quest.4A9CCFEB66DFCC18.title": "Hold It Together"
	"quest.4AF5EA6C0EFC9B0D.quest_desc": ["Craft a Homeward Pearl.", "", "&7&oA pearl that gets you out of a dungeon alive."]
	"quest.4AF5EA6C0EFC9B0D.title": "Way Back Home"
	"quest.4B0E0EDC12AFD471.quest_desc": ["Finish every other quest in this chapter.", "", "&7&oYou have been to hell and brought back the gold."]
	"quest.4B0E0EDC12AFD471.quest_subtitle": "Chapter reward: Golden Bloom Die"
	"quest.4B0E0EDC12AFD471.title": "The Nether Mastered"
	"quest.4B20E5C3155AF30C.quest_desc": ["Craft a Crafting Bowl and churn 4 Butter.", "", "&7&oMilk becomes butter in the bowl. Flour and yeast become dough."]
	"quest.4B20E5C3155AF30C.title": "Mixing Bowl"
	"quest.4B609624BFA9339B.quest_desc": ["Craft 16 Glass and gather a Water Bucket for a tank.", "", "&7&oA glass tank lets you admire every colour."]
	"quest.4B609624BFA9339B.title": "A Proper Tank"
	"quest.4B818D9A72A003E6.quest_desc": ["Slay a Mutant Enderman.", "", "&7&oIt teleports, throws blocks and leaves clones behind. Fight under open sky."]
	"quest.4B818D9A72A003E6.quest_subtitle": "Hard quest: Starbloom Die"
	"quest.4B818D9A72A003E6.title": "Endersoul"
	"quest.4B84E4C1E66DDB07.quest_desc": ["Craft an Infuser.", "", "&7&oIt purifies the Undergarden's strange crystals."]
	"quest.4B84E4C1E66DDB07.title": "The Infuser"
	"quest.4B9DB8257966B548.quest_desc": ["Craft an Endoflame.", "", "&7&oDrop fuel items beside it and it burns them into mana."]
	"quest.4B9DB8257966B548.title": "Fire in the Petals"
	"quest.4BFF74EE32AF2DD2.quest_desc": ["Craft a Fishing Rod and gather 4 Earthworms for bait.", "", "&7&oA good worm beats a hopeful cast."]
	"quest.4BFF74EE32AF2DD2.title": "Gone Fishing"
	"quest.4C48CE2C21B14FC5.quest_desc": ["Kill 3 Valkyries.", "", "&7&oThey guard the silver dungeons and strike fast. Winners earn Victory Medals."]
	"quest.4C48CE2C21B14FC5.title": "Valkyrie Duels"
	"quest.4C99CB8F223DA173.quest_desc": ["Finish every other quest in this chapter.", "", "&7&oFour seasons, one steady harvest."]
	"quest.4C99CB8F223DA173.quest_subtitle": "Chapter reward: Golden Bloom Die"
	"quest.4C99CB8F223DA173.title": "Ecliptic Seasons Mastered"
	"quest.4CA310637A02667F.quest_desc": ["Find a whale fall on the sea floor.", "", "&7&oA great skeleton settles in the dark, and a whole world gathers around it."]
	"quest.4CA310637A02667F.title": "Whale Fall"
	"quest.4CBEF058720C468C.quest_desc": ["Find the aurora palace and kill the Snow Queen.", "", "&7&oIce crystals, falling shards and a queen who does not melt."]
	"quest.4CBEF058720C468C.quest_subtitle": "Hard quest: Golden Bloom Die"
	"quest.4CBEF058720C468C.title": "The Aurora Palace"
	"quest.4D1F8B9FB82D91A2.quest_desc": ["Craft a Millstone.", "", "&7&oGrain becomes flour, flowers become dye, gravel becomes flint."]
	"quest.4D1F8B9FB82D91A2.title": "Grind It Down"
	"quest.4D2E43C0A944B0A6.quest_desc": ["Defeat a Desert Creeper in a desert.", "", "&7&oIt wears cacti on its back and drops a few when it falls."]
	"quest.4D2E43C0A944B0A6.title": "Dune Blast"
	"quest.4DECD5481F4AF681.quest_desc": ["Craft a Shatterblade.", "", "&7&oDiamond and abyssal amethyst, shaped around an echo of the wrecks."]
	"quest.4DECD5481F4AF681.title": "Shatterblade"
	"quest.4E37B465A0854FA7.quest_desc": ["Craft a Bio Generator and 16 Bio Fuel.", "", "&7&oCrops pressed into fuel keep it running with no mining at all."]
	"quest.4E37B465A0854FA7.title": "Bio Generator"
	"quest.4ED65D6C4972EB28.quest_desc": ["Craft a Basic Energy Cube and an Advanced Energy Cube.", "", "&7&oBig batteries that charge and discharge from any side you configure."]
	"quest.4ED65D6C4972EB28.title": "Energy Cubes"
	"quest.4EEA580C5957EE9A.quest_desc": ["Finish every other quest in this chapter.", "", "&7&oA tool for every job and a metal for every pocket."]
	"quest.4EEA580C5957EE9A.quest_subtitle": "Chapter reward: Moonpetal Die"
	"quest.4EEA580C5957EE9A.title": "Mekanism Tools Mastered"
	"quest.4F4E41D108D30D35.quest_desc": ["Make Pasta with Meatballs from raw pasta, tomato sauce and minced beef.", "", "&7&oTomato sauce simmers in the pot. Beef is minced on the cutting board."]
	"quest.4F4E41D108D30D35.title": "Pasta Night"
	"quest.4F781381C7E588CB.quest_desc": ["Craft a Table, 2 Chairs, 2 Plates and a Table Lamp.", "", "&7&oFloorboards make the furniture. Bricks and white dye make the plates."]
	"quest.4F781381C7E588CB.title": "Dinner by Candlelight"
	"quest.4F7FCB335590539F.quest_desc": ["Hold a naga scale, a raven feather, a pot sherd and amethyst.", "", "&7&oProof you have walked the home ring and the Twilight edge."]
	"quest.4F7FCB335590539F.quest_subtitle": "Hard: Golden Bloom Die. Never takes items"
	"quest.4F7FCB335590539F.title": "Ready to Venture"
	"quest.4F96F02444597AC5.quest_desc": ["Slay 3 Sculk Snappers, 5 Sculk Leeches and 3 Sculk Centipedes.", "", "&7&oThey hunt by sound, so fight quietly."]
	"quest.4F96F02444597AC5.title": "Things That Listen"
	"quest.4FFBF44A526B113D.quest_desc": ["Slay 5 Dwellers and 5 Rotlings.", "", "&7&oDwellers make good steak. Rotlings just make trouble."]
	"quest.4FFBF44A526B113D.title": "Local Wildlife"
	"quest.50004236CB4A568C.quest_desc": ["Find a Saddle and sail out over a deep ocean.", "", "&7&oHullbacks roam the deep oceans; saddle one and its back becomes a deck."]
	"quest.50004236CB4A568C.title": "Ride the Whale"
	"quest.503C7D15304A75B5.quest_desc": ["Craft an Alternator.", "", "&7&oSpin it with a shaft and it produces energy."]
	"quest.503C7D15304A75B5.title": "Rotation to Power"
	"quest.504A35CB9A1390AC.quest_desc": ["Craft an Engineer's Manual and an Engineer's Hammer.", "", "&7&oRight-click a finished structure with the hammer to form a multiblock."]
	"quest.504A35CB9A1390AC.title": "The Engineer's Hammer"
	"quest.504E38A4813114DB.quest_desc": ["Visit a skyroot forest, grove, meadow and woodland.", "", "&7&oEach island has its own trees and its own air."]
	"quest.504E38A4813114DB.title": "Four Groves"
	"quest.509B6AAB49028851.quest_desc": ["Craft Packing Tape and a Paintbrush.", "", "&7&oTape a chest shut and carry it away full. Paint it to match."]
	"quest.509B6AAB49028851.title": "Tape It Up"
	"quest.50ABC4BAE5962F3B.quest_desc": ["Catch 2 Bass or Catfish.", "", "&7&oRivers and wetlands hold fish vanilla never had."]
	"quest.50ABC4BAE5962F3B.title": "Fresh from the Water"
	"quest.50CF18DB9C1A7CE0.quest_desc": ["Roll 16 Copper Wires and wind 4 Copper Spools.", "", "&7&oWire wound round a spool is the heart of every motor."]
	"quest.50CF18DB9C1A7CE0.title": "Copper Spools"
	"quest.50EA49E7E24017C6.quest_desc": ["Finish every other quest in this chapter.", "", "&7&oPower from fire, sky, steam and the atom."]
	"quest.50EA49E7E24017C6.quest_subtitle": "Chapter reward: Moonpetal Die"
	"quest.50EA49E7E24017C6.title": "Generators Mastered"
	"quest.50F879F3B50E79D3.quest_desc": ["Take a photo with your camera.", "", "&7&oHold it up, aim and press the shutter; every shot uses a frame of film."]
	"quest.50F879F3B50E79D3.title": "Say Cheese"
	"quest.513E569ECC42C0C3.quest_desc": ["Find a small hollow hill and walk inside.", "", "&7&oGreen mounds hide caves full of ore, spiders and worse."]
	"quest.513E569ECC42C0C3.title": "Under the Hill"
	"quest.5187EC14C4BEC02E.quest_desc": ["Find deer, then cook 4 Venison on a campfire or in a furnace.", "", "&7&oAntlers and venison are what a deer leaves behind."]
	"quest.5187EC14C4BEC02E.title": "Venison Supper"
	"quest.51B508EE88A7F1D0.quest_desc": ["Craft a Calendar and check which season it is.", "", "&7&oEach season favours different crops, so plan ahead."]
	"quest.51B508EE88A7F1D0.title": "Seasons Where You Are"
	"quest.51D5BC8F5FEC2909.quest_desc": ["Find an Evoker Fort and defeat an Archevoker.", "", "&7&oFangs, vexes and a very bad temper. Bring armour and a shield."]
	"quest.51D5BC8F5FEC2909.title": "The Evoker Fort"
	"quest.51E3B4CA08FB7D37.quest_desc": ["Find an Abandoned Lab and mine its Transmogrifier.", "", "&7&oLabs hide in forests and taigas; the old machine still turns fossils into eggs."]
	"quest.51E3B4CA08FB7D37.title": "The Abandoned Lab"
	"quest.51E5D8CA66205C1C.quest_desc": ["Bind a Book of Binding: Djinni and use it in the ritual for a Soul Gem.", "", "&7&oDiamond, copper, silver and gold, a fragile gem and three soul-fire bases."]
	"quest.51E5D8CA66205C1C.title": "A Soul Gem"
	"quest.51EE95A88203A0E0.quest_desc": ["Craft a Diamond Axe to mark out a screen.", "", "&7&oClick two corners with it, type /display create, then sneak and right-click to add a link."]
	"quest.51EE95A88203A0E0.title": "Mark the Corners"
	"quest.52374E74B7C223A2.quest_desc": ["Brew a Green, Black or Oolong Tea.", "", "&7&oGrow tea from the blossom, dry the leaves, then steep them in the kettle."]
	"quest.52374E74B7C223A2.title": "A Proper Cup"
	"quest.52C9CFC1E280DF8B.quest_desc": ["Find a bastion remnant and kill 2 Piglin Brutes.", "", "&7&oBrutes ignore your gold. The loot is worth the trouble."]
	"quest.52C9CFC1E280DF8B.title": "The Bastion"
	"quest.52CB4D802EDE70B2.quest_desc": ["Finish every other quest in this chapter.", "", "&7&oDishes from every corner of the map, all on one table."]
	"quest.52CB4D802EDE70B2.quest_subtitle": "Chapter reward: Golden Bloom Die"
	"quest.52CB4D802EDE70B2.title": "Cultural Delights Mastered"
	"quest.52DA25465A72DE21.quest_desc": ["Hold fiery blood, a heart of the deep, dragonsteel, resonarium, an orb of prophecy and grapes.", "", "&7&oProof from the Wilds, the deep dark and a dragon's forge."]
	"quest.52DA25465A72DE21.quest_subtitle": "Hard: Starbloom Die. Never takes items"
	"quest.52DA25465A72DE21.title": "Ready for Legend"
	"quest.52DED93432A8D245.quest_desc": ["Gather 2 Ender Pearls and craft a Beehive.", "", "&7&oThrow a pearl at a hive and the world turns to honey."]
	"quest.52DED93432A8D245.title": "Into the Hive"
	"quest.5338EE7D8F1359D1.quest_desc": ["Craft a Refined Obsidian Pickaxe and a full set of Refined Obsidian armour.", "", "&7&oGear that outclasses netherite, if you can afford the ingots."]
	"quest.5338EE7D8F1359D1.title": "Refined Obsidian"
	"quest.53554FA3C61978FD.quest_desc": ["Hold a Bloom Dice and right-click to roll it.", "", "&7&oYour camp chest held three; rolls bring pets, gear and the odd mishap."]
	"quest.53554FA3C61978FD.title": "First Roll"
	"quest.5377F32F3ED1CA88.quest_desc": ["Craft a sword of any kind.", "", "&7&oAny sword will do for now. Stone, iron or something better."]
	"quest.5377F32F3ED1CA88.title": "A Proper Blade"
	"quest.5399AA158B520BB9.quest_desc": ["Kill 2 Endermen, then craft 4 Warp Dust.", "", "&7&oAn ender pearl ground with a shard of amethyst."]
	"quest.5399AA158B520BB9.title": "Pearls and Amethyst"
	"quest.53D7682746A6280A.quest_desc": ["Visit an End city, kill 2 shulkers with a knife and roast their meat.", "", "&7&oOnly a knife takes the meat. It roasts on a campfire, in a smoker or a furnace."]
	"quest.53D7682746A6280A.title": "Shulker Dinner"
	"quest.544552078C058818.quest_desc": ["Craft 2 Quantum Link Chambers, 16 Quantum Rings and 2 Entangled Singularities.", "", "&7&oPaired chambers link two networks across any distance, even dimensions."]
	"quest.544552078C058818.quest_subtitle": "Hard quest: Starbloom Die"
	"quest.544552078C058818.title": "Quantum Bridge"
	"quest.546B2C8D21FFC2BA.quest_desc": ["Find a bakery out in the world.", "", "&7&oSee how the trade is done before you open your own."]
	"quest.546B2C8D21FFC2BA.title": "Visit a Bakery"
	"quest.54AD2D3804179803.quest_desc": ["Craft Earplugs, find a siren island and slay a Siren.", "", "&7&oTheir song draws sailors to the rocks. Earplugs keep your feet on the sand."]
	"quest.54AD2D3804179803.title": "Deaf to the Song"
	"quest.54C49091A83AEB51.quest_desc": ["Craft a Novice Spell Book from a book and iron tools.", "", "&7&oIt already knows a few glyphs, so cast something right away."]
	"quest.54C49091A83AEB51.title": "Novice Spell Book"
	"quest.54F5AE8F32AA2056.quest_desc": ["Find a Wrought Chamber and slay the Ferrous Wroughtnaut.", "", "&7&oDodge the axe, then strike its back while it recovers."]
	"quest.54F5AE8F32AA2056.title": "The Ferrous Wroughtnaut"
	"quest.5516A951823D5CB8.quest_desc": ["Visit the Nether and chisel 8 Polished Cut Scorchia.", "", "&7&oDark volcanic stone, cut to match the rest."]
	"quest.5516A951823D5CB8.title": "Scorched Stone"
	"quest.556DBB20085C70BF.quest_desc": ["Craft 8 White Plastic Blocks and 8 White Transparent Plastic Blocks.", "", "&7&oHDPE and dye make blocks that never fade, in any colour you like."]
	"quest.556DBB20085C70BF.title": "Plastic Blocks"
	"quest.5644BFD1F958873A.quest_desc": ["Craft a Mechanical Chisel from a Chisel and an Andesite Casing.", "", "&7&oThe Create-flavoured chisel for builders who like machines."]
	"quest.5644BFD1F958873A.title": "Chisel by Machine"
	"quest.567F0C7806109974.quest_desc": ["Find an Illager Fort and slay 2 Provokers.", "", "&7&oA walled keep full of angry illagers and better loot."]
	"quest.567F0C7806109974.title": "The Illager Fort"
	"quest.568710424F019BE9.quest_desc": ["Craft 4 Oak Chairs.", "", "&7&oOne craft makes three; keep one for yourself."]
	"quest.568710424F019BE9.title": "Take a Seat"
	"quest.569B073ED714447C.quest_desc": ["Finish every other quest in this chapter.", "", "&7&oPeppers roasted, pancakes stacked and a pot of coffee on."]
	"quest.569B073ED714447C.quest_subtitle": "Chapter reward: Golden Bloom Die"
	"quest.569B073ED714447C.title": "Rustic Delight Mastered"
	"quest.56E0CA908479BD19.quest_desc": ["Craft an ME Controller, an ME Drive and an ME Terminal.", "", "&7&oThe controller powers the network, drives hold cells, terminals open it."]
	"quest.56E0CA908479BD19.title": "ME Network"
	"quest.56E149AD4829D440.quest_desc": ["Find Dodo Island, home of a flightless bird.", "", "&7&oA quiet island, and a very old kind of bird."]
	"quest.56E149AD4829D440.title": "Dodo Island"
	"quest.570A630A9FB7E356.quest_desc": ["Craft a Hallowed Gem.", "", "&7&oDust from a sorcerer, dust from an illusioner, set in amethyst and diamond."]
	"quest.570A630A9FB7E356.title": "Hallowed Gem"
	"quest.5735989FC6007A28.quest_desc": ["Kill 3 Zephyrs and 2 Cockatrices.", "", "&7&oBoth attack from range. Keep moving and keep a shield up."]
	"quest.5735989FC6007A28.title": "Sky Hunters"
	"quest.573F48D2EFB45703.quest_desc": ["Craft a Jukebox and 2 Note Blocks for the foyer.", "", "&7&oMusic for the queue, silence for the film."]
	"quest.573F48D2EFB45703.title": "The Foyer"
	"quest.576B3E6BEBC71AA1.quest_desc": ["Finish every other quest in this chapter.", "", "&7&oA camp with chairs is a home."]
	"quest.576B3E6BEBC71AA1.quest_subtitle": "Chapter reward: Bloom Die"
	"quest.576B3E6BEBC71AA1.title": "Another Furniture Mastered"
	"quest.57CCE6C367B8C860.quest_desc": ["Craft 4 Grapevine Stems and a Grapevine Pot.", "", "&7&oStems and lattices give the vines something to grow on."]
	"quest.57CCE6C367B8C860.title": "Something to Climb"
	"quest.57D4FDB05F78DC83.quest_desc": ["Slay the Ender Dragon.", "", "&7&oBreak the crystals first. Its death opens the gateways to the outer End."]
	"quest.57D4FDB05F78DC83.quest_subtitle": "Hard quest: Elderheart Die"
	"quest.57D4FDB05F78DC83.title": "Slay the Dragon"
	"quest.580D85390D22ED42.quest_desc": ["Enter the catacombs and defeat the Dead King.", "", "&7&oThe old ruler still sits on his throne, and he still does not want visitors."]
	"quest.580D85390D22ED42.quest_subtitle": "Hard quest: Moonpetal Die"
	"quest.580D85390D22ED42.title": "The Dead King"
	"quest.583D420A8EB3CC4D.quest_desc": ["Craft 4 End Crystals and gather 7 Obsidian.", "", "&7&oA pillar three high, an obsidian block a step from each face, a crystal on each."]
	"quest.583D420A8EB3CC4D.title": "The Altar"
	"quest.58B2A9DC83A60B53.quest_desc": ["Gather 16 Black Concrete for a screen wall.", "", "&7&oDream Displays builds its screens on black concrete, its slabs or its stairs."]
	"quest.58B2A9DC83A60B53.title": "Movie Night"
	"quest.58B5AB9B543A7F66.quest_desc": ["Finish every other quest in this chapter.", "", "&7&oBarrels rolling, mugs raised and the last round is on you."]
	"quest.58B5AB9B543A7F66.quest_subtitle": "Chapter reward: Golden Bloom Die"
	"quest.58B5AB9B543A7F66.title": "Brewery Mastered"
	"quest.58D536ABDA04E993.quest_desc": ["Cook a Stuffed Cod and a Stuffed Squid.", "", "&7&oKelp, onion, tomato and rope go into the cod. Rice goes into the squid."]
	"quest.58D536ABDA04E993.title": "Stuffed Catch"
	"quest.59B98F6FE3629C74.quest_desc": ["Tame a Bald Eagle with Fish Oil.", "", "&7&oEagles hunt over wooded mountains and lakes; only Fish Oil wins them over."]
	"quest.59B98F6FE3629C74.title": "Eagle Eyes"
	"quest.59E28BE0F99133A7.quest_desc": ["Finish every other quest in this chapter.", "", "&7&oBright, colourful and a little bit explosive."]
	"quest.59E28BE0F99133A7.quest_subtitle": "Chapter reward: Moonpetal Die"
	"quest.59E28BE0F99133A7.title": "Additions Mastered"
	"quest.59EEE108AC48C09A.quest_desc": ["Craft a Windmill and place it.", "", "&7&oGive the sails room to turn and the wind works for free."]
	"quest.59EEE108AC48C09A.title": "Catch the Wind"
	"quest.5A38BBF5B8EC6C10.quest_desc": ["Defeat a Wilden Chimera, then upgrade to the Archmage Spell Book. It needs a nether star.", "", "&7&oThe chimera's tribute, a totem, emeralds and pearls complete the recipe."]
	"quest.5A38BBF5B8EC6C10.quest_subtitle": "Hard quest: Golden Bloom Die"
	"quest.5A38BBF5B8EC6C10.title": "Archmage Spell Book"
	"quest.5A91B0BA9C3C0EA7.quest_desc": ["Smelt iesnium ore, then craft an Iesnium Pickaxe and keep 1 Iesnium Ingot.", "", "&7&oThe dictionary tells you how to see the ore and which pick can mine it."]
	"quest.5A91B0BA9C3C0EA7.quest_subtitle": "Iesnium ore is found in the Nether"
	"quest.5A91B0BA9C3C0EA7.title": "Iesnium Pickaxe"
	"quest.5A91F78E46055954.quest_desc": ["Slay 2 Anglerfish and collect 4 Fins and 2 Angler Fangs.", "", "&7&oCold-water predators that hunt by a lure of living light."]
	"quest.5A91F78E46055954.title": "Fin and Fang"
	"quest.5AA7957E99364048.quest_desc": ["Craft a Food Book.", "", "&7&oThe book tracks every dish you have tried. Repeats do not count."]
	"quest.5AA7957E99364048.title": "A Food Diary"
	"quest.5AC20ED0D05A3A4B.quest_desc": ["Finish every other quest in this chapter.", "", "&7&oWires humming, wheels digging, steel pouring."]
	"quest.5AC20ED0D05A3A4B.quest_subtitle": "Chapter reward: Golden Bloom Die"
	"quest.5AC20ED0D05A3A4B.title": "Immersive Engineering Mastered"
	"quest.5AD080A644BEDA79.quest_desc": ["Craft a pair of Golden Boots.", "", "&7&oPiglins ignore anyone wearing a piece of gold armour."]
	"quest.5AD080A644BEDA79.title": "Gold Brings Peace"
	"quest.5B19607F4B184258.quest_desc": ["Craft a Diving Weight and descend into a trench.", "", "&7&oDead weight keeps a diver on the sea floor."]
	"quest.5B19607F4B184258.title": "Sink Like a Stone"
	"quest.5B27374C5FB32B6F.quest_desc": ["Craft 6 Framed Slopes and 6 Framed Panels.", "", "&7&oRoofs, ramps and thin walls, all in whatever texture you like."]
	"quest.5B27374C5FB32B6F.title": "Slopes and Panels"
	"quest.5B39FCCD4ACA737E.quest_desc": ["Find a flower forest and shear a Moobloom, then keep 2 Buttercups.", "", "&7&oMooblooms carry a garden on their backs, and shears bring the flowers down."]
	"quest.5B39FCCD4ACA737E.title": "Old Friends"
	"quest.5B44FAB83F84AB17.quest_desc": ["Craft an Alchemist Table from glass and cobbled deepslate.", "", "&7&oGive a villager a place to brew."]
	"quest.5B44FAB83F84AB17.title": "Brewer on Call"
	"quest.5B76C2CB965DC468.quest_desc": ["Craft a Wine Box and an Oak Wine Rack.", "", "&7&oBottles keep best on their side, out of the light."]
	"quest.5B76C2CB965DC468.title": "Wine Storage"
	"quest.5B794983E126F043.quest_desc": ["Find an altar camp.", "", "&7&oSomeone climbed here before you and left a chest behind."]
	"quest.5B794983E126F043.title": "The Altar Camp"
	"quest.5B7A57F1789423EA.quest_desc": ["Gather 8 Sunflower Seeds in a sunflower plains.", "", "&7&oA pocketful of seeds is all it takes to make a friend."]
	"quest.5B7A57F1789423EA.title": "A Tiny Friend"
	"quest.5B84EE9633D94430.quest_desc": ["Find a warm ocean ruin and catch an Ancientscale.", "", "&7&oAncient fish keep to ancient stones."]
	"quest.5B84EE9633D94430.title": "Ancient Scales"
	"quest.5BCE7CDC0C975606.quest_desc": ["Craft a Capture Net from 3 Bamboo and 3 String, then visit a forest.", "", "&7&oNaturalist fills the overworld with animals vanilla never had."]
	"quest.5BCE7CDC0C975606.title": "Wildlife Near Home"
	"quest.5C0B5C11D4C1958A.quest_desc": ["Chisel 16 Polished Cut Andesite and 16 Small Andesite Bricks.", "", "&7&oNeighbouring blocks join up into one clean surface."]
	"quest.5C0B5C11D4C1958A.title": "Cut and Connected"
	"quest.5C5B8AF67587ABEF.quest_desc": ["Craft 12 Reactor Casings, 2 Reactor Ports, 2 Fuel Assemblies and a Control Rod Assembly.", "", "&7&oFuel, coolant and a control rod: get the heat balance wrong and it melts down."]
	"quest.5C5B8AF67587ABEF.quest_subtitle": "Hard quest: Starbloom Die"
	"quest.5C5B8AF67587ABEF.title": "Fission Reactor"
	"quest.5C724E7BD9679516.quest_desc": ["Craft a Sophisticated Chest from 8 planks and a lever.", "", "&7&oIt looks like a chest, but it takes upgrades."]
	"quest.5C724E7BD9679516.title": "A Better Chest"
	"quest.5CB9661CEFD6AAC1.quest_desc": ["Craft a Storage Terminal.", "", "&7&oOne screen for every chest it touches."]
	"quest.5CB9661CEFD6AAC1.title": "Storage Terminal"
	"quest.5CE90B6DB468C97E.quest_desc": ["Find a Mausoleum and slay 5 Dread Thralls.", "", "&7&oCold stone, cold air and the dead who walk without rest."]
	"quest.5CE90B6DB468C97E.title": "Dreadstone Halls"
	"quest.5CF3ED015156C9AD.quest_desc": ["Craft a Cutting Board and use a knife on it.", "", "&7&oPut an item on the board, then cut it with the right tool."]
	"quest.5CF3ED015156C9AD.title": "Cutting Board"
	"quest.5D1027B6A57DA9C7.quest_desc": ["Craft a Diving Helmet, Diving Suit and Diving Boots from copper, glass and leather.", "", "&7&oCopper and leather let you stay down longer."]
	"quest.5D1027B6A57DA9C7.title": "Dive Gear"
	"quest.5D1D826E30CC185C.quest_desc": ["Fry 2 Eggs and cook 2 Bacon.", "", "&7&oCut raw pork into bacon on your board, then cook both over a fire."]
	"quest.5D1D826E30CC185C.title": "Bacon and Eggs"
	"quest.5D279D92676ACE30.quest_desc": ["Craft a Hygrometer and a Season Sensor.", "", "&7&oOne reads humidity, the other turns the season into a redstone signal."]
	"quest.5D279D92676ACE30.title": "Reading the Weather"
	"quest.5D57E8497352E916.quest_desc": ["Craft a Brewing Stand, gather 4 Nether Wart and brew a potion.", "", "&7&oWart grows in fortress soul sand."]
	"quest.5D57E8497352E916.title": "Brewing in the Dark"
	"quest.5D5E862E28DD3C77.quest_desc": ["Forge 2 Fiery Ingots from fiery blood and iron.", "", "&7&oA metal that burns whatever it hits."]
	"quest.5D5E862E28DD3C77.title": "Fiery Metal"
	"quest.5DBE221F6EC94C0C.quest_desc": ["Craft a Spatial IO Port, 8 Spatial Pylons and the smallest Spatial Storage Cell.", "", "&7&oPack a whole room into a cell, then unpack it somewhere else."]
	"quest.5DBE221F6EC94C0C.quest_subtitle": "Hard quest: Starbloom Die"
	"quest.5DBE221F6EC94C0C.title": "Spatial Storage"
	"quest.5DC260F38BC36E43.quest_desc": ["Brew a Lavender or Hibiscus Tea.", "", "&7&oBlossoms and a spoon of sugar. It steeps slowly."]
	"quest.5DC260F38BC36E43.title": "Flower Tea"
	"quest.5E3EA87B4284DB58.quest_desc": ["Find a quest grove and finish the Quest Ram's task.", "", "&7&oDye wool for a sheep that wants every colour."]
	"quest.5E3EA87B4284DB58.title": "The Quest Grove"
	"quest.5E4751E73E56EDA5.quest_desc": ["Finish every other quest in this chapter.", "", "&7&oEvery good day is worth a picture."]
	"quest.5E4751E73E56EDA5.quest_subtitle": "Chapter reward: Bloom Die"
	"quest.5E4751E73E56EDA5.title": "Exposure Mastered"
	"quest.5EA7BEDF829B1A1F.quest_desc": ["Finish every other quest in this chapter.", "", "&7&oPipes, plates and walkways, as grimy as you like."]
	"quest.5EA7BEDF829B1A1F.quest_subtitle": "Chapter reward: Golden Bloom Die"
	"quest.5EA7BEDF829B1A1F.title": "Create Deco Mastered"
	"quest.5EB5C7187C97C10D.quest_desc": ["Find an Archwood Forest and gather 8 Archwood Logs and 4 Magebloom.", "", "&7&oArchwood is the timber of every Ars machine, and magebloom its thread."]
	"quest.5EB5C7187C97C10D.title": "Into the Archwood"
	"quest.5ECB645CC063FF37.quest_desc": ["Make 4 Advanced Control Circuits and an Advanced Tier Installer.", "", "&7&oInstallers upgrade a machine or cube to the next tier in place."]
	"quest.5ECB645CC063FF37.title": "Advanced Tier"
	"quest.5F3B7B2B76470919.quest_desc": ["Craft a Mechanical Mixer and a Basin.", "", "&7&oSet a basin under the mixer and shapeless recipes craft themselves."]
	"quest.5F3B7B2B76470919.title": "Mix It Up"
	"quest.5F43ECCEF4329EB5.quest_desc": ["Find your way into the Twilight Forest.", "", "&7&oA small pool ringed with flowers, a diamond thrown in, then a crack of lightning."]
	"quest.5F43ECCEF4329EB5.title": "A Ring of Flowers"
	"quest.5F4BF14D7DD24435.quest_desc": ["Kill 3 Cows and cook 6 Steaks.", "", "&7&oHunger comes quickly once you start walking."]
	"quest.5F4BF14D7DD24435.title": "Fill the Larder"
	"quest.5F4E73EA8F81BD64.quest_desc": ["Craft a Walkie-Talkie and an Obsidian TNT.", "", "&7&oTalk on a shared channel, then blow up something built to last."]
	"quest.5F4E73EA8F81BD64.title": "Gadgets and Bangs"
	"quest.5F61E43D0AE34CAE.quest_desc": ["Find an Ancient City and bring back 4 Echo Shards.", "", "&7&oMove slowly; the sculk hears every footstep, and so does what it calls."]
	"quest.5F61E43D0AE34CAE.title": "Silence, Please"
	"quest.5F7ADE8BE9168A86.quest_desc": ["Craft a Wooden Crank and charge 4 Certus Quartz Crystals.", "", "&7&oA crank beside the Charger powers it by hand."]
	"quest.5F7ADE8BE9168A86.title": "Charged Quartz"
	"quest.5F9E1434E0B1CCAA.quest_desc": ["Enter the Undergarden.", "", "&7&oNo sun down here, only smog."]
	"quest.5F9E1434E0B1CCAA.title": "Down the Hole"
	"quest.5FA156CC78993389.quest_desc": ["Finish every other quest in this chapter.", "", "&7&oGolden crusts, soft crumb and a cooling rack that never empties."]
	"quest.5FA156CC78993389.quest_subtitle": "Chapter reward: Bloom Die"
	"quest.5FA156CC78993389.title": "Bakery Mastered"
	"quest.5FA1945CD49D73F5.quest_desc": ["Reach the Permafrost Peaks and gather 8 Glacite Shards.", "", "&7&oCold enough to freeze starlight."]
	"quest.5FA1945CD49D73F5.title": "Under the Permafrost"
	"quest.5FD0E3B0DF722299.quest_desc": ["Craft and bind a Book of Binding: Foliot, then use it in a ritual for a Fragile Soul Gem.", "", "&7&oAn iron ingot, an egg and a glass block, offered in the circle."]
	"quest.5FD0E3B0DF722299.title": "Your First Ritual"
	"quest.5FDA99146BBE029E.quest_desc": ["Craft 3 White Lamps and 3 White Curtains.", "", "&7&oWool shades for the torch, wool drapes for the window."]
	"quest.5FDA99146BBE029E.title": "Soft Glow"
	"quest.5FDB07BA9919D025.quest_desc": ["Craft a Fossilized Skull Lamp from a Fossilized Skull and a Lantern.", "", "&7&oLabs keep a skull or two among their bones."]
	"quest.5FDB07BA9919D025.title": "A Grinning Lamp"
	"quest.5FEA0C85DA404730.quest_desc": ["Craft an Iron Axe.", "", "&7&oAn axe hits hard and can knock a shield out of play."]
	"quest.5FEA0C85DA404730.title": "Breaking Guard"
	"quest.6004EAAEE65A0A27.quest_desc": ["Finish every other quest in this chapter.", "", "&7&oPack light, carry everything."]
	"quest.6004EAAEE65A0A27.quest_subtitle": "Chapter reward: Bloom Die"
	"quest.6004EAAEE65A0A27.title": "Sophisticated Backpacks Mastered"
	"quest.603C91C1E2BA4D60.quest_desc": ["Craft 4 Molecular Assemblers and 2 Acceleration Cards.", "", "&7&oPut assemblers beside a provider; acceleration cards make them work faster."]
	"quest.603C91C1E2BA4D60.title": "Molecular Assemblers"
	"quest.6089A2E1DEE1CC11.quest_desc": ["Slay a Foliaath and collect 2 Foliaath Seeds.", "", "&7&oA man-eating plant that bites anything near its roots."]
	"quest.6089A2E1DEE1CC11.title": "Hungry Roots"
	"quest.60F469CE69CE4610.quest_desc": ["Craft a Container of Greenhouse Core, then a Greenhouse Core for any season.", "", "&7&oA core inside a glass house keeps one season for the crops below."]
	"quest.60F469CE69CE4610.title": "Greenhouse"
	"quest.6104B82521AB0E70.quest_desc": ["Find a shipwreck and recover a Sail.", "", "&7&oShipwrecks, ocean ruins and buried treasure hold sails, masts and anchors."]
	"quest.6104B82521AB0E70.title": "Salvage"
	"quest.611E368A96653F79.quest_desc": ["Slay the Ender Dragon and bring home a Dragon Leg and a Dragon Tooth.", "", "&7&oThe leg is smoked for a feast. The tooth becomes a knife."]
	"quest.611E368A96653F79.title": "Dragon Dinner"
	"quest.6138EB8AB5328F3C.quest_desc": ["Craft a Blowgun and 8 Darts.", "", "&7&oBamboo, string and a fang for the tips."]
	"quest.6138EB8AB5328F3C.title": "Silent Hunter"
	"quest.615F77EBE687CE70.quest_desc": ["Ferment 2 bottles of Apple Wine from your juice.", "", "&7&oLighter than grape wine, and nobody minds."]
	"quest.615F77EBE687CE70.title": "Apple Wine"
	"quest.61687FD19516FF8D.quest_desc": ["Chisel 4 Amethyst Blocks into Amethyst Bricks and a Gold Block into its polished form.", "", "&7&oTreasure blocks, dressed for show."]
	"quest.61687FD19516FF8D.title": "Polished Gleam"
	"quest.61A80CAA3FAAC1A8.quest_desc": ["Make 8 Steel Plates and 4 Steel Mechanical Components.", "", "&7&oHammer an ingot flat, then build the parts the big machines need."]
	"quest.61A80CAA3FAAC1A8.title": "Steel Plates"
	"quest.61E040F0B872F107.quest_desc": ["Print a Photograph in the Lightroom.", "", "&7&oDeveloped film and paper go in; a real photo comes out to hold, trade or display."]
	"quest.61E040F0B872F107.title": "Hang It Up"
	"quest.61E622A7E555D38C.quest_desc": ["Craft a feast such as Roast Chicken or Shepherd's Pie, then place it.", "", "&7&oOne feast feeds a whole table. Serve each portion with a bowl."]
	"quest.61E622A7E555D38C.title": "Set the Table"
	"quest.6222553ADA76CCB5.quest_desc": ["Machines, storage and automation, one chapter per mod."]
	"quest.6222553ADA76CCB5.title": "Tech"
	"quest.627915B178219379.quest_desc": ["Craft a Tag Export Bus, a Mod Storage Bus and a Precise Export Bus.", "", "&7&oFilter by tag, by mod or by exact count instead of one item at a time."]
	"quest.627915B178219379.title": "Smarter Buses"
	"quest.62962A9D798577F9.quest_desc": ["Craft a Randomizer Tool.", "", "&7&oFill it with blocks and each placement picks one at random."]
	"quest.62962A9D798577F9.title": "Build in Bulk"
	"quest.62A28C940C2C630B.quest_desc": ["Craft a Dragonforge Core, an Aperture and 8 Bricks.", "", "&7&oFire, ice or lightning: each forge only works the metal of its own dragon."]
	"quest.62A28C940C2C630B.title": "The Dragonforge"
	"quest.62C598550CFEC72B.quest_desc": ["Make Batter, cook a stack of Pancakes and cut 2 Pancakes from it.", "", "&7&oSyrup and sugar go on top before the stack leaves the pot."]
	"quest.62C598550CFEC72B.title": "Pancake Stack"
	"quest.62D028211F24BA2D.quest_desc": ["Catch a blaze with an Empty Blaze Burner.", "", "&7&oBring it home from the Nether and it heats your basins for good."]
	"quest.62D028211F24BA2D.quest_subtitle": "Needs a Nether fortress"
	"quest.62D028211F24BA2D.title": "Blaze in a Cage"
	"quest.62E428D313780B27.quest_desc": ["Find a pillager outpost and kill 8 Pillagers.", "", "&7&oBring a shield, a bow and a plan. Crossbow bolts hurt."]
	"quest.62E428D313780B27.quest_subtitle": "Hard quest: Golden Bloom Die"
	"quest.62E428D313780B27.title": "Break the Outpost"
	"quest.63029E78F06EE74C.quest_desc": ["Throw a diamond into spirit fire to make a Spirit Attuned Gem.", "", "&7&oThe dictionary explains how to light it. Offerings come out changed."]
	"quest.63029E78F06EE74C.title": "Spirit Fire"
	"quest.6350DEF9368E5756.quest_desc": ["Find a Crypt underground and slay 2 Revenants out in the snow.", "", "&7&oCrypts hide in the caves. Revenants walk the snowy plains above."]
	"quest.6350DEF9368E5756.title": "Into the Crypt"
	"quest.639C6E96AC0422C0.quest_desc": ["Craft 4 Resizeable Oak Windows and 3 Oak Shutters.", "", "&7&oWindows grow to fit the wall; shutters swing beside them."]
	"quest.639C6E96AC0422C0.title": "Windows"
	"quest.64471407537D9107.quest_desc": ["Craft a Crocodile Chestplate from 8 Crocodile Scutes.", "", "&7&oScutes from a crocodile make tough armour."]
	"quest.64471407537D9107.title": "Scaled Armour"
	"quest.649F863B410250A3.quest_desc": ["Assemble an Extended Pattern Provider, an Extended Interface and an Extended Molecular Assembler.", "", "&7&oEach one does the work of several, and each needs Concurrent Processors."]
	"quest.649F863B410250A3.title": "Bigger Networks"
	"quest.64B47715B301E0F8.quest_desc": ["Craft 4 End Crystals.", "", "&7&oFour of them on the exit portal will bring the dragon back."]
	"quest.64B47715B301E0F8.title": "Crystal Clear"
	"quest.64B83C4BE3264E02.quest_desc": ["Slay 2 Acolytes and collect 2 Diary Pages.", "", "&7&oSomeone wrote down what happened here. The acolytes kept the pages."]
	"quest.64B83C4BE3264E02.title": "Pages of a Diary"
	"quest.64C4610D88700B51.quest_desc": ["Finish every other quest in this chapter.", "", "&7&oThe dead rest easy, for now."]
	"quest.64C4610D88700B51.quest_subtitle": "Chapter reward: Golden Bloom Die"
	"quest.64C4610D88700B51.title": "The Graveyard Mastered"
	"quest.64DD289F473441F9.quest_desc": ["Finish every other quest in this chapter.", "", "&7&oThe forest keeps its dusk, but its bosses are gone."]
	"quest.64DD289F473441F9.quest_subtitle": "Chapter reward: Bloom Die"
	"quest.64DD289F473441F9.title": "Twilight Mastered"
	"quest.65507B76E297CCD3.quest_desc": ["Find the knight stronghold and kill all 6 Knight Phantoms.", "", "&7&oArmoured ghosts guard a vault of old steel."]
	"quest.65507B76E297CCD3.quest_subtitle": "Late game: well past Settle gear"
	"quest.65507B76E297CCD3.title": "The Phantom Stronghold"
	"quest.6555D737AE7EB1CE.quest_desc": ["Visit an aerglow forest and the golden grove.", "", "&7&oThe Aether grows stranger and brighter the further you go."]
	"quest.6555D737AE7EB1CE.title": "The Deeper Sky"
	"quest.65AB2302918B1781.quest_desc": ["Finish every other quest in this chapter.", "", "&7&oWings in every colour, all of them in the book."]
	"quest.65AB2302918B1781.quest_subtitle": "Chapter reward: Bloom Die"
	"quest.65AB2302918B1781.title": "Butterflies Mastered"
	"quest.65B7FF2BA15E8989.quest_desc": ["Find a yeti cave and kill the Alpha Yeti.", "", "&7&oCold fur, loud roar and a very bad temper."]
	"quest.65B7FF2BA15E8989.quest_subtitle": "Late game: well past Settle gear"
	"quest.65B7FF2BA15E8989.title": "The Yeti Cave"
	"quest.65B94BE7E7C91DD1.quest_desc": ["Craft 2 Shulker Boxes.", "", "&7&oStorage that follows you home."]
	"quest.65B94BE7E7C91DD1.title": "Pocket Dimensions"
	"quest.65F9B1DB4726A925.quest_desc": ["Craft a Maraca from a Rattlesnake Rattle.", "", "&7&oDesert snakes leave a noisy souvenir."]
	"quest.65F9B1DB4726A925.title": "Sand and Scales"
	"quest.662EFB33308EAE0A.quest_desc": ["Craft a Printer.", "", "&7&oCopies enchanted books, paid for in liquid experience."]
	"quest.662EFB33308EAE0A.title": "The Printer"
	"quest.6659DF2B54BA991F.quest_desc": ["Harvest 4 Cotton and weave it into String.", "", "&7&oCotton grows as a crop here and turns into string."]
	"quest.6659DF2B54BA991F.title": "Cotton Fields"
	"quest.667BB8ADB58469F0.quest_desc": ["Craft 4 Lanterns and 4 Chains.", "", "&7&oLanterns now sit on the side of a wall as well as hang from a chain."]
	"quest.667BB8ADB58469F0.title": "Little Fixes"
	"quest.667BBB490A88C068.quest_desc": ["Craft a Mechanical Grindstone and collect 9 Experience Nuggets.", "", "&7&oCrushed ores drop nuggets. Grind one and it turns to liquid experience."]
	"quest.667BBB490A88C068.title": "Liquid Experience"
	"quest.66A82D559E4EA29A.quest_desc": ["Tame a Shellback.", "", "&7&oNot everything in the cold sea wants to eat you."]
	"quest.66A82D559E4EA29A.title": "A Friend in the Cold"
	"quest.66FF10B05C733365.quest_desc": ["Craft a Cloggrum Pickaxe and a Cloggrum Sword.", "", "&7&oPlain, tough and a little ugly."]
	"quest.66FF10B05C733365.title": "Cloggrum Tools"
	"quest.675B411582B51321.quest_desc": ["Gather 4 Amethyst Shards and craft a Spyglass.", "", "&7&oBelow ground the stone turns smooth, then purple. Bring a light."]
	"quest.675B411582B51321.title": "Purple Glow"
	"quest.67874103180469CD.quest_desc": ["Find a Murk in a warm ocean and defeat it.", "", "&7&oIt lurks in warm, cloudy water."]
	"quest.67874103180469CD.title": "Murky Waters"
	"quest.679152CFF59CA523.quest_desc": ["Craft a Lepidoptera Feeder from iron, bamboo and string.", "", "&7&oStock it with food and butterflies will linger round it."]
	"quest.679152CFF59CA523.title": "Open House"
	"quest.67A63FF942E0269C.quest_desc": ["Craft an Oven and pick 4 Corn Cobs.", "", "&7&oThe Oven bakes what the pot cannot: pies, loaves and roasts."]
	"quest.67A63FF942E0269C.title": "Far-Away Dishes"
	"quest.67B32BBE9A6BFF94.quest_desc": ["Finish every other quest in this chapter.", "", "&7&oEvery new trade has a table and a villager behind it."]
	"quest.67B32BBE9A6BFF94.quest_subtitle": "Chapter reward: Bloom Die"
	"quest.67B32BBE9A6BFF94.title": "VillagersPlus Mastered"
	"quest.67B55C310495230E.quest_desc": ["Upgrade to an Iron Backpack.", "", "&7&oBigger again, with room for the upgrades that matter."]
	"quest.67B55C310495230E.title": "Iron Backpack"
	"quest.67BB96661972C411.quest_desc": ["Mine 4 Ancient Debris and smelt them into 4 Netherite Scrap.", "", "&7&oIt hides low in the Nether, and beds blow it open fast."]
	"quest.67BB96661972C411.title": "Ancient Debris"
	"quest.67BDD7037FED5301.quest_desc": ["Roast a Fillet Steak with beef, butter and a splash of wine.", "", "&7&oThe roaster does the work. Serve it under a cloche."]
	"quest.67BDD7037FED5301.title": "Main Course"
	"quest.67D5474B9BB88FF3.quest_desc": ["Enter a dungeon.", "", "&7&oEvery key leads to its own dungeon, and every dungeon to better keys."]
	"quest.67D5474B9BB88FF3.title": "Into the Dungeon"
	"quest.6816A4A1F65EF123.quest_desc": ["Craft a Crafting Upgrade.", "", "&7&oA crafting grid inside the pack, wherever you are."]
	"quest.6816A4A1F65EF123.title": "Workbench on Your Back"
	"quest.688E0DA277A79470.quest_desc": ["Collect 8 dyes of any colour.", "", "&7&oDrop dye into a cauldron of water to tint it."]
	"quest.688E0DA277A79470.title": "Tint the Water"
	"quest.689895D547493F40.quest_desc": ["Craft a Lightroom and develop a roll of film.", "", "&7&oCraft shot film with a water bottle for black and white; colour wants three potions."]
	"quest.689895D547493F40.title": "Darkroom"
	"quest.68A64B5B1712938F.quest_desc": ["Craft 3 Andesite Doors and 4 Andesite Windows.", "", "&7&oMetal frames for a workshop that means business."]
	"quest.68A64B5B1712938F.title": "Doors and Windows"
	"quest.68B9982D8F482A26.quest_desc": ["Age a Cheese Wheel in the vat and cut 4 Cheese Wedges.", "", "&7&oMilk, a mushroom and salt, then a long wait."]
	"quest.68B9982D8F482A26.title": "Say Cheese"
	"quest.68EA80EA3CADD9AE.quest_desc": ["Finish every other quest in this chapter.", "", "&7&oRows of vines, a full cellar and a barrel with your name on it."]
	"quest.68EA80EA3CADD9AE.quest_subtitle": "Chapter reward: Golden Bloom Die"
	"quest.68EA80EA3CADD9AE.title": "Vinery Mastered"
	"quest.690715432990E081.quest_desc": ["Craft an Atomic Disassembler.", "", "&7&oIts Vein mode mines a whole ore deposit in one stroke."]
	"quest.690715432990E081.title": "Atomic Disassembler"
	"quest.690C4A208E7DD85D.quest_desc": ["Craft 3 Oak Flower Boxes and 4 Oak Shutters.", "", "&7&oFlowers under the sill and shutters either side of the window."]
	"quest.690C4A208E7DD85D.title": "Window Garden"
	"quest.69352FBD966D6186.quest_desc": ["Craft a Fireproof Butterfly Net from a net and magma cream.", "", "&7&oLava moths burn straight through an ordinary net."]
	"quest.69352FBD966D6186.quest_subtitle": "Magma cream comes from the Nether"
	"quest.69352FBD966D6186.title": "Lava Wings"
	"quest.6981EACCD86A1851.quest_desc": ["Reach an Umvuthana Grove, slay Umvuthi and take his Sol Visage.", "", "&7&oHe calls down sunstrikes and beams of light. Keep moving."]
	"quest.6981EACCD86A1851.quest_subtitle": "Hard quest: Moonpetal Die"
	"quest.6981EACCD86A1851.title": "Umvuthi, the Sunbird"
	"quest.69970C18A35E9935.quest_desc": ["Finish every other quest in this chapter.", "", "&7&oA full table, warm light and good company."]
	"quest.69970C18A35E9935.quest_subtitle": "Chapter reward: Golden Bloom Die"
	"quest.69970C18A35E9935.title": "Candlelight Mastered"
	"quest.69E12632F0254187.quest_desc": ["Craft an Experience Lantern from an Experience Block, a Sponge and a Copper Casing.", "", "&7&oA warm green light built around a block of solid experience."]
	"quest.69E12632F0254187.title": "Experience Lantern"
	"quest.6AE57DC4E9DC1DFA.quest_desc": ["Craft an Arcane Anvil.", "", "&7&oIt merges spell gear and imbues weapons with magic."]
	"quest.6AE57DC4E9DC1DFA.title": "Arcane Anvil"
	"quest.6AECE7CA2C217DAB.quest_desc": ["Slay the Starlight Golem.", "", "&7&oGuardian of the forge, still burning with old light."]
	"quest.6AECE7CA2C217DAB.quest_subtitle": "Hard quest: Starbloom Die"
	"quest.6AECE7CA2C217DAB.title": "The Starlight Golem"
	"quest.6B1D784A75CB9AC8.quest_desc": ["Craft a Wireless Terminal.", "", "&7&oLink it to a terminal and open your storage from afar."]
	"quest.6B1D784A75CB9AC8.title": "Storage on the Move"
	"quest.6B2A9FDF0087E1CA.quest_desc": ["Defeat 2 Baby Skeletons.", "", "&7&oSmall, quick and just as dangerous as the grown ones."]
	"quest.6B2A9FDF0087E1CA.title": "Little Terrors"
	"quest.6B8090DD96F94400.quest_desc": ["Light a portal and enter the Nether.", "", "&7&oWater boils away here. Bring fire resistance and a spare flint and steel."]
	"quest.6B8090DD96F94400.title": "Into the Heat"
	"quest.6B81CDB348F32F1E.quest_desc": ["Mix 8 Brass Ingots in a heated basin.", "", "&7&oCopper and zinc, melted together over a caged blaze."]
	"quest.6B81CDB348F32F1E.quest_subtitle": "Hard quest: Golden Bloom Die"
	"quest.6B81CDB348F32F1E.title": "Brass and Blaze"
	"quest.6BBA67793AFC143F.quest_desc": ["Craft a Waystone.", "", "&7&oVillages keep them. Set one down at camp and it remembers you."]
	"quest.6BBA67793AFC143F.title": "Stones That Remember"
	"quest.6BD8197E86042655.quest_desc": ["Finish every other quest in this chapter.", "", "&7&oRoll, bloom, repeat."]
	"quest.6BD8197E86042655.quest_subtitle": "Chapter reward: Bloom Die"
	"quest.6BD8197E86042655.title": "Bloom Dice Mastered"
	"quest.6BF432EE505B1B90.quest_desc": ["Find an Advanced Key.", "", "&7&oHarder dungeons, better loot."]
	"quest.6BF432EE505B1B90.title": "Advanced Key"
	"quest.6C17C9281C2BE470.quest_desc": ["Craft a Windmill Bearing and 8 Sail Frames.", "", "&7&oMore sails, more speed and more stress capacity."]
	"quest.6C17C9281C2BE470.title": "Catch the Wind"
	"quest.6C68540E6FF242BE.quest_desc": ["Craft a Zanite Ring and a Zanite Pendant.", "", "&7&oWear them in accessory slots for a quiet edge in every fight."]
	"quest.6C68540E6FF242BE.title": "Rings and Pendants"
	"quest.6C8D8FD0F6FECA35.quest_desc": ["Slay an Inquisitor and gather 4 Platinum Chunks.", "", "&7&oA heavy-hitting brute in platinum plate."]
	"quest.6C8D8FD0F6FECA35.title": "The Inquisitor"
	"quest.6CF732DB46D232C2.quest_desc": ["Craft 12 Glass and gather a Water Bucket for a safe tank.", "", "&7&oA bucket is a poor home for a dragon."]
	"quest.6CF732DB46D232C2.title": "A Safe Tank"
	"quest.6D2439029D68CDFC.quest_desc": ["Craft Hamster Bedding, then an Oak Hamster Bed.", "", "&7&oBedding mixes oak and birch leaves, a dead bush and podzol."]
	"quest.6D2439029D68CDFC.title": "A Cosy Corner"
	"quest.6D3E220E8B33766E.quest_desc": ["Visit a snowy beach or stony shore and collect 2 Penguin Feathers.", "", "&7&oPenguins waddle where the sea meets the cold."]
	"quest.6D3E220E8B33766E.title": "Waddle Watch"
	"quest.6DD29EDEF0E3D3F8.quest_desc": ["Craft 2 Growth Accelerators and find or make a Flawed Budding Certus Quartz.", "", "&7&oAccelerators beside budding quartz make its crystals grow far faster."]
	"quest.6DD29EDEF0E3D3F8.title": "Growth Accelerators"
	"quest.6DF5F0512528CD68.quest_desc": ["Finish every other quest in this chapter.", "", "&7&oA full spell book and the nerve to use it."]
	"quest.6DF5F0512528CD68.quest_subtitle": "Chapter reward: Golden Bloom Die"
	"quest.6DF5F0512528CD68.title": "Spellbooks Mastered"
	"quest.6E147A55BC2D0B67.quest_desc": ["Craft a Cooking Pot and set it over a campfire or a stove.", "", "&7&oMost good meals start here, with a bowl in hand."]
	"quest.6E147A55BC2D0B67.title": "The Cooking Pot"
	"quest.6E8499DEA6873742.quest_desc": ["Craft 2 Oak Tiki Torches and 2 White Paper Lamps.", "", "&7&oTorches for the garden, paper lamps for indoors."]
	"quest.6E8499DEA6873742.title": "Lit Streets"
	"quest.6EBE1BED70107C1D.quest_desc": ["Craft a Framing Saw and a Framed Blueprint.", "", "&7&oThe saw cuts cubes into shapes; the blueprint copies a frame."]
	"quest.6EBE1BED70107C1D.title": "Cut to Fit"
	"quest.6ED64CF4DC9332B4.quest_desc": ["Finish every other quest in this chapter.", "", "&7&oA dragon in a bucket, and the cutest apex predator in the world."]
	"quest.6ED64CF4DC9332B4.quest_subtitle": "Chapter reward: Golden Bloom Die"
	"quest.6ED64CF4DC9332B4.title": "Dracolotl Mastered"
	"quest.6F19304DB8D41D9D.quest_desc": ["Breed a pair of axolotls with Buckets of Tropical Fish.", "", "&7&oBabies can take either parent's colour; a few colours, like the Glowxolotl, are rare."]
	"quest.6F19304DB8D41D9D.title": "New Colours"
	"quest.6F199F7E085D08A6.quest_desc": ["Craft 2 Oak Tables.", "", "&7&oChairs need something to sit at."]
	"quest.6F199F7E085D08A6.title": "A Table to Eat At"
	"quest.6F60431B82189E39.quest_desc": ["Find the silver dungeon and kill the Valkyrie Queen.", "", "&7&oShe duels fairly, flies well and does not give ground."]
	"quest.6F60431B82189E39.quest_subtitle": "Hard quest: Moonpetal Die"
	"quest.6F60431B82189E39.title": "Queen of the Valkyries"
	"quest.6F67EAFA8A480C80.quest_desc": ["Craft a Netherite Space Helmet, Suit, Pants and Boots.", "", "&7&oA suit upgraded with netherite for the harshest worlds."]
	"quest.6F67EAFA8A480C80.title": "Netherite Space Suit"
	"quest.6F7264E21FAD7D99.quest_desc": ["Craft 4 Flower Pots.", "", "&7&oHang them from above and the flowers still grow."]
	"quest.6F7264E21FAD7D99.title": "Pots Aloft"
	"quest.6F77C1040DE440FA.quest_desc": ["Craft a Basic Inventory Hopper and an Item Filter.", "", "&7&oPull one kind of item from the network and nothing else."]
	"quest.6F77C1040DE440FA.title": "Sort Your Items"
	"quest.6F8E6F18B881AE1B.quest_desc": ["Find a village and trade for an Emerald.", "", "&7&oVillagers pay in emeralds for crops, paper and coal."]
	"quest.6F8E6F18B881AE1B.title": "Strangers with Emeralds"
	"quest.6FA53946D146D8DB.quest_desc": ["Craft a Casting Net and catch a creature with it.", "", "&7&oShells and string make a net for the shallows."]
	"quest.6FA53946D146D8DB.title": "Small Creatures"
	"quest.6FBA6C6E202C0201.quest_desc": ["Infuse a Mana Diamond by dropping a diamond into a full pool.", "", "&7&oIt costs 10,000 mana, so build a good stock before you try."]
	"quest.6FBA6C6E202C0201.title": "Mana Diamond"
	"quest.6FE24ABDED980C26.quest_desc": ["Cross the labyrinth and kill the Minoshroom.", "", "&7&oMaze stone, slimes and a mushroom bull at the heart of it."]
	"quest.6FE24ABDED980C26.title": "The Labyrinth"
	"quest.6FEE3ED6E3DEF3FD.quest_desc": ["Harvest 4 Cabbages, 4 Tomatoes and 4 Onions.", "", "&7&oTomato vines climb ropes. Onions plant straight from the bulb."]
	"quest.6FEE3ED6E3DEF3FD.title": "From the Garden"
	"quest.703BA5FB06CFC8E3.quest_desc": ["Visit a lush cave and smelt Glow Berries into Glow Goop.", "", "&7&oA cave berry, cooked down to something sticky."]
	"quest.703BA5FB06CFC8E3.title": "A Soft Glow"
	"quest.705613F4AD598CD8.quest_desc": ["Craft an Iron Sword, a Shield and an Iron Chestplate for your guard.", "", "&7&oGuards use any weapon and armour you hand them."]
	"quest.705613F4AD598CD8.title": "Kit Out the Guard"
	"quest.70726436FF9A33EF.quest_desc": ["Craft a Compass and a Map.", "", "&7&oThe minimap helps, but a paper map never loses its place."]
	"quest.70726436FF9A33EF.title": "Know Where You Are"
	"quest.70F777B5EC9C5099.quest_desc": ["Gather 4 Bullet Peppers and cut 2 Pepper Powder on a cutting board.", "", "&7&oThe Nether's own spice. A little goes a long way."]
	"quest.70F777B5EC9C5099.title": "Bullet Pepper"
	"quest.71128C378BAF2D83.quest_desc": ["Finish every other quest in this chapter.", "", "&7&oEvery block, finished to your taste."]
	"quest.71128C378BAF2D83.quest_subtitle": "Chapter reward: Bloom Die"
	"quest.71128C378BAF2D83.title": "Rechiseled Mastered"
	"quest.7129BEA0503BFE1B.quest_desc": ["Bake 4 Bread on the stove.", "", "&7&oDough, sugar and water: four loaves a batch."]
	"quest.7129BEA0503BFE1B.title": "Fresh Bread"
	"quest.71346FB9E45946B8.quest_desc": ["Eat a hot meal that grants Nourishment.", "", "&7&oNourishment holds off hunger for a while. Most pot meals grant it."]
	"quest.71346FB9E45946B8.title": "Nourishing Meals"
	"quest.714C0E7C6188ACF7.quest_desc": ["Craft 2 Oak Barn Doors, 3 Oak Modern Doors and 2 Oak Barn Trapdoors.", "", "&7&oEvery style of door a house could want, and hatches to match."]
	"quest.714C0E7C6188ACF7.title": "Doors with Character"
	"quest.71980D34DB80F0C8.quest_desc": ["Craft 4 Brass Supports and 4 Brass Catwalk Stairs.", "", "&7&oBrass looks better on the upper floors."]
	"quest.71980D34DB80F0C8.title": "Brass Fittings"
	"quest.71A38F6B9D4C6099.quest_desc": ["Collect 8 Fossilized Bone Blocks and craft a Fossilized Bone Rod.", "", "&7&oStacked bone becomes rods, rows and spikes for a fine ribcage."]
	"quest.71A38F6B9D4C6099.title": "Ribs and Spikes"
	"quest.71AE2A8980DAB2E6.quest_desc": ["Craft a Ritual Brazier and the Sunrise ritual tablet.", "", "&7&oLight the brazier with the tablet inside and night gives way to morning."]
	"quest.71AE2A8980DAB2E6.title": "The Ritual Brazier"
	"quest.71F72AF99A05040C.quest_desc": ["Craft 32 Train Tracks, a Train Station and Train Controls.", "", "&7&oGlue a carriage, add a seat, and the world gets smaller."]
	"quest.71F72AF99A05040C.quest_subtitle": "Hard quest: Golden Bloom Die"
	"quest.71F72AF99A05040C.title": "All Aboard"
	"quest.72102CDE469B283C.quest_desc": ["Finish every other quest in this chapter.", "", "&7&oEvery new face met and sent packing."]
	"quest.72102CDE469B283C.quest_subtitle": "Chapter reward: Golden Bloom Die"
	"quest.72102CDE469B283C.title": "Variants Mastered"
	"quest.721CF92A5604021D.quest_desc": ["Finish every other quest in this chapter.", "", "&7&oThe whole system is within reach of your rocket."]
	"quest.721CF92A5604021D.quest_subtitle": "Chapter reward: Starbloom Die"
	"quest.721CF92A5604021D.title": "Ad Astra Mastered"
	"quest.72902AE8A483069C.quest_desc": ["Find a Pyromancer Tower and defeat its Pyromancer.", "", "&7&oA hot-tempered mage lives at the top, and he keeps good company with fire."]
	"quest.72902AE8A483069C.title": "The Pyromancer's Tower"
	"quest.72A79A6B5C10288E.quest_desc": ["Reach the End and gather 8 Chorus Fruit.", "", "&7&oChorus fruit is the End's one crop. Cut it, cook it, drink it."]
	"quest.72A79A6B5C10288E.title": "Dinner at the End"
	"quest.72B4987AD1C7F658.quest_desc": ["Gather 4 Amethyst Shards.", "", "&7&oGeodes sit deep in the stone; a Moonpetal Dice needs four of their shards."]
	"quest.72B4987AD1C7F658.title": "Crystal Hunting"
	"quest.72F20BA66A183040.quest_desc": ["Gather 4 Corruption and craft 2 Dark Iron Ingots.", "", "&7&oThe dead leave a dark residue. Melded with iron, it makes something new."]
	"quest.72F20BA66A183040.title": "Dark Iron"
	"quest.7305C379F1C86F4D.quest_desc": ["Cook 16 Steaks and craft 2 Golden Apples.", "", "&7&oA full stomach heals you between fights and a golden apple heals you during one."]
	"quest.7305C379F1C86F4D.title": "Eat to Fight"
	"quest.735667548C0D8267.quest_desc": ["Craft an Imbuing Table.", "", "&7&oPrimal essence, copper blocks, dark oak and a bottle of experience."]
	"quest.735667548C0D8267.title": "Imbuing Table"
	"quest.73625C6D0B6083C3.quest_desc": ["Visit the Pollinated Fields and the Floral Meadow.", "", "&7&oFlowers as far as the hive can see."]
	"quest.73625C6D0B6083C3.title": "Fields of Pollen"
	"quest.7392E4EBA6F80FE3.quest_desc": ["Bottle 4 Dragon's Breath.", "", "&7&oHold out a glass bottle as the purple cloud passes."]
	"quest.7392E4EBA6F80FE3.title": "Dragon's Breath"
	"quest.73A9EF4241301FAB.quest_desc": ["Find a large aercloud, then gather 4 Blue Aerclouds.", "", "&7&oBlue aerclouds bounce you high, and break your fall."]
	"quest.73A9EF4241301FAB.title": "Bounce Pads"
	"quest.74323B0251004AC5.quest_desc": ["Craft an Oceanographer Table from 8 Glass.", "", "&7&oA glass case for a villager who loves the sea."]
	"quest.74323B0251004AC5.title": "By the Sea"
	"quest.743A3E7924EBC603.quest_desc": ["Find the Catacombs and slay 4 Forgotten.", "", "&7&oBones and old guardians, deep in the dark."]
	"quest.743A3E7924EBC603.title": "The Catacombs"
	"quest.74510C35F4F8E301.quest_desc": ["Slay a Lightning Dragon and bring home 4 Lightning Dragon Flesh.", "", "&7&oFastest of the three. Do not fight it on open ground."]
	"quest.74510C35F4F8E301.title": "The Storm Wyrm"
	"quest.748AB989D3FF5F30.quest_desc": ["Cook Cooking Oil in the pot, then make Fried Fish and Fried Chicken.", "", "&7&oOil and batter give fish and chicken a golden crust."]
	"quest.748AB989D3FF5F30.title": "Deep Fry"
	"quest.74947D575CD884F7.quest_desc": ["Craft an Energy Cell, a Dense Energy Cell and a Vibration Chamber.", "", "&7&oVibration chambers burn fuel for power; cells keep the buffer topped up."]
	"quest.74947D575CD884F7.title": "Power Storage"
	"quest.7495639FC112D8D8.quest_desc": ["Craft an iron helmet, chestplate, leggings and boots.", "", "&7&oArmour turns a dangerous night into a slow one."]
	"quest.7495639FC112D8D8.title": "Suit Up"
	"quest.74B6316B2141009C.quest_desc": ["Kill 3 squid and take 3 Tentacles.", "", "&7&oSquid drop tentacles as well as ink."]
	"quest.74B6316B2141009C.title": "From the Sea"
	"quest.74E28712F691796F.quest_desc": ["Ferment a Wine and a Rum in the vat.", "", "&7&oBerries and sugar cane ferment into stronger things."]
	"quest.74E28712F691796F.title": "Cheers"
	"quest.74E2F693EBB55284.quest_desc": ["Craft a Dictionary of Spirits from a book and Demon's Dream seeds.", "", "&7&oEverything in Occultism is explained in here. Read it twice."]
	"quest.74E2F693EBB55284.title": "Dictionary of Spirits"
	"quest.753F3872D4B56B71.quest_desc": ["Gather 128 Stone Bricks.", "", "&7&oFloor mode fills a whole plane between two clicks."]
	"quest.753F3872D4B56B71.title": "Lay a Floor"
	"quest.75452AC2A2D5F0D7.quest_desc": ["Take a Life Shard from the gold dungeon's treasure.", "", "&7&oUse it and your maximum health rises for good."]
	"quest.75452AC2A2D5F0D7.title": "A Shard of Life"
	"quest.7548C5EE9EE6121C.quest_desc": ["Find the brass dungeon and kill the Eye of the Storm.", "", "&7&oA chain of storm that hunts you through its own halls."]
	"quest.7548C5EE9EE6121C.title": "Eye of the Storm"
	"quest.754A7F7B0095D827.quest_desc": ["Craft a Charged Ender Pearl.", "", "&7&oA void thorn and a scrap of anima turn an ordinary pearl into something worse."]
	"quest.754A7F7B0095D827.title": "Charged Ender Pearl"
	"quest.754B0F7A92BB5C96.quest_desc": ["Mine 6 Zanite Gemstones.", "", "&7&oBlue gems in the holystone, common at almost any height."]
	"quest.754B0F7A92BB5C96.title": "Zanite"
	"quest.754DDBEFBD5B8869.quest_desc": ["Finish every other quest in this chapter.", "", "&7&oA whole menagerie learned, tamed or hunted."]
	"quest.754DDBEFBD5B8869.quest_subtitle": "Chapter reward: Golden Bloom Die"
	"quest.754DDBEFBD5B8869.title": "Alex's Mobs Mastered"
	"quest.75512AC4CAF84736.quest_desc": ["Craft 2 Copper Buttons and summon a Copper Golem.", "", "&7&oIt wanders about pressing copper buttons."]
	"quest.75512AC4CAF84736.title": "Button Pusher"
	"quest.76733758F5B72FDA.quest_desc": ["Finish every other quest in this chapter.", "", "&7&oThe queen's favourite visitor."]
	"quest.76733758F5B72FDA.quest_subtitle": "Chapter reward: Golden Bloom Die"
	"quest.76733758F5B72FDA.title": "Hive Mastered"
	"quest.76F2A199C73A785C.quest_desc": ["Craft a Volcanic Sourcelink.", "", "&7&oSourcelinks make Source for the jars beside them, so you stop carrying gems."]
	"quest.76F2A199C73A785C.title": "A Steady Supply"
	"quest.76F4E49F1EDD97A9.quest_desc": ["Craft a Herbal Infusion, a Copper Tea Kettle and a Jug.", "", "&7&oBlack, green and oolong, dried and combined."]
	"quest.76F4E49F1EDD97A9.title": "The Tea Blend"
	"quest.7717FCD5D4F5D893.quest_desc": ["Craft a Stack Upgrade Tier 1.", "", "&7&oEvery slot holds bigger stacks, so the same box holds more."]
	"quest.7717FCD5D4F5D893.title": "Bigger Stacks"
	"quest.773B08E8E8DEA4BA.quest_desc": ["Cut Tentacles on a board and cook Squid Rings.", "", "&7&oRings need dough as well as tentacles. Cook them in the pot."]
	"quest.773B08E8E8DEA4BA.title": "Squid Rings"
	"quest.77853548EE7F598A.quest_desc": ["Craft Brimstone Nectar.", "", "&7&oNetherite scrap, dragon's breath and a ghast tear. Expensive on purpose."]
	"quest.77853548EE7F598A.title": "Brimstone Nectar"
	"quest.77947077FDC9B93D.quest_desc": ["Finish every other quest in this chapter.", "", "&7&oFrom tide pool to tropical shore, nothing small escaped notice."]
	"quest.77947077FDC9B93D.quest_subtitle": "Chapter reward: Golden Bloom Die"
	"quest.77947077FDC9B93D.title": "Spawn Mastered"
	"quest.77BE2930E73AAD21.quest_desc": ["Summon a Foliot lumberjack by ritual.", "", "&7&oBound spirits take on chores: felling trees, farming, cleaning and hauling."]
	"quest.77BE2930E73AAD21.title": "A Foliot at Work"
	"quest.77E075D2FA96F382.quest_desc": ["Finish every other quest in this chapter.", "", "&7&oThe village sleeps soundly under your watch."]
	"quest.77E075D2FA96F382.quest_subtitle": "Chapter reward: Bloom Die"
	"quest.77E075D2FA96F382.title": "Guard Villagers Mastered"
	"quest.77FA31440E9D62EC.quest_desc": ["Craft a Rotational Complex, a Saturating Condenser and 2 Electromagnetic Coils.", "", "&7&oSpin the rotor with steam and the coils turn it into a lot of power."]
	"quest.77FA31440E9D62EC.title": "Steam Power"
	"quest.77FC7474B551565E.quest_desc": ["Make 4 Logic, 4 Calculation and 4 Engineering Processors.", "", "&7&oPrint the parts, then press them with silicon and redstone."]
	"quest.77FC7474B551565E.title": "Processors"
	"quest.7849CEFF356513D0.quest_desc": ["Craft an Item Router.", "", "&7&oFilter each side and sort a mixed stream of items."]
	"quest.7849CEFF356513D0.title": "Item Router"
	"quest.7894EAAB491C04DC.quest_desc": ["Mine 8 Ambrosium Shards and craft 4 Ambrosium Torches.", "", "&7&oA golden glow that lights the island nights."]
	"quest.7894EAAB491C04DC.title": "Ambrosium"
	"quest.78A7A937B2E67DFF.quest_desc": ["Craft 3 Framed Doors and a Framed Secret Storage.", "", "&7&oThe chest blends into the wall around it."]
	"quest.78A7A937B2E67DFF.title": "Doors and Hidden Chests"
	"quest.792D018F4087F015.quest_desc": ["Craft an Iron Longsword.", "", "&7&oSame iron, longer reach. The first of many new shapes."]
	"quest.792D018F4087F015.title": "New Shapes of Steel"
	"quest.793ACB2A8A2EBF6F.quest_desc": ["Turn a Crimson Mosquito into a Warped Mosco, then slay it.", "", "&7&oA mosquito that drinks from a warped-fungus Mungus grows into a hulking brute."]
	"quest.793ACB2A8A2EBF6F.quest_subtitle": "Hard quest: Moonpetal Die"
	"quest.793ACB2A8A2EBF6F.title": "The Warped Mosco"
	"quest.79453D0D73F30EEE.quest_desc": ["Craft a Crafting Bowl, a Stove and a Rolling Pin.", "", "&7&oBakery borrows Farm \\& Charm's bowl and stove, then adds tools of its own."]
	"quest.79453D0D73F30EEE.title": "The Baker's Kit"
	"quest.7979BF98009ACB00.quest_desc": ["Visit the Nether and craft a Netherite Longsword.", "", "&7&oUpgrade a Diamond Longsword with a netherite ingot and a template."]
	"quest.7979BF98009ACB00.title": "Netherite Edge"
	"quest.79C905EFE046E62D.quest_desc": ["Find a Haunted House and slay a Wraith.", "", "&7&oCold spots, creaking floors and something that watches from the dark."]
	"quest.79C905EFE046E62D.title": "The Haunted House"
	"quest.79DC4E28A8AA670D.quest_desc": ["Find a Cyclops cave and slay the Cyclops.", "", "&7&oIt keeps a flock of sheep, and it is not above eating you instead."]
	"quest.79DC4E28A8AA670D.title": "One Big Eye"
	"quest.7A18A90B10D8C5CC.quest_desc": ["Craft a Blast Amplifier.", "", "&7&oObsidian packed around an eye and a heart."]
	"quest.7A18A90B10D8C5CC.title": "Blast Amplifier"
	"quest.7A36AB9B844C0262.quest_desc": ["Craft a Pattern Provider, a Pattern Encoding Terminal and 8 Blank Patterns.", "", "&7&oEncode a recipe once and the network crafts it whenever asked."]
	"quest.7A36AB9B844C0262.title": "Patterns"
	"quest.7A49D00926EB200A.quest_desc": ["Gather 64 Glass.", "", "&7&oCube mode builds solid or hollow volumes in one go."]
	"quest.7A49D00926EB200A.title": "Fill a Cube"
	"quest.7AD6A9623A6EE580.quest_desc": ["Finish every other quest in this chapter.", "", "&7&oHouse lights down, screen on, popcorn optional."]
	"quest.7AD6A9623A6EE580.quest_subtitle": "Chapter reward: Golden Bloom Die"
	"quest.7AD6A9623A6EE580.title": "Dream Displays Mastered"
	"quest.7B3CD05B8758CC91.quest_desc": ["Weapons, armour and the bosses worth fighting."]
	"quest.7B3CD05B8758CC91.title": "Fight"
	"quest.7B65FEE053F6AF57.quest_desc": ["Gather 8 steel ingots and craft 2 Steel Casings.", "", "&7&oEvery machine from here on is built around this frame."]
	"quest.7B65FEE053F6AF57.title": "Steel and Osmium"
	"quest.7B6F0EFF35A2DC4B.quest_desc": ["Craft a Buoy and a Bell Buoy.", "", "&7&oMark the safe water, and the shallows to avoid."]
	"quest.7B6F0EFF35A2DC4B.title": "Mark Your Waters"
	"quest.7B7FFC5E9F448BAC.quest_desc": ["Chisel 4 Large Oak Windows and 4 Spruce Window Panes.", "", "&7&oCreate's framed windows in wood-specific styles."]
	"quest.7B7FFC5E9F448BAC.title": "Window Shapes"
	"quest.7B80576F38D64727.quest_desc": ["Craft a Stinger Spear.", "", "&7&oA bee stinger on a stick, with a poisonous bite."]
	"quest.7B80576F38D64727.title": "Sting Operation"
	"quest.7BB62F48870A0CAC.quest_desc": ["Craft an Altar and make 4 Enchanted Gravitite.", "", "&7&oA metal that forgets which way is down."]
	"quest.7BB62F48870A0CAC.title": "Gravitite"
	"quest.7BBAED47FB4893F9.quest_desc": ["Visit a beach or mangrove swamp and take home 2 Crab Claws.", "", "&7&oCrabs wave a claw worth keeping."]
	"quest.7BBAED47FB4893F9.title": "Claws on the Shore"
	"quest.7BC32DAEE32B3618.quest_desc": ["Craft a Divination Rod.", "", "&7&oAttune it to a block and it points you towards the nearest one."]
	"quest.7BC32DAEE32B3618.title": "Divination Rod"
	"quest.7BD73370FA99EC47.quest_desc": ["Craft a Wrench and use it on a block.", "", "&7&oRotate blocks without breaking and replacing them."]
	"quest.7BD73370FA99EC47.title": "Quarter Turn"
	"quest.7C4E4109E494CE43.quest_desc": ["Put a butterfly in a glass bottle.", "", "&7&oBottled, it keeps until you want to study it."]
	"quest.7C4E4109E494CE43.title": "Butterfly in a Bottle"
	"quest.7C52F70916A85CC5.quest_desc": ["Brew a Coffee and a Milk Coffee.", "", "&7&oBeans from the wild plant, and milk for the second cup."]
	"quest.7C52F70916A85CC5.title": "Coffee Break"
	"quest.7C661C47933029D1.quest_desc": ["Make a Chicken Taco or a Beef Burrito.", "", "&7&oTortilla, meat, sauce and beans, wrapped up warm."]
	"quest.7C661C47933029D1.title": "Taco Night"
	"quest.7C858527218EFA3B.quest_desc": ["Team up with an axolotl and win a fight.", "", "&7&oAxolotls will gladly lend a paw in a scrap."]
	"quest.7C858527218EFA3B.title": "Friendship"
	"quest.7C85F59B1F4DAABD.quest_desc": ["Slay the Maze Mother in the Ice Maze.", "", "&7&oShe keeps the maze alive. Fight in the cold and stay out of the water."]
	"quest.7C85F59B1F4DAABD.quest_subtitle": "Hard quest: Starbloom Die"
	"quest.7C85F59B1F4DAABD.title": "The Maze Mother"
	"quest.7CABE54E73144015.quest_desc": ["Visit a tropical island and harvest 4 Dates.", "", "&7&oDate palms grow where the sand meets the sea."]
	"quest.7CABE54E73144015.title": "Palm Shade"
	"quest.7CD6733FA6272163.quest_desc": ["Craft 8 carpets of any colour.", "", "&7&oCarpets now lie neatly on stairs and slabs as well."]
	"quest.7CD6733FA6272163.title": "Carpeted Stairs"
	"quest.7D07EBA5A0EC8D65.quest_desc": ["Step into the End.", "", "&7&oFill the frame, jump in and mind the void."]
	"quest.7D07EBA5A0EC8D65.title": "Beyond the Portal"
	"quest.7D64B7AD2594A9A5.quest_desc": ["Craft 12 Eyes of Ender and find a stronghold.", "", "&7&oFollow them down to the portal room."]
	"quest.7D64B7AD2594A9A5.title": "Eyes Open"
	"quest.7DC53B06394A86CB.quest_desc": ["Craft Dragon Leg with Sauce from a smoked dragon leg.", "", "&7&oThe End's finest dish, served on a plate the size of a table."]
	"quest.7DC53B06394A86CB.title": "Dragon Leg Feast"
	"quest.7E38A69B4B363484.quest_desc": ["Craft a Steel Paxel from your steel pickaxe, axe and shovel.", "", "&7&oPickaxe, axe and shovel in a single tool."]
	"quest.7E38A69B4B363484.title": "Paxels"
	"quest.7E78219A99994FAE.quest_desc": ["Craft an Oxygen Distributor and a Gravity Normalizer.", "", "&7&oSeal a room, add a distributor and you can take your helmet off."]
	"quest.7E78219A99994FAE.title": "A Home on the Moon"
	"quest.7E7FEF29CA685900.quest_desc": ["Craft a Butterfly Net, then catch a butterfly in a flower forest.", "", "&7&oSunny, flowery places draw the most butterflies."]
	"quest.7E7FEF29CA685900.title": "Catch a Butterfly"
	"quest.7E810F339ECE7063.quest_desc": ["Craft 3 White Sofas and a Service Bell.", "", "&7&oWool and planks make the softest seat in the pack. Ring the bell for tea."]
	"quest.7E810F339ECE7063.title": "Sink In"
	"quest.7E99878F537A840A.quest_desc": ["Finish every other quest in this chapter.", "", "&7&oEvery item has a home, and a label."]
	"quest.7E99878F537A840A.quest_subtitle": "Chapter reward: Bloom Die"
	"quest.7E99878F537A840A.title": "Sophisticated Storage Mastered"
	"quest.7EA02452D7171F78.quest_desc": ["Craft the Projectile, Touch and Harm glyphs.", "", "&7&oForm, then effect: a bolt that hurts is the simplest spell there is."]
	"quest.7EA02452D7171F78.title": "First Glyphs"
	"quest.7EBE8CBC629A3B15.quest_desc": ["Craft a Bronze, an Osmium and a Lapis Lazuli Pickaxe.", "", "&7&oCheaper metals, each with its own strengths."]
	"quest.7EBE8CBC629A3B15.title": "Lesser Metals"
	"quest.7F0900F48D20FB22.quest_desc": ["Brush out a rare Gargantuan Fossil and turn it into Leedsichthys Roe.", "", "&7&oOnly the rarest fossil beds hold one. It hatches the largest bony fish that ever swam."]
	"quest.7F0900F48D20FB22.quest_subtitle": "Hard quest: Starbloom Die"
	"quest.7F0900F48D20FB22.title": "The Giant of the Sea"
	"quest.7F1A4A675EC5F56B.quest_desc": ["Finish every other quest in this chapter.", "", "&7&oA thicker health bar, one new dish at a time."]
	"quest.7F1A4A675EC5F56B.quest_subtitle": "Chapter reward: Bloom Die"
	"quest.7F1A4A675EC5F56B.title": "Spice of Life Mastered"
	"quest.7F411FA1A483DEF3.quest_desc": ["Finish every other quest in this chapter.", "", "&7&oEvery item stored, every recipe automated."]
	"quest.7F411FA1A483DEF3.quest_subtitle": "Chapter reward: Moonpetal Die"
	"quest.7F411FA1A483DEF3.title": "Applied Energistics Mastered"
	"quest.7F50464A8C56F6C5.quest_desc": ["Craft 2 Copper Train Hulls.", "", "&7&oRounded plates for trains, tanks and anything else that rolls."]
	"quest.7F50464A8C56F6C5.title": "Copper Hulls"
	"quest.7F50508ECF714AFE.quest_desc": ["Mix Cake Dough, bake a Sponge Sheet and place a Caking Station.", "", "&7&oEvery cake starts as a sponge and is finished on the Caking Station."]
	"quest.7F50508ECF714AFE.title": "Sponge and Cake"
	"quest.7F727D98AB53257C.quest_desc": ["Craft 4 Biosteel Blocks, then Biosteel Tiles.", "", "&7&oCopper wrapped around a gold heart: the walls the old labs were built from."]
	"quest.7F727D98AB53257C.title": "Biosteel"
	"quest.7F751E27B1D9773E.quest_desc": ["Finish every other quest in this chapter.", "", "&7&oWherever you wander, home is one step away."]
	"quest.7F751E27B1D9773E.quest_subtitle": "Chapter reward: Bloom Die"
	"quest.7F751E27B1D9773E.title": "Waystones Mastered"
	"quest.7F9C73EE0AFBF970.quest_desc": ["Find a dragon cave.", "", "&7&oFire, ice or lightning, there is always a hoard and always a guardian."]
